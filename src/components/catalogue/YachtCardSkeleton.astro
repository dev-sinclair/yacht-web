---
// Visual placeholder that matches YachtCardCatalogue's layout exactly so the
// page doesn't shift when real data arrives.
---

<div class="yacht-card-skeleton flex flex-col border border-beige/60 bg-white">
  <!-- Name placeholder -->
  <div class="px-5 pt-5">
    <div class="h-6 w-2/3 bg-cream animate-pulse"></div>
  </div>

  <!-- Builder + price row -->
  <div class="flex items-baseline justify-between gap-3 px-5 pt-3 pb-4">
    <div class="h-3 w-24 bg-cream animate-pulse"></div>
    <div class="h-4 w-20 bg-cream animate-pulse"></div>
  </div>

  <!-- Specs row (4 columns) -->
  <div class="grid grid-cols-4 gap-x-4 border-t border-beige/60 px-5 py-3">
    <div class="space-y-1.5">
      <div class="h-2 w-10 bg-cream animate-pulse"></div>
      <div class="h-3 w-12 bg-cream animate-pulse"></div>
    </div>
    <div class="space-y-1.5">
      <div class="h-2 w-10 bg-cream animate-pulse"></div>
      <div class="h-3 w-8 bg-cream animate-pulse"></div>
    </div>
    <div class="space-y-1.5">
      <div class="h-2 w-10 bg-cream animate-pulse"></div>
      <div class="h-3 w-10 bg-cream animate-pulse"></div>
    </div>
    <div class="space-y-1.5">
      <div class="h-2 w-10 bg-cream animate-pulse"></div>
      <div class="h-3 w-6 bg-cream animate-pulse"></div>
    </div>
  </div>

  <!-- Image placeholder -->
  <div class="flex-1 min-h-[220px] bg-cream animate-pulse"></div>
</div>
