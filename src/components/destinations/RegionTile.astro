---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Region } from "../../data/types/destination";
import LocationsDropdown from "./LocationsDropdown.astro";

interface Props {
  region: Region;
  index: number;
}

const { region, index } = Astro.props;
const locationsLower = region.locations.map((l) => l.name.toLowerCase()).join("|");

// Local region hero images live in src/assets/regions/<short>.png. Glob-import
// and look up by region slug → file basename. Falls back to the remote
// heroImage if a region isn't mapped.
const regionImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/regions/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);
const imageByBasename: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(regionImages)) {
  const name = path.split("/").pop()!.replace(/\.[^.]+$/, "");
  imageByBasename[name] = mod.default;
}
const slugToFile: Record<string, string> = {
  "west-mediterranean": "west-m",
  "east-mediterranean": "east-m",
  "caribbean": "carib",
  "bahamas": "baham",
  "indian-ocean-and-south-east-asia": "indo",
  "australasia-and-south-pacific": "austral",
  "arabian-gulf": "arab",
  "north-america": "north-am",
  "antarctica": "antarct",
};
const localHero = imageByBasename[slugToFile[region.slug] ?? ""];
---

<li
  data-region-card
  data-region-slug={region.slug}
  data-region-name={region.name.toLowerCase()}
  data-locations={locationsLower}
  data-open="false"
  class="region-card group flex flex-col transition-[opacity,transform] duration-300 ease-out"
>
  <button
    type="button"
    data-region-toggle
    aria-expanded="false"
    aria-controls={`panel-${region.slug}`}
    class="region-toggle relative block w-full overflow-hidden border border-charcoal/10 bg-charcoal text-left cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2"
    style="aspect-ratio: 4 / 3;"
  >
    {localHero ? (
      <Image
        src={localHero}
        alt={region.name}
        widths={[600, 900, 1200, 1600]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        loading={index < 3 ? "eager" : "lazy"}
        class="region-image absolute inset-0 h-full w-full object-cover"
      />
    ) : (
      <img
        src={region.heroImage}
        alt={region.name}
        loading={index < 3 ? "eager" : "lazy"}
        width="1600"
        height="1000"
        class="region-image absolute inset-0 h-full w-full object-cover"
      />
    )}

    <div
      class="region-overlay absolute inset-0 bg-gradient-to-t from-charcoal/85 via-charcoal/60 to-charcoal/45 transition-opacity duration-500 group-hover:opacity-80"
    >
    </div>

    <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center">
      <h3
        class="region-name relative text-2xl font-light tracking-[0.18em] uppercase text-white sm:text-3xl"
        style="font-family: 'Raleway', sans-serif; font-weight: 300;"
      >
        {region.name}
      </h3>
      <p
        class="mt-3 max-w-xs text-[12px] font-light leading-relaxed text-white/75"
        style="font-family: 'Raleway', sans-serif;"
      >
        {region.tagline}
      </p>

      <span
        class="region-cta mt-6 inline-flex items-center gap-2 text-[10px] font-medium tracking-[0.3em] uppercase text-white/85"
        style="font-family: 'Raleway', sans-serif;"
      >
        <span data-region-cta-text>Explore</span>
        <svg
          class="region-chevron h-3 w-3 transition-transform duration-500 ease-out"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </span>
    </div>
  </button>

  <LocationsDropdown region={region} />
</li>

<style is:global>
  [data-region-card][data-dimmed="true"] {
    opacity: 0.3;
    transform: scale(0.97);
    pointer-events: none;
  }
  [data-region-card][data-hidden="true"] {
    display: none;
  }

  [data-region-card] .region-name::after {
    content: "";
    display: block;
    height: 1px;
    width: 0;
    background: var(--color-gold);
    margin: 0.85rem auto 0;
    transition: width 0.5s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  [data-region-card]:hover .region-name::after,
  [data-region-card][data-open="true"] .region-name::after {
    width: 3rem;
  }

  [data-region-card][data-open="true"] .region-chevron {
    transform: rotate(180deg);
  }

  [data-region-panel] {
    transition: grid-template-rows 500ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  [data-region-card][data-open="true"] [data-region-panel] {
    grid-template-rows: 1fr !important;
  }
  [data-region-card][data-open="true"] [data-region-panel-inner] {
    opacity: 1 !important;
    transition-delay: 120ms;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-region-card],
    [data-region-card] .region-image,
    [data-region-card] .region-overlay,
    [data-region-card] .region-chevron,
    [data-region-card] .region-name::after,
    [data-region-panel],
    [data-region-panel-inner] {
      transition: none !important;
    }
    [data-region-card]:hover .region-image,
    [data-region-card]:hover .region-overlay {
      transform: none !important;
      filter: none !important;
    }
  }
</style>
