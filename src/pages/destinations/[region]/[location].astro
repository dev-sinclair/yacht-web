---
import "../../../styles/global.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/layout/Navbar.astro";
import Footer from "../../../components/layout/Footer.astro";
import YachtCardCatalogue from "../../../components/catalogue/YachtCardCatalogue.astro";
import { getAllLocationPaths } from "../../../lib/destinations/registry";
import { getYachtsForLocation } from "../../../lib/destinations/location-yachts";
import type { Region, Location } from "../../../data/types/destination";

export const prerender = true;

export async function getStaticPaths() {
  return getAllLocationPaths();
}

interface Props {
  region: Region;
  location: Location;
}

const { region, location } = Astro.props;

const { yachts, totalMatches } = await getYachtsForLocation(location, 6);

const waMessage = `Hi, I'm interested in chartering in ${location.name} (${region.name}). Could you help build an itinerary?`;
const waUrl = `https://wa.me/34971000000?text=${encodeURIComponent(waMessage)}`;
---

<BaseLayout
  title={`${location.name} — ${region.name} | Sinclair Yachting`}
  description={`Charter yachts cruising ${location.name}, part of our ${region.name} programme. ${region.tagline}.`}
>
  <Navbar />
  <main>
    <!-- Editorial header -->
    <header class="bg-warm-white pt-32 pb-14 sm:pt-36 sm:pb-16 lg:pt-40 lg:pb-20">
      <div class="mx-auto max-w-[1280px] px-6 sm:px-8 lg:px-12">
        <nav
          class="text-[10px] font-medium tracking-[0.3em] uppercase text-taupe-light"
          style="font-family: 'Raleway', sans-serif;"
        >
          <a href="/destinations" class="transition-colors duration-300 hover:text-charcoal">
            Destinations
          </a>
          <span class="mx-3 text-taupe-light/60">/</span>
          <a
            href={`/destinations/${region.slug}`}
            class="transition-colors duration-300 hover:text-charcoal"
          >
            {region.name}
          </a>
          <span class="mx-3 text-taupe-light/60">/</span>
          <span class="text-charcoal">{location.name}</span>
        </nav>

        <h1
          data-reveal="up"
          class="mt-10 text-5xl font-light tracking-[0.12em] uppercase text-charcoal sm:text-6xl lg:text-7xl"
          style="font-family: 'Raleway', sans-serif; font-weight: 300;"
        >
          {location.name}
        </h1>

        <div data-reveal-line class="mt-8 h-px bg-gold"></div>

        <p
          data-reveal="up"
          class="mt-8 max-w-2xl text-lg font-light leading-relaxed text-taupe sm:text-xl"
        >
          {region.tagline}.
        </p>
      </div>
    </header>

    <!-- Cruising areas -->
    <section class="bg-warm-white py-20 sm:py-24">
      <div class="mx-auto max-w-[1280px] px-6 sm:px-8 lg:px-12">
        <div class="text-center">
          <p
            data-reveal="fade"
            class="text-[11px] font-medium tracking-[0.35em] uppercase text-gold"
            style="font-family: 'Raleway', sans-serif;"
          >
            Where You Sail
          </p>
          <h2
            data-reveal="up"
            class="mt-5 text-3xl font-light tracking-[0.12em] uppercase text-charcoal sm:text-4xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;"
          >
            Anchorages &amp; Ports of Call
          </h2>
          <div data-reveal-line class="mx-auto mt-6 h-px bg-gold"></div>
          <p
            data-reveal="up"
            class="mx-auto mt-6 max-w-2xl text-base font-light leading-relaxed text-taupe"
          >
            A starting palette of {location.name}&rsquo;s most cherished anchorages.
            Your final route is shaped by you and your broker.
          </p>
        </div>

        <ul
          data-reveal-stagger
          class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
        >
          {location.cruisingSpots.map((spot) => (
            <li class="group flex items-center justify-between border border-deep/10 bg-white px-5 py-4 transition-all duration-300 hover:border-gold hover:shadow-md">
              <span
                class="text-[12px] font-medium tracking-[0.18em] uppercase text-charcoal"
                style="font-family: 'Raleway', sans-serif;"
              >
                {spot}
              </span>
              <span class="h-px w-6 bg-gold/40 transition-all duration-300 group-hover:w-10 group-hover:bg-gold"></span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- How it works -->
    <section class="bg-cream/40 py-20 sm:py-24">
      <div class="mx-auto max-w-[1280px] px-6 sm:px-8 lg:px-12">
        <div class="text-center">
          <p
            data-reveal="fade"
            class="text-[11px] font-medium tracking-[0.35em] uppercase text-gold"
            style="font-family: 'Raleway', sans-serif;"
          >
            The Process
          </p>
          <h2
            data-reveal="up"
            class="mt-5 text-3xl font-light tracking-[0.12em] uppercase text-charcoal sm:text-4xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;"
          >
            How Your Itinerary Is Built
          </h2>
          <div data-reveal-line class="mx-auto mt-6 h-px bg-gold"></div>
          <p
            data-reveal="up"
            class="mx-auto mt-6 max-w-2xl text-base font-light leading-relaxed text-taupe"
          >
            Every charter is plotted privately with your broker. No two itineraries
            in {location.name} are ever the same.
          </p>
        </div>

        <ol data-reveal-stagger class="mt-16 grid grid-cols-1 gap-10 md:grid-cols-3">
          <li class="text-center">
            <span
              class="num inline-flex h-12 w-12 items-center justify-center border border-gold/40 text-base text-gold"
              style="font-family: 'Inter', sans-serif;"
            >
              01
            </span>
            <h3
              class="mt-6 text-base font-medium tracking-[0.22em] uppercase text-charcoal"
              style="font-family: 'Raleway', sans-serif;"
            >
              Choose Your Waters
            </h3>
            <p class="mx-auto mt-4 max-w-xs text-sm font-light leading-relaxed text-taupe">
              You tell us where you want to wake up. The cruising area you choose
              defines where you embark and disembark. Everything else
              follows from there.
            </p>
          </li>

          <li class="text-center">
            <span
              class="num inline-flex h-12 w-12 items-center justify-center border border-gold/40 text-base text-gold"
              style="font-family: 'Inter', sans-serif;"
            >
              02
            </span>
            <h3
              class="mt-6 text-base font-medium tracking-[0.22em] uppercase text-charcoal"
              style="font-family: 'Raleway', sans-serif;"
            >
              Tailor The Route
            </h3>
            <p class="mx-auto mt-4 max-w-xs text-sm font-light leading-relaxed text-taupe">
              Share what you love. Ancient sites, fine restaurants, hidden
              bays, marine life, shopping ports. Your broker advises on the
              anchorages that fit your party best.
            </p>
          </li>

          <li class="text-center">
            <span
              class="num inline-flex h-12 w-12 items-center justify-center border border-gold/40 text-base text-gold"
              style="font-family: 'Inter', sans-serif;"
            >
              03
            </span>
            <h3
              class="mt-6 text-base font-medium tracking-[0.22em] uppercase text-charcoal"
              style="font-family: 'Raleway', sans-serif;"
            >
              Sail With The Wind
            </h3>
            <p class="mx-auto mt-4 max-w-xs text-sm font-light leading-relaxed text-taupe">
              Every itinerary stays flexible. The captain adapts the plan in
              real time around weather, sea state, and however the trip
              unfolds onboard.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <!-- Yachts cruising here -->
    {yachts.length > 0 && (
      <section class="bg-warm-white py-20 sm:py-24">
        <div class="mx-auto max-w-[1440px] px-6 sm:px-8 lg:px-12">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p
                data-reveal="fade"
                class="text-[11px] font-medium tracking-[0.35em] uppercase text-gold"
                style="font-family: 'Raleway', sans-serif;"
              >
                Available Fleet
              </p>
              <h2
                data-reveal="up"
                class="mt-4 text-3xl font-light tracking-[0.12em] uppercase text-charcoal sm:text-4xl"
                style="font-family: 'Raleway', sans-serif; font-weight: 300;"
              >
                Yachts Cruising {location.name}
              </h2>
              <div data-reveal-line class="mt-6 h-px bg-gold"></div>
            </div>
            {totalMatches > yachts.length && (
              <p
                class="text-[11px] font-medium tracking-[0.2em] uppercase text-taupe"
                style="font-family: 'Raleway', sans-serif;"
              >
                Showing {yachts.length} of {totalMatches}
              </p>
            )}
          </div>

          <div data-reveal-stagger class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
            {yachts.map((yacht) => (
              <YachtCardCatalogue yacht={yacht} />
            ))}
          </div>

          <div class="mt-12 text-center">
            <a
              href={`/yachts?region=${region.slug}`}
              class="group inline-flex items-center gap-3 bg-deep px-10 py-4 text-[12px] font-medium tracking-[0.3em] uppercase text-white shadow-md transition-all duration-300 hover:bg-gold hover:shadow-lg sm:px-12"
              style="font-family: 'Raleway', sans-serif;"
            >
              Browse All Yachts In {region.name}
              <svg
                class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="bg-white py-20 sm:py-24">
      <div class="mx-auto max-w-2xl px-6 text-center sm:px-8">
        <p
          data-reveal="fade"
          class="text-[11px] font-medium tracking-[0.35em] uppercase text-gold/70"
          style="font-family: 'Raleway', sans-serif;"
        >
          Plan Your Charter
        </p>
        <h2
          data-reveal="up"
          class="mt-5 text-3xl font-light tracking-[0.12em] uppercase text-charcoal sm:text-4xl"
          style="font-family: 'Raleway', sans-serif; font-weight: 300;"
        >
          Build Your {location.name} Itinerary
        </h2>
        <div data-reveal-line class="mx-auto mt-6 h-px bg-gold"></div>
        <p class="mx-auto mt-8 text-base font-light leading-relaxed text-taupe sm:text-lg">
          Send us your dates, party size, and the kind of trip you have in mind.
          Your broker will respond within hours with yacht options and a draft route.
        </p>
        <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-fill inline-flex items-center gap-3 border border-deep/20 px-8 py-3.5 text-[11px] font-medium tracking-[0.25em] uppercase text-charcoal"
            style="font-family: 'Raleway', sans-serif;"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Speak With Your Broker
          </a>
          <a
            href="/destinations"
            class="inline-flex items-center gap-2 px-4 py-3.5 text-[11px] font-medium tracking-[0.25em] uppercase text-taupe transition-colors duration-300 hover:text-gold"
            style="font-family: 'Raleway', sans-serif;"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            All Destinations
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
