  "crew": [
    {
      "name": "ANTE ŠERKA",
      "role": "Captain",
      "bio": "Professional Background:\nBorn in 1981 in Vancouver to a Brač family of master shipbuilders, Ante grew up in the family yard learning wooden-boat construction. He earned his\ncaptain’s license at 20 and has commanded a growing family fleet ever since. In 2019 he built and became the owner-operator of YOLO, which he has captained from launch to date. Hands-on year-round, he knows every system aboard and keeps the yacht in peak condition.\nPersonal Interests:\nFamily time, motorcycles, fishing, and all things maritime.\nLanguages Spoken:\nCroatian (native), English (fluent), German (conversational/professional)"
    },
    {
      "name": "IVANA ŠERKA",
      "role": "Captain",
      "bio": "Professional Background:\nFrom a yachting family with deep Adriatic connections. Orchestrates cross-department coordination and flawless daily execution; proactive improvements to guest programming.\nPersonal Interests:\nExtroverted, humorous, and high-energy; enjoys family time, swimming, and travel.\nLanguages Spoken:\nCroatian (native), English (fluent)"
    },
    {
      "name": "MIRELA TVAROG",
      "role": "Captain",
      "bio": "Professional Background:\nPedagogy graduate turned luxury-travel creator and agent; now in her 3rd season as YOLO’s Guest Manager. Central liaison for guests and crew, organized, adaptable, and unflappable with last-minute changes.\nPersonal Interests:\nPeople-centric, detail-driven, and devoted to crafting seamless end-to-end experiences.\nLanguages Spoken:\nCroatian (native), English (fluent)"
    },
    {
      "name": "TONI MATULIĆ",
      "role": "Captain",
      "bio": "Professional Background:\nCulinary-school graduate with years in fine-dining restaurants and luxury hotels; additional international training. Creates guest-tailored menus using\nfresh, local produce from fishermen, farmers, and butchers at every port. Strong pastry and bakery skills.\nPersonal Interests:\nWarm host who loves crafting memorable multi-course experiences and surprise breads/desserts. “No request is too much.”\nLanguages Spoken:\nCroatian (native), English (fluent)"
    },
    {
      "name": "ELA SKRBINŠEK",
      "role": "Captain",
      "bio": "Professional Background:\nTrained at sea over the last three years under accomplished chefs. Blends a humanities background in English and German with culinary precision; creative, ingredient-driven, and adaptable to charter dynamics.\nPersonal Interests:Nature, reading, and time with her pet; committed to continual learning.\nLanguages Spoken:\nCroatian (fluent), English (fluent), German (professional)"
    },
    {
      "name": "MATE RADIĆ",
      "role": "Captain",
      "bio": "Professional Background:\nMaritime-school graduate with strong safety foundations; expert at tender/jet-ski handling, water-toy ops, docking, and exterior maintenance. Known for methodical problem-solving and a perfectionist approach that broadens his remit onboard.\nPersonal Interests:\nLifelong seafarer who enjoys teaching guests on the water—patient, supportive, and guest-focused. Ambition: future captain.\nLanguages Spoken:\nCroatian (native), English (fluent)"
    },
    {
      "name": "MARKO GLAVINIĆ",
      "role": "Captain",
      "bio": "Professional Background:\nIslander, professional diver, and former owner-operator of a water-sports rental company (jet skis focus). Brings entrepreneurial rigor to yacht ops: line handling, mooring, safety cover for water sports, and guest support.\nPersonal Interests:\nSwimming and fishing; recognized for kindness, precision, and safety-first mindset.\nLanguages Spoken:\nCroatian (native), English (fluent)"
    },
    {
      "name": "ANTE SAMODOL",
      "role": "Captain",
      "bio": "Professional Background:\nHospitality professional and former restaurant leader; elevates service through detail, presentation, and beverage pairing. Sommelier knowledge across wines and spirits; excels in signature cocktails and personalized service flows.\nPersonal Interests:\nQuietly witty host who balances precision with warmth.\nLanguages Spoken:\nCroatian (native), English (fluent)"
    },
    {
