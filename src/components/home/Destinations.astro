---
import { Image } from "astro:assets";
import pano from "../../assets/pano1.jpeg";
---

<section id="destinations-section" class="relative w-full" style="height: 200vh;">
  <div class="sticky top-0 h-screen w-full overflow-hidden bg-black">
    <Image
      src={pano}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      widths={[1280, 1920]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-black/35"></div>

    <div class="relative z-10 flex h-full w-full items-center justify-center px-6">
      <div class="relative w-full max-w-3xl" style="min-height: 220px;">
        <!-- Stage 1: Title -->
        <div id="dest-stage-1" class="absolute inset-0 flex items-center justify-center text-center">
          <div>
            <p class="text-[11px] font-light tracking-[0.3em] uppercase text-white/70">
              Where We Sail
            </p>
            <h2
              class="mt-4 text-5xl font-light tracking-[0.2em] uppercase text-white sm:text-6xl lg:text-7xl"
              style="font-family: 'Raleway', sans-serif; font-weight: 300;"
            >
              Destinations
            </h2>
            <div class="mx-auto mt-5 h-px w-12 bg-white/40"></div>
          </div>
        </div>

        <!-- Stage 2: Button -->
        <div id="dest-stage-2" class="absolute inset-0 flex items-center justify-center" style="opacity: 0; pointer-events: none;">
          <a
            href="/destinations"
            class="btn-fill-light inline-flex items-center gap-3 border border-white/40 px-8 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-white"
          >
            Explore Destinations
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById("destinations-section");
  const stage1 = document.getElementById("dest-stage-1");
  const stage2 = document.getElementById("dest-stage-2");

  if (section && stage1 && stage2) {
    function fadeRange(p: number, start: number, end: number) {
      if (p <= start) return 0;
      if (p >= end) return 1;
      return (p - start) / (end - start);
    }

    function render() {
      const rect = section!.getBoundingClientRect();
      const vh = window.innerHeight;
      const travel = rect.height - vh;
      let progress = 0;
      if (travel > 0) {
        progress = Math.max(0, Math.min(1, -rect.top / travel));
      }

      const fade = fadeRange(progress, 0.35, 0.6);
      stage1!.style.opacity = String(1 - fade);
      stage2!.style.opacity = String(fade);
      stage2!.style.pointerEvents = fade > 0.5 ? "auto" : "none";
    }

    render();

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            render();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );

    window.addEventListener("resize", render);

    // Auto-scroll to reveal the "Explore Destinations" button when arriving via
    // a navbar link. Lets the user briefly see the title (stage 1), then
    // smooth-scrolls past the crossfade so stage 2 is fully visible.
    const targetHash = "#destinations-section";
    let pendingScroll: number | null = null;

    function autoScrollToButton() {
      if (pendingScroll !== null) window.clearTimeout(pendingScroll);
      pendingScroll = window.setTimeout(() => {
        pendingScroll = null;
        const rect = section!.getBoundingClientRect();
        const sectionTop = rect.top + window.scrollY;
        const travel = section!.offsetHeight - window.innerHeight;
        if (travel <= 0) return;
        // Progress 0.7 puts us past the 0.35–0.6 crossfade range,
        // with the button fully opaque and interactive.
        const targetY = sectionTop + travel * 0.7;
        window.scrollTo({ top: targetY, behavior: "smooth" });
      }, 1000);
    }

    if (window.location.hash === targetHash) {
      autoScrollToButton();
    }

    window.addEventListener("hashchange", () => {
      if (window.location.hash === targetHash) autoScrollToButton();
    });

    // Same-page clicks where the hash doesn't change still need to trigger.
    document
      .querySelectorAll<HTMLAnchorElement>(`a[href$="${targetHash}"]`)
      .forEach((link) => {
        link.addEventListener("click", () => autoScrollToButton());
      });
  }
</script>
