---
import type { Region } from "../../data/types/destination";

interface Props {
  region: Region;
  index: number;
}

const { region, index } = Astro.props;
const locationsLower = region.locations.map((l) => l.name.toLowerCase()).join("|");

// Hero image is a remote Unsplash URL stored on the region (see
// src/data/destinations/regions.json). The URL embeds `?w=1600` — we swap
// that out for smaller widths to build a srcset so cards on phones don't
// pay the full desktop download.
function unsplashAt(url: string, width: number): string {
  return url.replace(/(\?|&)w=\d+/, `$1w=${width}`);
}
const src640 = unsplashAt(region.heroImage, 640);
const src960 = unsplashAt(region.heroImage, 960);
const src1600 = unsplashAt(region.heroImage, 1600);
---

<li
  data-region-card
  data-region-slug={region.slug}
  data-region-name={region.name.toLowerCase()}
  data-locations={locationsLower}
  class="region-card flex flex-col scroll-mt-[120px] sm:scroll-mt-[180px] transition-[opacity,transform] duration-300 ease-out"
>
  <a
    href={`/destinations/${region.slug}`}
    class="region-link group relative block w-full overflow-hidden bg-deep cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-gold"
    style="aspect-ratio: 4 / 3;"
  >
    <img
      src={src960}
      srcset={`${src640} 640w, ${src960} 960w, ${src1600} 1600w`}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      alt={region.name}
      loading={index < 3 ? "eager" : "lazy"}
      decoding="async"
      width="1600"
      height="1200"
      class="region-image absolute inset-0 h-full w-full object-cover transition-[transform,filter] duration-700 ease-out group-hover:scale-[1.04] group-hover:blur-md group-hover:brightness-[0.45]"
    />

    <!-- Default state: region identity, bottom-left — small caption style. -->
    <div
      class="region-identity absolute inset-x-0 bottom-0 px-5 pb-4 sm:px-6 sm:pb-5 transition-[opacity,transform] duration-500 ease-out group-hover:opacity-0 group-hover:translate-y-1"
    >
      <h3
        class="text-[13px] font-light tracking-[0.22em] uppercase text-white sm:text-[14px]"
        style="font-family: 'Raleway', sans-serif; font-weight: 300; text-shadow: 0 2px 14px rgba(0,0,0,0.9), 0 1px 4px rgba(0,0,0,0.75), 0 0 2px rgba(0,0,0,0.6);"
      >
        {region.name}
      </h3>
      <p
        class="mt-1 max-w-[18rem] text-[10px] font-light leading-snug text-white/80 sm:text-[11px]"
        style="font-family: 'Raleway', sans-serif; text-shadow: 0 2px 12px rgba(0,0,0,0.85), 0 1px 3px rgba(0,0,0,0.7), 0 0 2px rgba(0,0,0,0.55);"
      >
        {region.tagline}
      </p>
    </div>

    <!-- Hover state: EXPLORE centered with a soft fade + scale. -->
    <div
      class="region-explore absolute inset-0 flex items-center justify-center opacity-0 scale-95 transition-[opacity,transform] duration-500 ease-out group-hover:opacity-100 group-hover:scale-100"
    >
      <span
        class="inline-flex items-center gap-3 text-[11px] font-medium tracking-[0.5em] uppercase text-white"
        style="font-family: 'Raleway', sans-serif;"
      >
        Explore
        <svg
          class="h-3 w-3"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </div>
  </a>
</li>

<style is:global>
  [data-region-card][data-dimmed="true"] {
    opacity: 0.3;
    transform: scale(0.97);
    pointer-events: none;
  }
  [data-region-card][data-hidden="true"] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-region-card],
    [data-region-card] .region-image,
    [data-region-card] .region-identity,
    [data-region-card] .region-explore {
      transition: none !important;
    }
    [data-region-card] .region-link:hover .region-image {
      transform: none !important;
      filter: none !important;
    }
  }
</style>
