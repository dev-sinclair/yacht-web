  "crew": [
    {
      "name": "Olivier Kobale",
      "avatar": "/media/media::image::c::35182310185::vessel::17ffe080-ba3a-11f0-9548-87d5452668cc::assets::8d0f8b30-bfb4-11f0-afd6-8f67c3d32125/{imageVariant}",
      "role": "Captain",
      "bio": "Oliver grew up racing dinghies in Austria, competing at an international level in both the Oppie and 420. In 2019, he was one of the founding members of Austrian Ocean racing team and has clocked up over 120,000nm offshore with both professional and amateur crews. Oliver has a strong technical background having studied mechanical engineering. Oliver enjoys the combination of cruising and racing on Vantanera and leading his team to ensure guests have a great experience onboard.\n\n• RYA Yacht Master Offshore\n• Powerboat Level 2\n• Basic Paramedic training\n• Languages: English, Spanish, German"
    }
