  "crew": [
    {
      "name": "WILHELMUS WAGUT",
      "avatar": "/media/media::image::a::vessel::de61cb90-1899-11f1-8f85-d5f6c7ea7dd9::assets::5825dd30-189b-11f1-9e9d-95da3f960574/{imageVariant}",
      "role": "Captain",
      "bio": "Captain Wilhelmus Wagut, known as Capt. Will, has been leading Samara I since April 2018. With certifications in BST for KLM and MPR 1, he combines strong maritime skills with calm, steady leadership. His familiarity with the region’s waters and thoughtful approach to every journey help guests feel safe, relaxed, and well-guided throughout their time onboard."
    },
    {
      "name": "HILARIUS RITU",
      "avatar": "/media/media::image::a::vessel::de61cb90-1899-11f1-8f85-d5f6c7ea7dd9::assets::8cebb0d0-189b-11f1-99e6-57ad6d9c7893/{imageVariant}",
      "role": "Captain",
      "bio": "Hilarius Ritu, or Aris, joined Samara I in July 2017 and has grown into one of the most engaging personalities onboard. As Supervisor and Bartender, he enjoys assisting guests throughout the trip—from serving refreshing drinks to accompanying them during island activities. His BST for KM and Ratings of Navigational certifications support his hands-on approach to hospitality and daily operations."
    },
    {
      "name": "KORNELIS MITHE",
      "avatar": "/media/media::image::a::vessel::de61cb90-1899-11f1-8f85-d5f6c7ea7dd9::assets::ab064b70-189b-11f1-9e9d-95da3f960574/{imageVariant}",
      "role": "Captain",
      "bio": "Kornelis Mithe, known as Kornel, became part of Samara I in 2019. He manages tender boat operations with care, making every transfer smooth and worry-free for guests. Whether taking guests ashore or assisting with water activities, Kornel is known for his steady focus and friendly manner. His BST for KM and MPR 1 certifications strengthen his role on the team."
    },
    {
      "name": "HENDRIKUS EDISON EJAS",
      "avatar": "/media/media::image::a::vessel::de61cb90-1899-11f1-8f85-d5f6c7ea7dd9::assets::c2bade20-189b-11f1-9e9d-95da3f960574/{imageVariant}",
      "role": "Captain",
      "bio": "Hendrikus Edison Ejas, or Medi, joined Samara I in February 2018. He ensures each cabin remains clean, organized, and welcoming throughout the voyage. Medi’s attention to detail and warm attitude help create a comfortable onboard atmosphere. With his BST for KLM certification, he supports Samara’s high hospitality standards every day.\n"
    },
    {
      "name": "GONSIANUS HARYANTO",
      "avatar": "/media/media::image::a::vessel::de61cb90-1899-11f1-8f85-d5f6c7ea7dd9::assets::51616c20-189c-11f1-9e9d-95da3f960574/{imageVariant}",
      "role": "Captain",
      "bio": "Gonsianus Haryanto, known as Gonsi, has been part of Samara I since 2023. He prepares a variety of flavorful dishes that guests look forward to after each activity. His dedication in the kitchen and his BST for KLM certification make him an essential part of the dining experience onboard. Gonsi brings a comforting touch to every meal he serves.\n"
    },
    {
      "name": "OSWALDUS SUDARSO",
      "avatar": "/media/media::image::a::vessel::de61cb90-1899-11f1-8f85-d5f6c7ea7dd9::assets::6a5116e0-189c-11f1-9e9d-95da3f960574/{imageVariant}",
      "role": "Captain",
      "bio": "Oswaldus Sudarso, or Oswal, joined Samara I in July 2024. He brings fresh energy and creativity into the kitchen, supporting the culinary team in preparing meals that brighten each guest’s day. With a BST for KLM certification, he handles his role with enthusiasm and growing expertise, making him a valuable part of the crew."
    },
    {
      "name": "NASIRUDDIN",
      "avatar": "/media/media::image::a::vessel::de61cb90-1899-11f1-8f85-d5f6c7ea7dd9::assets::84dbacf0-189c-11f1-9e9d-95da3f960574/{imageVariant}",
      "role": "Captain",
      "bio": "Nasiruddin joined Samara in 2025, bringing strong technical skills and a sharp eye for detail to the engine room. With his BST certification and calm problem-solving attitude, he ensures every journey runs smoothly and safely behind the scenes. Always ready to step in when needed, he keeps the heart of the vessel operating at its best."
    },
    {
      "name": "WALMIN HAMZAH RAS",
      "avatar": "/media/media::image::a::vessel::de61cb90-1899-11f1-8f85-d5f6c7ea7dd9::assets::9d685020-189c-11f1-9e9d-95da3f960574/{imageVariant}",
      "role": "Captain",
      "bio": "Walmin joined Samara in 2025, bringing his passion for storytelling through photography to every journey. From capturing joyful moments on land to the beauty below the waves, he ensures each guest’s experience is preserved in unforgettable visuals. Friendly and always ready with his camera, Walmin transforms every memory into something guests can treasure long after they leave."
    }
  ],
