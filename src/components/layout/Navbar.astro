---
import { Image } from "astro:assets";
import logo from "../../assets/logo.png";

const links = [
  { label: "About", href: "/#about" },
  { label: "Yacht Charter", href: "/yachts" },
  { label: "Destinations", href: "/destinations" },
  { label: "Sales", href: "/sales" },
  { label: "Build", href: "/build" },
  { label: "Services", href: "/#services" },
  { label: "Contact", href: "/#contact" },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 z-50 w-full bg-white/95 py-5 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-[1440px] items-center justify-between px-6 sm:px-8 lg:px-12">
    <!-- Left: logo -->
    <div class="flex items-center gap-4 sm:gap-6">
      <a href="/" class="flex items-center gap-3">
        <Image
          src={logo}
          alt="Sinclair Yachting"
          class="h-10 w-auto sm:h-12"
          widths={[120, 200]}
          loading="eager"
        />
        <span
          class="inline text-[10px] font-light tracking-[0.15em] uppercase text-charcoal sm:text-[11px] sm:tracking-[0.25em]"
          style="font-family: 'Raleway', sans-serif; font-weight: 300;"
        >
          Sinclair Yachting
        </span>
      </a>
    </div>

    <!-- Right: inline section links -->
    <ul class="hidden md:flex items-center gap-8 lg:gap-10">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-link text-[11px] font-medium tracking-[0.25em] uppercase text-charcoal transition-colors duration-300 hover:text-gold"
            style="font-family: 'Raleway', sans-serif;"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile fallback: small toggle for the inline list on narrow screens -->
    <button
      id="menu-toggle"
      class="flex md:hidden flex-col gap-[6px] hover:cursor-pointer p-3"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="block h-px w-6 transition-transform duration-300" id="bar1"
        style="background-color: #151A24"></span>
      <span class="block h-px w-6 transition-transform duration-300" id="bar2"
        style="background-color: #151A24"></span>
    </button>
  </div>

  <!-- Mobile dropdown panel (compact, NOT fullscreen) -->
  <div
    id="mobile-panel"
    class="md:hidden overflow-hidden max-h-0 mt-5 transition-[max-height] duration-500 ease-out"
  >
    <ul class="flex flex-col gap-4 px-6 py-6 border-t border-charcoal/10">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-link block text-[11px] font-medium tracking-[0.25em] uppercase text-charcoal transition-colors duration-300 hover:text-gold"
            style="font-family: 'Raleway', sans-serif;"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle")!;
  const mobilePanel = document.getElementById("mobile-panel")!;
  const bar1 = document.getElementById("bar1")!;
  const bar2 = document.getElementById("bar2")!;

  let menuOpen = false;

  toggle.addEventListener("click", () => {
    menuOpen = !menuOpen;
    toggle.setAttribute("aria-expanded", String(menuOpen));
    if (menuOpen) {
      mobilePanel.style.maxHeight = mobilePanel.scrollHeight + "px";
      bar1.style.transform = "rotate(45deg) translate(3px, 3.5px)";
      bar2.style.transform = "rotate(-45deg) translate(3px, -3.5px)";
    } else {
      mobilePanel.style.maxHeight = "0px";
      bar1.style.transform = "";
      bar2.style.transform = "";
    }
  });

  // Close mobile panel on link click
  mobilePanel.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menuOpen = false;
      toggle.setAttribute("aria-expanded", "false");
      mobilePanel.style.maxHeight = "0px";
      bar1.style.transform = "";
      bar2.style.transform = "";
    });
  });
</script>
