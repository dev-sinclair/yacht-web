  "crew": [
    {
      "name": "Robin Smedley ",
      "avatar": "/media/media::image::c::52220319023::vessel::d5cbfb0b-fe8c-11ed-889f-43d4bb723744::assets::9bcd8160-3c76-11f1-9688-e1069bb1a97f/{imageVariant}",
      "role": "Captain",
      "bio": "Robin Smedley is a highly experienced, Australian-born Captain with over 30 years at sea and a career spanning private, charter, and commercial vessels across the globe. Holding a Master Class 4, MED 2, RYA Yacht Master Offshore Commercially Endorsed, and PADI licence, Robin has captained motor yachts and sailing vessels ranging from 20 to 36 metres in destinations including Australia, the Mediterranean, the Caribbean, and Southeast Asia. Known for his breadth of experience across both power and sail, Robin brings professionalism, technical know-how, and a calm, well-travelled command style to every vessel he serves."
    },
    {
      "name": "Tia Smedly",
      "avatar": "/media/media::image::c::52220319023::vessel::d5cbfb0b-fe8c-11ed-889f-43d4bb723744::assets::f6729d30-3c76-11f1-be9d-c30034892559/{imageVariant}",
      "role": "Captain",
      "bio": "Tia Smedley is an experienced Australian Chief Stewardess and Cook with nearly three decades of maritime experience across private and charter yachts worldwide. Having worked aboard vessels ranging from 80 to 130 feet in destinations spanning Australia, Asia, Spain, and the Americas, she brings a versatile skill set including five-star silver service, provisioning, crew cooking, interior maintenance, and yacht management. Most recently working in the Australian charter industry, Tia is a well-rounded and dependable crew member with a strong track record in both private and charter environments."
    },
    {
      "name": "Ella Haapala",
      "avatar": "/media/media::image::c::52220319023::vessel::d5cbfb0b-fe8c-11ed-889f-43d4bb723744::assets::96eaefb0-3c77-11f1-8753-9199febc989c/{imageVariant}",
      "role": "Captain",
      "bio": "Ella Haapala is a dedicated and passionate marine professional with years of hands-on experience working aboard luxury superyachts along Australia's east coast. Originally from Finland, Ella brings a warm, adventurous spirit and a natural love for the water to everything she does.\n\nWith a background in providing exceptional guest experiences on charter vessels, Ella understands the importance of keeping every detail perfect — from a spotless deck to a seamless day on the water. She is highly trained, certified, and ready to ensure guests feel safe, comfortable, and well looked after at all times."
    },
    {
      "name": "Michael Caminiti",
      "avatar": "/media/media::image::c::52220319023::vessel::d5cbfb0b-fe8c-11ed-889f-43d4bb723744::assets::5b627b90-3c7f-11f1-b344-8bd50ab1458c/{imageVariant}",
      "role": "Captain",
      "bio": "Australian-born with Italian soul, Michael grew up in the kitchens of his family's Italian restaurant, where a love of generous, produce-led cooking was second nature long before it was a career. That heritage shows in everything he plates, effortless, flavour-first food with genuine warmth behind it.\n\nBefore bringing his talents on board, Michael built and ran his own events company as owner-operator, mastering the art of seamless service at scale and the kind of effortless hospitality that defines a memorable occasion. A lifelong passion for the water makes the move to yachting a natural one, there's nowhere he'd rather cook than at sea.\n\nWhether it's a relaxed lunch on the aft deck or a celebration dinner under the stars, Michael brings Italian heart, professional polish, and an easy charm that guests remember long after they step ashore."
    },
    {
      "name": "Dean Sellers",
      "role": "Captain",
      "bio": "Dean Sellers is a Marine Engineer Class 3 and Engineer Watchkeeper with 20+ years of experience across tug vessels, superyachts, and commercial marine operations. He has worked for leading operators including Svitzer, SMIT, and Southern Cross Maritime, and earlier served as chief and senior engineer on private and charter yachts. Fully certified across STCW, MSIC, medical first aid, and confined space entry, Dean is a dependable, multi-skilled marine professional ready to hit the ground running."
    }
  ],
