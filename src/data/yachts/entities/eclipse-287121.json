  "crew": [
    {
      "name": "Ryan",
      "avatar": "/media/media::image::a::vessel::287121e0-a1ed-11f1-a5e9-97cda0d8d3e5::assets::b23177e0-a1f2-11f1-b39f-6ffd28868d1b/{imageVariant}",
      "role": "Captain",
      "bio": "Ryan’s knowledge of the marine industry and his dedication to excelling in the field form the foundation for Eclipse’s dedication to maintaining a superior standard on board our vessel. Like Jackson, he has spent many years aboard various vessels exploring the Kimberley so he too, has a deep connection to the region and is eager to show it to all who come aboard."
    },
    {
      "name": "Jackson",
      "avatar": "/media/media::image::a::vessel::287121e0-a1ed-11f1-a5e9-97cda0d8d3e5::assets::c132b740-a1f2-11f1-b39f-6ffd28868d1b/{imageVariant}",
      "role": "Captain",
      "bio": "Jackson lives and breathes the Kimberley.\n\nThanks to close family ties to the area, he has been exploring the Kimberley by boat from a very young age which sparked his passion for showing off the unique area to intrepid travellers from around the world. He’s even had a secret waterfall named after him. Jackson’s vibrant energy make him fantastic company to have on board and his deep knowledge of the area means he will expertly guide you to far off corners of this incredible region."
    },
    {
      "name": "Hannah",
      "avatar": "/media/media::image::a::vessel::287121e0-a1ed-11f1-a5e9-97cda0d8d3e5::assets::d2d380b0-a1f2-11f1-b39f-6ffd28868d1b/{imageVariant}",
      "role": "Captain",
      "bio": "Hannah’s extensive hospitality experience and her natural ability to mingle with people from all walks of life form our ethos of superior service for all who step aboard. Her bubbly personality and her keen sense of adventure is infectious, you are guaranteed to have a good time when she’s taking care of your travels."
    },
    {
      "name": "Chris 'Critter'",
      "avatar": "/media/media::image::a::vessel::287121e0-a1ed-11f1-a5e9-97cda0d8d3e5::assets::e4328630-a1f2-11f1-b39f-6ffd28868d1b/{imageVariant}",
      "role": "Captain",
      "bio": "Having grown up in Broome and spent years fishing Kimberley waters aboard respected vessels, Chris — or ‘Critter’, as he’s known — brings an exceptional understanding of navigating the region’s river systems, tides and productive fishing grounds. \n\nA passionate member of WA’s game fishing community, he truly lives and breathes fishing. Critter is known for \nhis enthusiasm and excites in expertly interpreting the tides, finding productive waters and guiding guests into places many vessels simply can’t access. Whether assisting experienced anglers or supporting first-time fishers, he adds a depth of expertise and energy to every voyage. "
    },
    {
      "name": "Will",
      "avatar": "/media/media::image::a::vessel::287121e0-a1ed-11f1-a5e9-97cda0d8d3e5::assets::05b2e110-a1f3-11f1-b39f-6ffd28868d1b/{imageVariant}",
      "role": "Captain",
      "bio": "Hailing from the UK originally and having spent years traversing the globe in search of unique flavours, Will joins Eclipse with a wealth of expertise and a passion for sharing the cuisines he has come to know and love. Will’s eagerness to provide a unique and high level dining experience to travellers exploring this incredible coastline with Eclipse was ignited by his recent position as head chef onboard a premier operator of sunset cruises along the West Australian coastline."
    },
    {
      "name": "Tess",
      "avatar": "/media/media::image::a::vessel::287121e0-a1ed-11f1-a5e9-97cda0d8d3e5::assets::12d48b00-a1f3-11f1-b39f-6ffd28868d1b/{imageVariant}",
      "role": "Captain",
      "bio": "Tess brings both passion and expertise to every journey. A skilled sailor with extensive experience navigating vessels, she ensures our guests feel safe and cared for on the water.\n\nWith a degree in Marine Biology, Tess adds a deeper dimension to each voyage, sharing her knowledge of the ocean and its extraordinary ecosystems. Her love for the sea and its stories makes her an invaluable part of the Eclipse crew."
    },
    {
      "name": "Jessie",
      "avatar": "/media/media::image::a::vessel::287121e0-a1ed-11f1-a5e9-97cda0d8d3e5::assets::2bf57ef0-a1f3-11f1-99c4-4b4300fd6e21/{imageVariant}",
      "role": "Captain",
      "bio": "With a background in hospitality and the marine tourism industry, Jess joins Eclipse Expeditions in the combined role of onboard Stewardess and Deckhand.\n\nHer positive attitude and caring nature make Jess a pleasure to have onboard and she delivers a high level of customer service to all guests. Jess has a deep passion and knowledge of the regions through which we cruise and delights in sharing this with guests. "
    }
  ],
