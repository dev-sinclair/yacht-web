---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import salesImg from "../../assets/sales-main.jpeg";
import salesImgMobile from "../../assets/sales-yacht.jpg";
---

<!-- Bridge band: light-bg intro into the dark Sales hero. Kept on solid
     warm-white so the section ends at a clean edge — no visible gradient
     strip on mobile. The transition between this section and the dark
     Sales hero is a deliberate hard cut, framed by the bridge copy. -->
<section class="relative bg-warm-white pt-10 pb-14 lg:pt-16 lg:pb-20">
  <Container>
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">
        Beyond Charter
      </p>
      <div class="mx-auto mt-6 h-px w-10 bg-gold/40"></div>
      <p class="mt-8 text-base leading-[1.85] text-taupe sm:text-lg">
        Charter is only one chapter. From sourcing the right yacht to commissioning a new build, our brokerage supports every stage of ownership. Privately, and on your terms.
      </p>
    </div>
  </Container>
</section>

<section id="sales-section" class="relative w-full" style="height: 200vh;">
  <div class="sticky top-0 h-screen w-full overflow-hidden bg-black">
    <Image
      src={salesImgMobile}
      alt=""
      class="absolute inset-0 h-full w-full object-cover md:hidden"
      widths={[480, 768]}
      sizes="100vw"
      loading="lazy"
    />
    <Image
      src={salesImg}
      alt=""
      class="absolute inset-0 h-full w-full object-cover hidden md:block"
      widths={[1280, 1920]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-black/75"></div>

    <div class="relative z-10 flex h-full w-full items-center justify-center px-6">
      <div class="relative w-full max-w-3xl" style="min-height: 220px;">
        <!-- Stage 1: Title -->
        <div id="sales-stage-1" class="absolute inset-0 flex items-center justify-center text-center">
          <div>
            <p class="text-[11px] font-light tracking-[0.3em] uppercase text-white/70">
              Brokerage
            </p>
            <h2
              class="mt-4 text-3xl font-light tracking-[0.1em] uppercase text-white sm:text-5xl sm:tracking-[0.2em] md:text-6xl lg:text-7xl"
              style="font-family: 'Raleway', sans-serif; font-weight: 300;"
            >
              Sales
            </h2>
            <div class="mx-auto mt-5 h-px w-12 bg-white/40"></div>
          </div>
        </div>

        <!-- Stage 2: Button -->
        <div id="sales-stage-2" class="absolute inset-0 flex items-center justify-center" style="opacity: 0; pointer-events: none;">
          <a
            href="/sales"
            class="btn-fill-light inline-flex items-center gap-3 border border-white/40 px-8 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-white"
          >
            Explore Sales
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById("sales-section");
  const stage1 = document.getElementById("sales-stage-1");
  const stage2 = document.getElementById("sales-stage-2");

  if (section && stage1 && stage2) {
    function fadeRange(p: number, start: number, end: number) {
      if (p <= start) return 0;
      if (p >= end) return 1;
      return (p - start) / (end - start);
    }

    function render() {
      const rect = section!.getBoundingClientRect();
      const vh = window.innerHeight;
      const travel = rect.height - vh;
      let progress = 0;
      if (travel > 0) {
        progress = Math.max(0, Math.min(1, -rect.top / travel));
      }

      const fade = fadeRange(progress, 0.35, 0.6);
      stage1!.style.opacity = String(1 - fade);
      stage2!.style.opacity = String(fade);
      stage2!.style.pointerEvents = fade > 0.5 ? "auto" : "none";
    }

    render();

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            render();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );

    window.addEventListener("resize", render);

    const targetHash = "#sales-section";
    let pendingScroll: number | null = null;

    function autoScrollToButton() {
      if (pendingScroll !== null) window.clearTimeout(pendingScroll);
      pendingScroll = window.setTimeout(() => {
        pendingScroll = null;
        const rect = section!.getBoundingClientRect();
        const sectionTop = rect.top + window.scrollY;
        const travel = section!.offsetHeight - window.innerHeight;
        if (travel <= 0) return;
        const targetY = sectionTop + travel * 0.7;
        window.scrollTo({ top: targetY, behavior: "smooth" });
      }, 1000);
    }

    if (window.location.hash === targetHash) {
      autoScrollToButton();
    }

    window.addEventListener("hashchange", () => {
      if (window.location.hash === targetHash) autoScrollToButton();
    });

    document
      .querySelectorAll<HTMLAnchorElement>(`a[href$="${targetHash}"]`)
      .forEach((link) => {
        link.addEventListener("click", () => autoScrollToButton());
      });
  }
</script>
