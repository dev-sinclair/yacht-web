---
import Container from "../ui/Container.astro";

const pillars = [
  { label: "Private", text: "One broker, one client. Direct and personal." },
  { label: "Global", text: "Curated yachts across the world's finest waters." },
  { label: "Bespoke", text: "Every itinerary shaped around you." },
  { label: "Discreet", text: "Confidentiality at every step of the journey." },
];
---

<section
  id="about"
  class="relative overflow-hidden pt-20 pb-32 lg:py-44"
  style="background-color: #6e8e8f;"
>
  <!-- Dim overlay (matches the service-page brand-blue bands) -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-color: rgba(15, 24, 25, 0.14);"
  >
  </div>

  <Container>
    <div class="relative">
      <div>
        <div data-reveal>
          <p class="text-[11px] font-light tracking-[0.3em] uppercase text-white/80">About Us</p>
          <!-- <h2
            class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;"
          >
            A Private Passage<br />
            Across Every Horizon
          </h2> -->
          <div class="mt-6 h-px w-10 bg-white/40"></div>
          <p class="mt-8 max-w-xl text-base leading-[1.8] text-white/85">
            Sinclair Yachting is a boutique brokerage connecting a select clientele with exceptional yachts across the world's finest cruising grounds. Quiet, personal, and deliberate at every step.
          </p>
        </div>

        <!-- Pillars -->
        <div class="mt-12 grid grid-cols-1 gap-y-8 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-4 lg:gap-x-10" data-reveal>
          {pillars.map((p) => (
            <div>
              <p
                class="text-xl font-light tracking-[0.25em] uppercase text-white sm:text-2xl"
                style="font-family: 'Raleway', sans-serif; font-weight: 300;"
              >
                {p.label}
              </p>
              <p class="mt-2 text-sm leading-[1.7] text-white/85">
                {p.text}
              </p>
            </div>
          ))}
        </div>

        <!-- Primary CTA: yacht charter is the main purpose of the site, so
             this is the hero action. Centered, filled, oversized vs. other
             buttons in the page rhythm. -->
        <div class="mt-16 flex flex-col items-center lg:mt-20" data-reveal>
          <p class="text-[11px] font-light tracking-[0.3em] uppercase text-white/80 mb-6">
            Start Your Journey
          </p>
          <a
            href="/yachts"
            class="group relative inline-flex items-center gap-4 overflow-hidden bg-white px-10 py-5 text-[12px] font-medium tracking-[0.3em] uppercase text-charcoal shadow-md transition-all duration-300 hover:bg-charcoal hover:text-white hover:shadow-lg sm:px-14 sm:text-[13px]"
          >
            <span class="relative z-10">View Available Yachts</span>
            <svg
              class="relative z-10 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <p class="mt-4 text-[10px] font-light tracking-[0.2em] uppercase text-white/70">
            Browse over 750 charter yachts worldwide
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>
