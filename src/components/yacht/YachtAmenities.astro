---
import type { Yacht } from "../../data/types/yacht";

interface Props {
  yacht: Yacht;
}

const { yacht } = Astro.props;

const sections = [
  { title: "Amenities", items: yacht.amenities },
  { title: "Toys & Water Sports", items: yacht.toys },
  { title: "Entertainment", items: yacht.entertainment },
  ...(yacht.tenders.length > 0 ? [{ title: "Tenders", items: yacht.tenders }] : []),
];
---

<section class="bg-cream/30 py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div data-reveal>
      <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">On Board</p>
      <h2 class="mt-3 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl"
        style="font-family: 'Raleway', sans-serif; font-weight: 300;">
        Amenities & Features
      </h2>
    </div>

    <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {sections.map((section) => (
        <div>
          <h3 class="text-xs font-medium tracking-[0.15em] uppercase text-charcoal mb-4">{section.title}</h3>
          <ul class="space-y-2">
            {section.items.map((item) => (
              <li class="flex items-center gap-2 text-sm text-taupe">
                <span class="w-1 h-1 rounded-full bg-gold/50 shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
