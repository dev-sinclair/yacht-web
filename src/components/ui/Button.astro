---
interface Props {
  href?: string;
  variant?: "primary" | "outline" | "arrow";
  class?: string;
}

const { href, variant = "primary", class: className = "" } = Astro.props;
const Tag = href ? "a" : "button";

const base = "inline-flex items-center gap-3 text-[11px] font-medium tracking-[0.2em] uppercase cursor-pointer";
const variants = {
  primary: "btn-fill border border-deep/20 px-8 py-3.5 text-charcoal",
  outline: "btn-fill border border-gold/30 px-8 py-3.5 text-gold-dim",
  arrow: "btn-fill-light border border-white/40 px-6 py-3 text-white",
};
---

<Tag href={href} class:list={[base, variants[variant], className]}>
  <slot />
  {variant === "arrow" && (
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path d="M9 5l7 7-7 7" />
    </svg>
  )}
</Tag>
