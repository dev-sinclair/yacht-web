---
import { Image } from "astro:assets";
import buildImg from "../../assets/build-main.jpeg";
---

<section id="build-section" class="relative w-full" style="height: 200vh;">
  <div class="sticky top-0 h-screen w-full overflow-hidden bg-black">
    <Image
      src={buildImg}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      widths={[1280, 1920]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-black/60"></div>

    <div
      class="relative z-10 flex h-full w-full items-center justify-center px-6"
    >
      <div class="relative w-full max-w-3xl" style="min-height: 220px;">
        <!-- Stage 1: Title -->
        <div
          id="build-stage-1"
          class="absolute inset-0 flex items-center justify-center text-center"
        >
          <div>
            <p
              class="text-[11px] font-light tracking-[0.3em] uppercase text-white/70"
            >
              New Construction
            </p>
            <h2
              class="mt-4 text-3xl font-light tracking-[0.1em] uppercase text-white sm:text-5xl sm:tracking-[0.2em] md:text-6xl lg:text-7xl"
              style="font-family: 'Raleway', sans-serif; font-weight: 300;"
            >
              Build
            </h2>
            <div class="mx-auto mt-5 h-px w-12 bg-white/40"></div>
          </div>
        </div>

        <!-- Stage 2: Button -->
        <div
          id="build-stage-2"
          class="absolute inset-0 flex items-center justify-center"
          style="opacity: 0; pointer-events: none;"
        >
          <a
            href="/build"
            class="btn-fill-light inline-flex items-center gap-4 border border-white/40 px-12 py-5 text-[12px] font-medium tracking-[0.3em] uppercase text-white"
          >
            Explore Build
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById("build-section");
  const stage1 = document.getElementById("build-stage-1");
  const stage2 = document.getElementById("build-stage-2");

  if (section && stage1 && stage2) {
    function fadeRange(p: number, start: number, end: number) {
      if (p <= start) return 0;
      if (p >= end) return 1;
      return (p - start) / (end - start);
    }

    function render() {
      const rect = section!.getBoundingClientRect();
      const vh = window.innerHeight;
      const travel = rect.height - vh;
      let progress = 0;
      if (travel > 0) {
        progress = Math.max(0, Math.min(1, -rect.top / travel));
      }

      const fade = fadeRange(progress, 0.35, 0.6);
      stage1!.style.opacity = String(1 - fade);
      stage2!.style.opacity = String(fade);
      stage2!.style.pointerEvents = fade > 0.5 ? "auto" : "none";
    }

    render();

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            render();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true },
    );

    window.addEventListener("resize", render);

    const targetHash = "#build-section";
    let pendingScroll: number | null = null;

    function autoScrollToButton() {
      if (pendingScroll !== null) window.clearTimeout(pendingScroll);
      pendingScroll = window.setTimeout(() => {
        pendingScroll = null;
        const rect = section!.getBoundingClientRect();
        const sectionTop = rect.top + window.scrollY;
        const travel = section!.offsetHeight - window.innerHeight;
        if (travel <= 0) return;
        const targetY = sectionTop + travel * 0.7;
        window.scrollTo({ top: targetY, behavior: "smooth" });
      }, 1000);
    }

    if (window.location.hash === targetHash) {
      autoScrollToButton();
    }

    window.addEventListener("hashchange", () => {
      if (window.location.hash === targetHash) autoScrollToButton();
    });

    document
      .querySelectorAll<HTMLAnchorElement>(`a[href$="${targetHash}"]`)
      .forEach((link) => {
        link.addEventListener("click", () => autoScrollToButton());
      });
  }
</script>
