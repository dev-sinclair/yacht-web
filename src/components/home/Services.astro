---
import Container from "../ui/Container.astro";
import services from "../../data/services.json";
import experiences from "../../data/experiences.json";
---

<section id="services" class="relative min-h-screen flex items-center overflow-hidden py-24 lg:py-32"
  style="background: linear-gradient(180deg, #151A24 0%, #1D2330 100%);">

  <!-- Film grain overlay -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.06] z-10"
    style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E'); background-size: 200px 200px;">
  </div>

  <!-- Subtle warm vignette -->
  <div class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.4) 100%);"></div>

  <Container>
    <div class="relative z-20 grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-12 lg:gap-28 items-center">
      <!-- Left: services text -->
      <div>
        <!-- Header -->
        <div class="mb-4">
          <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold-light/70">
            What We Offer
          </p>
          <h2 class="mt-4 text-4xl font-light tracking-[0.15em] uppercase text-white/90 sm:text-5xl lg:text-6xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;">
            Our Services
          </h2>
        </div>

        <!-- Service content area -->
        <div class="relative" style="min-height: 200px;">
          {services.map((service, i) => (
            <div
              class="service-slide absolute inset-0 flex flex-col justify-center transition-all duration-500"
              data-service-index={i}
              style={i === 0 ? "opacity: 1; transform: translateY(0);" : "opacity: 0; transform: translateY(30px); pointer-events: none;"}
            >
              <h3 class="text-2xl font-light tracking-[0.1em] uppercase text-white/90 sm:text-3xl"
                style="font-family: 'Raleway', sans-serif; font-weight: 300;">
                {service.title}
              </h3>
              <p class="mt-5 text-base leading-relaxed text-white/50 max-w-lg">
                {service.description}
              </p>
            </div>
          ))}
        </div>

        <!-- Controls: arrows + bar indicators + counter -->
        <div class="mt-10 flex items-center gap-6">
          <!-- Arrows -->
          <div class="flex items-center gap-3">
            <button
              id="services-prev"
              type="button"
              aria-label="Previous service"
              class="group flex h-10 w-10 items-center justify-center border border-white/20 text-white/70 transition-all duration-300 hover:border-white/60 hover:text-white hover:cursor-pointer"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <button
              id="services-next"
              type="button"
              aria-label="Next service"
              class="group flex h-10 w-10 items-center justify-center border border-white/20 text-white/70 transition-all duration-300 hover:border-white/60 hover:text-white hover:cursor-pointer"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>

          <!-- Indicators -->
          <div class="flex flex-1 max-w-xs gap-3">
            {services.map((_, i) => (
              <button
                type="button"
                aria-label={`Go to service ${i + 1}`}
                data-bar-index={i}
                class="service-indicator group flex-1 h-[2px] bg-white/10 overflow-hidden hover:cursor-pointer hover:bg-white/20 transition-colors"
              >
                <div
                  class="service-bar h-full bg-white/80 transition-transform duration-500 origin-left pointer-events-none"
                  data-bar-index={i}
                  style={i === 0 ? "transform: scaleX(1);" : "transform: scaleX(0);"}
                ></div>
              </button>
            ))}
          </div>

          <!-- Counter -->
          <div class="text-[11px] font-medium tracking-[0.2em] text-white/50 num">
            <span id="services-counter">01</span>
            <span class="mx-1 text-white/20">/</span>
            <span>{String(services.length).padStart(2, "0")}</span>
          </div>
        </div>
      </div>

      <!-- Right: client testimonial (one per service) -->
      <div class="hidden lg:block relative lg:w-[480px]" style="height: 340px;">
        {experiences.map((exp, i) => (
          <div
            class="experience-slide absolute inset-0 flex flex-col justify-between border border-white/10 bg-white/[0.03] backdrop-blur-sm p-8 transition-all duration-600"
            data-experience-index={i}
            style={i === 0 ? "opacity: 1; transform: translateY(0);" : "opacity: 0; transform: translateY(40px); pointer-events: none;"}
          >
            <!-- Top: stars + quote -->
            <div>
              <div class="flex gap-1">
                {[...Array(5)].map(() => (
                  <svg class="w-3.5 h-3.5 text-gold-light" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="mt-6 text-base leading-[1.7] text-white/85 italic"
                style="font-family: 'Raleway', sans-serif; font-weight: 300;">
                &ldquo;{exp.quote}&rdquo;
              </p>
            </div>

            <!-- Bottom: author + location -->
            <div class="mt-6 pt-6 border-t border-white/10">
              <p class="text-sm font-medium tracking-wide text-white/90">{exp.author}</p>
              <p class="mt-1 text-[10px] tracking-[0.2em] uppercase text-white/40">{exp.location}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>

<script>
  const section = document.getElementById("services");
  if (section) {
    const slides = section.querySelectorAll<HTMLElement>(".service-slide");
    const bars = section.querySelectorAll<HTMLElement>(".service-bar");
    const indicators = section.querySelectorAll<HTMLElement>(".service-indicator");
    const experienceSlides = section.querySelectorAll<HTMLElement>(".experience-slide");
    const prevBtn = document.getElementById("services-prev");
    const nextBtn = document.getElementById("services-next");
    const counter = document.getElementById("services-counter");
    const total = slides.length;
    let currentIndex = 0;

    function show(index: number) {
      const next = ((index % total) + total) % total; // wrap-around
      const direction = next > currentIndex ? 1 : -1;

      slides.forEach((slide, i) => {
        if (i === next) {
          slide.style.opacity = "1";
          slide.style.transform = "translateY(0)";
          slide.style.pointerEvents = "auto";
        } else {
          slide.style.opacity = "0";
          slide.style.transform =
            i < next ? "translateY(-30px)" : "translateY(30px)";
          slide.style.pointerEvents = "none";
        }
      });

      bars.forEach((bar, i) => {
        bar.style.transform = i <= next ? "scaleX(1)" : "scaleX(0)";
      });

      experienceSlides.forEach((slide, i) => {
        if (i === next) {
          slide.style.opacity = "1";
          slide.style.transform = "translateY(0)";
          slide.style.pointerEvents = "auto";
        } else {
          slide.style.opacity = "0";
          slide.style.transform =
            i < next ? "translateY(-40px)" : "translateY(40px)";
          slide.style.pointerEvents = "none";
        }
      });

      if (counter) counter.textContent = String(next + 1).padStart(2, "0");

      currentIndex = next;
      // direction is currently unused but available for future swipe / direction-based animations
      void direction;
    }

    prevBtn?.addEventListener("click", () => show(currentIndex - 1));
    nextBtn?.addEventListener("click", () => show(currentIndex + 1));

    indicators.forEach((indicator) => {
      const target = parseInt(indicator.dataset.barIndex || "0", 10);
      indicator.addEventListener("click", () => show(target));
    });
  }
</script>
