---
import { Image } from "astro:assets";
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import Container from "../../components/ui/Container.astro";
import heroImg from "../../assets/pano3.jpeg";
import portraitImg from "../../assets/build-yacht.png";

const WHATSAPP_HREF =
  "https://wa.me/34971000000?text=Hi%2C%20I%27d%20like%20to%20explore%20commissioning%20a%20new-build%20yacht%20with%20Sinclair.";

const principles = [
  { label: "Vision", text: "Your brief — translated by naval architects and designers into a coherent platform." },
  { label: "Yards", text: "Direct relationships with the world's leading shipyards across Europe and beyond." },
  { label: "Oversight", text: "An owner's representative on the ground from contract to commissioning." },
  { label: "Aftercare", text: "Sea trials, crew, flag, classification and warranty — handled in one continuum." },
];

const services = [
  {
    n: "01",
    title: "Project Management",
    text: "We act as your owner's representative from concept through commissioning — protecting budget, schedule and specification at every milestone. Independent surveyors and yard meetings are coordinated so you receive a single, candid line of reporting.",
  },
  {
    n: "02",
    title: "Shipyard & Designer Selection",
    text: "Selecting the right yard is the most consequential decision of any build. We match your brief to the yards and studios best suited to deliver it, drawing on long-standing relationships and an unfiltered view of current order books.",
  },
  {
    n: "03",
    title: "Delivery & Ongoing Support",
    text: "Beyond launch, we coordinate sea trials, flag and classification, crew placement, insurance and warranty management — ensuring the transition from new-build to operational yacht is seamless from day one.",
  },
];
---

<BaseLayout
  title="Build a Yacht — Sinclair Yachting"
  description="Commission a new-build yacht with Sinclair Yachting. Owner's representation across project management, shipyard selection, delivery and aftercare."
>
  <Navbar />

  <!-- Hero -->
  <section class="relative h-[70vh] min-h-[520px] w-full overflow-hidden bg-charcoal">
    <Image
      src={heroImg}
      alt="Yacht under construction at sea"
      class="absolute inset-0 h-full w-full object-cover"
      widths={[1280, 1920]}
      sizes="100vw"
      loading="eager"
    />
    <div class="absolute inset-0 bg-black/75"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/30 to-black/40"></div>

    <div class="absolute bottom-0 left-0 right-0 z-10 px-6 pb-16 sm:px-8 lg:px-12">
      <div class="mx-auto max-w-[1440px]">
        <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold-light/80">
          New Construction
        </p>
        <h1
          class="mt-4 text-4xl leading-[1.1] tracking-[0.08em] uppercase text-white sm:text-5xl lg:text-6xl xl:text-7xl"
          style="font-family: 'Raleway', sans-serif; font-weight: 300;"
        >
          Build Your<br />
          Dream Yacht
        </h1>
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-white/80 sm:text-base">
          From the first sketch to her maiden voyage — Sinclair represents owners commissioning new-build
          yachts with the world's leading shipyards and design studios.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/#contact"
            class="btn-fill-light inline-flex items-center gap-3 border border-white/40 px-7 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-white"
          >
            Start a project
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href={WHATSAPP_HREF}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-2 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-white/80 transition-colors duration-300 hover:text-white"
          >
            Or message on WhatsApp
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro / principles -->
  <section class="bg-white py-24 lg:py-32">
    <Container>
      <div class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,480px)] lg:gap-20">
        <!-- Left: intro copy -->
        <div>
          <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">
            From Concept to Commissioning
          </p>
          <h2
            class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;"
          >
            One Brief.<br />
            One Yacht. Yours.
          </h2>
          <div class="mt-6 h-px w-10 bg-gold/40"></div>
          <p class="mt-8 max-w-xl text-base leading-[1.8] text-taupe">
            A new-build is among the most personal decisions an owner will make — and the most exposed
            to risk if undertaken alone. Sinclair represents you, not the yard. Every meeting, every
            milestone, every line of the contract is read with your interests in front.
          </p>

          <!-- Principles -->
          <div class="mt-12 grid grid-cols-2 gap-y-8 gap-x-8">
            {principles.map((p) => (
              <div>
                <p
                  class="text-xl font-light tracking-[0.25em] uppercase text-charcoal sm:text-2xl"
                  style="font-family: 'Raleway', sans-serif; font-weight: 300;"
                >
                  {p.label}
                </p>
                <p class="mt-2 text-sm leading-[1.7] text-taupe">{p.text}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: portrait image -->
        <div class="relative hidden lg:block">
          <div class="relative aspect-[4/5] w-full overflow-hidden">
            <Image
              src={portraitImg}
              alt="Yacht detail"
              class="absolute inset-0 h-full w-full object-cover"
              widths={[600, 900, 1200]}
              sizes="(min-width: 1024px) 480px, 100vw"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Services -->
  <section class="bg-cream/40 py-24 lg:py-32">
    <Container>
      <div class="max-w-3xl">
        <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">What We Do</p>
        <h2
          class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
          style="font-family: 'Raleway', sans-serif; font-weight: 300;"
        >
          Owner's Representation,<br />
          End to End
        </h2>
        <div class="mt-6 h-px w-10 bg-gold/40"></div>
      </div>

      <div class="mt-16 grid gap-10 lg:grid-cols-3">
        {services.map((s) => (
          <article class="flex flex-col border-t border-charcoal/15 pt-8">
            <p class="num text-[11px] font-medium tracking-[0.25em] text-gold">{s.n}</p>
            <h3
              class="mt-4 text-2xl font-light tracking-[0.15em] uppercase text-charcoal"
              style="font-family: 'Raleway', sans-serif; font-weight: 300;"
            >
              {s.title}
            </h3>
            <p class="mt-6 text-sm leading-[1.8] text-taupe">{s.text}</p>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <!-- Closing CTA -->
  <section class="bg-white py-24 lg:py-32 text-center">
    <Container>
      <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">The Next Step</p>
      <h2
        class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
        style="font-family: 'Raleway', sans-serif; font-weight: 300;"
      >
        Begin a Private Briefing
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-taupe">
        We'll listen first — your use case, cruising grounds, family, design instincts — and return with
        an honest view of yards, timelines and budgets. Initial conversations are confidential and
        carry no obligation.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/#contact"
          class="btn-fill inline-flex items-center gap-3 border border-charcoal/20 px-8 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-charcoal"
        >
          Request a briefing
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href={WHATSAPP_HREF}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-2 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-taupe transition-colors duration-300 hover:text-charcoal"
        >
          Chat on WhatsApp
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </a>
      </div>
    </Container>
  </section>

  <Footer />
</BaseLayout>
