---
import type { Region } from "../../data/types/destination";
import RegionTile from "./RegionTile.astro";

interface Props {
  regions: Region[];
}

const { regions } = Astro.props;
---

<section class="bg-warm-white pt-10 pb-12 sm:pt-10 sm:pb-12 lg:pt-16 lg:pb-16">
  <div class="mx-auto w-full px-8 sm:px-12 lg:px-16">
    <ul
      data-dest-grid
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-1"
    >
      {regions.map((region, index) => (
        <RegionTile region={region} index={index} />
      ))}
    </ul>

    <p
      data-dest-empty
      class="hidden mt-16 text-center text-sm font-light tracking-wide text-taupe"
      style="font-family: 'Raleway', sans-serif;"
    >
      No destinations match your search. Try a different region or country.
    </p>
  </div>
</section>
