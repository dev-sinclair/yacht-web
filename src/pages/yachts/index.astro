---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Container from "../../components/ui/Container.astro";
import YachtCardSkeleton from "../../components/catalogue/YachtCardSkeleton.astro";
import YachtFilters from "../../components/catalogue/YachtFilters.astro";
import Footer from "../../components/layout/Footer.astro";
import type { YachtFacets } from "../../data/types/yacht";
import { regionBySlug } from "../../lib/destinations/registry";
import { locationBySlug } from "../../lib/destinations/location-yachts";
import { getAllYachts, getFacets, isYachtCategory, isYachtSeason, formatSeason } from "../../data/yacht-service";

// No data fetched in the frontmatter — page renders shell + skeleton instantly.
// Real data is loaded client-side from /api/yachts.json so the user lands on
// the page with no perceptible wait.

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);

const rawType = Astro.url.searchParams.get("yachtType") ?? "";
const activeType = isYachtCategory(rawType) ? rawType : "";

const rawRegion = Astro.url.searchParams.get("region") ?? "";
const activeRegionData = rawRegion ? regionBySlug(rawRegion) : null;
const activeRegion = activeRegionData?.slug ?? "";

const rawLocation = Astro.url.searchParams.get("location") ?? "";
const activeLocationData =
  activeRegionData && rawLocation ? locationBySlug(activeRegionData, rawLocation) : undefined;
const activeLocation = activeLocationData?.slug ?? "";

const rawSeason = Astro.url.searchParams.get("season") ?? "";
const activeSeason = isYachtSeason(rawSeason) ? rawSeason : "";
const activeSeasonLabel = activeSeason ? formatSeason(activeSeason) : "";

// Compute real facets server-side so YachtFilters can size its sliders to
// the actual catalog (chiefly the price slider's max). The snapshot index
// is memoized in src/data/snapshot.ts so this is a near-free per-request
// hit after the first one. Categories filter doesn't apply here — we want
// facet bounds for the full eligible catalog, not just the active type.
const facets: YachtFacets = getFacets(await getAllYachts());
---

<BaseLayout
  title="Yachts · Sinclair Yachting"
  description="Browse our curated fleet of luxury charter yachts available in the Mediterranean and beyond."
>
  <Navbar />

  <section class="bg-white pt-28 pb-10 lg:pt-32 lg:pb-14">
    <div class="px-4 sm:px-8 lg:px-16 xl:px-20">
      <div class="grid gap-10 lg:grid-cols-[260px_1fr] lg:gap-10">
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <!-- Mobile-only collapse toggle. lg:hidden keeps it out of the desktop sidebar. -->
          <button
            id="filters-toggle"
            type="button"
            class="lg:hidden mb-4 flex w-full items-center justify-between border border-deep/15 bg-white px-4 py-3 text-[11px] font-medium tracking-[0.25em] uppercase text-charcoal transition-colors duration-300 hover:bg-deep hover:text-white"
            aria-expanded="false"
            aria-controls="filters-panel"
          >
            <span class="flex items-center gap-2">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M6 12h12M10 18h4" />
              </svg>
              Filters
            </span>
            <svg id="filters-toggle-chevron" class="h-4 w-4 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div id="filters-panel" class="hidden lg:block lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto lg:pr-2 filters-scroll">
            <YachtFilters facets={facets} activeType={activeType} activeRegion={activeRegion} activeLocation={activeLocation} activeSeason={activeSeason} />
          </div>
        </aside>

        <div data-yachts-root data-active-type={activeType} data-active-region={activeRegion} data-active-location={activeLocation} data-active-season={activeSeason}>
          <div class="mb-8" data-reveal>
            <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">
              {activeLocationData ? "Location" : activeRegionData ? "Region" : "Hand-picked"}
            </p>
            <h2
              class="mt-3 text-2xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-3xl"
              style="font-family: 'Raleway', sans-serif; font-weight: 300;"
            >
              {activeLocationData
                ? `Yachts Cruising ${activeLocationData.name}`
                : activeRegionData
                  ? `Yachts Cruising ${activeRegionData.name}`
                  : "Featured Yachts"}
            </h2>
            {activeRegionData && (
              <p class="mt-3 max-w-2xl text-sm font-light leading-relaxed text-taupe">
                {(activeLocationData?.tagline ?? activeRegionData.tagline)}.
                <a
                  href={`/destinations/${activeRegionData.slug}`}
                  class="ml-2 inline-flex items-center gap-1 text-gold transition-colors duration-300 hover:text-gold-dim"
                >
                  Explore the region
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </p>
            )}
          </div>

          <!-- Sort bar: separate from filter sidebar. Sort is page-level state
               that composes with filters and pagination. -->
          <div class="mb-6 flex flex-wrap items-center justify-end gap-3 border-b border-deep/10 pb-4 text-[11px] font-medium tracking-[0.2em] uppercase">
            <label for="yacht-sort" class="text-taupe">Sort</label>
            <select
              id="yacht-sort"
              class="num border border-deep/20 bg-transparent px-3 py-1.5 text-[11px] tracking-[0.05em] text-charcoal transition-colors duration-300 focus:outline-none focus:border-deep cursor-pointer"
            >
              <option value="default">Default</option>
              <option value="name-asc">Name A–Z</option>
              <option value="price-asc">Price: low to high</option>
              <option value="price-desc">Price: high to low</option>
              <option value="length-desc">Length: long to short</option>
              <option value="length-asc">Length: short to long</option>
            </select>
          </div>

          <!-- Anchor for "scroll to grid top" on page change -->
          <div id="fleet-top"></div>

          <!-- Skeleton grid (replaced once /api/yachts.json resolves) -->
          <div id="fleet" class="grid gap-8 grid-cols-1 sm:grid-cols-2 xl:grid-cols-3">
            {Array.from({ length: 9 }).map(() => <YachtCardSkeleton />)}
          </div>

          <!-- Pagination (populated client-side; hidden until data loads) -->
          <nav
            id="pagination"
            class="mt-10 flex items-center justify-center gap-6 text-[11px] font-medium tracking-[0.2em] uppercase text-charcoal"
            hidden
            aria-label="Yacht catalogue pagination"
          >
            <button
              id="page-prev"
              type="button"
              class="inline-flex items-center gap-2 border border-deep/20 px-5 py-2.5 transition-colors duration-300 hover:bg-deep hover:text-white disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-charcoal disabled:cursor-not-allowed"
            >
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M15 18l-6-6 6-6" />
              </svg>
              Prev
            </button>
            <span class="inline-flex items-center gap-2 text-taupe">
              <span>Page</span>
              <select
                id="page-select"
                class="num border border-deep/20 bg-transparent px-2 py-1 text-[11px] tracking-[0.05em] text-charcoal transition-colors duration-300 focus:outline-none focus:border-deep cursor-pointer"
                aria-label="Jump to page"
              >
                <option value="1">1</option>
              </select>
              <span>of <span id="page-total" class="num">1</span></span>
            </span>
            <button
              id="page-next"
              type="button"
              class="inline-flex items-center gap-2 border border-deep/20 px-5 py-2.5 transition-colors duration-300 hover:bg-deep hover:text-white disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-charcoal disabled:cursor-not-allowed"
            >
              Next
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
          </nav>

          <p id="yachts-error" class="mt-10 hidden text-sm text-taupe">
            Couldn't load the fleet right now. Please refresh in a moment.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream/40 py-20 text-center">
    <Container>
      <h2
        class="text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
        style="font-family: 'Raleway', sans-serif; font-weight: 300;"
        data-reveal
      >
        Looking for something specific?
      </h2>
      <p class="mt-3 text-taupe" data-reveal>
        Our brokers have access to yachts not listed publicly. Get in touch for a confidential consultation.
      </p>
      <div class="mt-8" data-reveal>
        <a
          href="https://wa.me/34971000000?text=Hi%2C%20I%27m%20looking%20for%20a%20specific%20yacht.%20Can%20you%20help%3F"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-fill inline-flex items-center gap-3 border border-deep/20 px-8 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-charcoal"
        >
          Chat on WhatsApp
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </a>
      </div>
    </Container>
  </section>

  <!-- Mobile FAB: appears once the fleet grid has scrolled past the top so
       the user can jump back to filters/sort without scrolling all the way up.
       lg:hidden keeps it off the desktop layout (sticky sidebar covers it). -->
  <button
    id="filters-fab"
    type="button"
    aria-label="Show filters and sort"
    aria-controls="filters-panel"
    class="lg:hidden fixed bottom-6 right-6 z-40 inline-flex items-center gap-2 border border-white/10 bg-deep px-4 py-3 text-[11px] font-medium tracking-[0.2em] uppercase text-white shadow-lg opacity-0 translate-y-2 pointer-events-none transition-all duration-300"
  >
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M6 12h12M10 18h4" />
    </svg>
    Filters
  </button>

  <Footer />
</BaseLayout>

<style>
  .yacht-card {
    content-visibility: auto;
    contain-intrinsic-size: 0 440px;
  }

  /* Sticky filter column: internal scroll when content exceeds viewport
     (the sidebar is taller than 100vh−96px on dense filter pages). Thin,
     near-invisible scrollbar to stay editorial. */
  .filters-scroll { scrollbar-width: thin; scrollbar-color: rgba(0,0,0,0.18) transparent; }
  .filters-scroll::-webkit-scrollbar { width: 6px; }
  .filters-scroll::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.18); border-radius: 9999px; }
  .filters-scroll::-webkit-scrollbar-track { background: transparent; }
</style>

<script>
  import type { YachtCard, YachtFacets } from "../../data/types/yacht";
  import { convertCents } from "../../lib/currency";

  interface YachtsResponse {
    items: YachtCard[];
    facets: YachtFacets;
  }

  type SortMode =
    | "default"
    | "name-asc"
    | "price-asc"
    | "price-desc"
    | "length-asc"
    | "length-desc";

  const SORT_MODES: readonly SortMode[] = [
    "default", "name-asc", "price-asc", "price-desc", "length-asc", "length-desc",
  ] as const;

  function isSortMode(s: string): s is SortMode {
    return (SORT_MODES as readonly string[]).includes(s);
  }

  /** Filter state emitted by YachtFilters via the `yachts:filterchange` event. */
  interface FilterState {
    search: string;
    length: { min: number; max: number; active: boolean };
    guests: { min: number; max: number; active: boolean };
    /** Price values are in EUR (not cents) to match slider units. */
    price: { min: number; max: number; active: boolean };
  }

  const PAGE_SIZE = 36;
  const ANKOR_BASE = "https://api.ankor.io";

  function resolveImage(url: string | null | undefined, variant = "640x"): string {
    if (!url) return "";
    let resolved = url.includes("{imageVariant}") ? url.replace("{imageVariant}", variant) : url;
    if (resolved.startsWith("/")) resolved = `${ANKOR_BASE}${resolved}`;
    return resolved;
  }

  function formatPrice(cents: number | null | undefined, currency = "EUR"): string {
    if (!cents) return "On Request";
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency,
      maximumFractionDigits: 0,
    }).format(cents / 100);
  }

  function formatLength(meters: number): string {
    const feet = Math.round(meters * 3.28084);
    return `${meters.toFixed(1)}m / ${feet}'`;
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function renderCard(yacht: YachtCard): string {
    const heroUrl = resolveImage(yacht.hero, "640x");
    const heroUrlHi = resolveImage(yacht.hero, "1280x");
    // Week-only display. Day-only yachts that clear the €15k/week eligibility
    // gate are shown with their aggregated week price (day × 7). API only
    // ships eligible yachts so this branch is non-empty whenever it runs.
    const weekCents =
      yacht.weekPricingFrom != null && yacht.weekPricingFrom > 0
        ? yacht.weekPricingFrom
        : yacht.dayPricingFrom != null && yacht.dayPricingFrom > 0
          ? yacht.dayPricingFrom * 7
          : null;
    const priceMain = weekCents != null ? formatPrice(weekCents, yacht.currency) : "On Request";
    const priceUnit = weekCents != null ? "/ week" : "";
    const builder = yacht.builder || "—";
    const name = escapeHtml(yacht.name);
    const builderEsc = escapeHtml(builder);

    return `
<a
  href="/yachts/${escapeHtml(yacht.slug)}"
  class="yacht-card group flex flex-col border border-beige/60 bg-white transition-all duration-500 hover:bg-deep hover:border-deep hover:shadow-lg"
  data-yacht-type="${escapeHtml(yacht.yachtType[0] ?? "")}"
  data-yacht-name="${escapeHtml(yacht.name.toLowerCase())}"
  data-yacht-builder="${escapeHtml(builder.toLowerCase())}"
  data-yacht-length="${yacht.length}"
  data-yacht-guests="${yacht.sleeps}"
  data-yacht-price="${yacht.weekPricingFrom ?? yacht.dayPricingFrom ?? 0}"
>
  <div class="yacht-card-image aspect-[3/2] overflow-hidden bg-cream">
    ${heroUrl
      ? `<img src="${escapeHtml(heroUrl)}" srcset="${escapeHtml(heroUrl)} 640w, ${escapeHtml(heroUrlHi)} 1280w" sizes="(min-width: 1280px) 33vw, (min-width: 640px) 50vw, 100vw" alt="${name}" class="h-full w-full object-cover" loading="lazy" />`
      : `<div class="h-full w-full bg-cream"></div>`}
  </div>
  <div class="flex flex-1 flex-col">
    <div class="px-5 pt-5">
      <h3 class="marquee-on-overflow text-xl tracking-[0.1em] uppercase text-charcoal transition-colors duration-500 group-hover:text-white" style="font-family: 'Raleway', sans-serif; font-weight: 500;">
        <span class="marquee-track">
          <span class="marquee-text">${name}</span>
          <span class="marquee-text marquee-clone" aria-hidden="true">${name}</span>
        </span>
      </h3>
    </div>
    <div class="flex items-baseline justify-between gap-3 px-5 pt-1.5 pb-3">
      <span class="marquee-on-overflow min-w-0 flex-1 text-[10px] font-medium tracking-[0.15em] uppercase text-taupe-light transition-colors duration-500 group-hover:text-white/50">
        <span class="marquee-track">
          <span class="marquee-text">${builderEsc}</span>
          <span class="marquee-text marquee-clone" aria-hidden="true">${builderEsc}</span>
        </span>
      </span>
      <p class="num text-sm tracking-[0.05em] text-charcoal transition-colors duration-500 group-hover:text-white whitespace-nowrap shrink-0">
        <span
          class="cur-price"
          data-week-cents="${yacht.weekPricingFrom ?? ""}"
          data-day-cents="${yacht.dayPricingFrom ?? ""}"
          data-native="${escapeHtml(yacht.currency || "EUR")}"
          data-unit-class="text-[10px] font-light text-taupe-light transition-colors duration-500 group-hover:text-white/60"
        >${priceMain}${priceUnit ? `<span class="text-[10px] font-light text-taupe-light transition-colors duration-500 group-hover:text-white/60"> ${priceUnit}</span>` : ""}</span>
      </p>
    </div>
    <div class="mt-auto grid grid-cols-4 gap-x-4 border-t border-beige/60 px-5 py-2.5 transition-colors duration-500 group-hover:border-white/10">
      <div>
        <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light transition-colors duration-500 group-hover:text-white/40">Length</p>
        <p class="num mt-0.5 text-[11px] text-charcoal transition-colors duration-500 group-hover:text-white/80">${formatLength(yacht.length)}</p>
      </div>
      <div>
        <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light transition-colors duration-500 group-hover:text-white/40">Guests</p>
        <p class="num mt-0.5 text-[11px] text-charcoal transition-colors duration-500 group-hover:text-white/80">${yacht.sleeps || "—"}</p>
      </div>
      <div>
        <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light transition-colors duration-500 group-hover:text-white/40">Year</p>
        <p class="num mt-0.5 text-[11px] text-charcoal transition-colors duration-500 group-hover:text-white/80">${yacht.builtYear ?? "—"}</p>
      </div>
      <div>
        <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light transition-colors duration-500 group-hover:text-white/40">Cabins</p>
        <p class="num mt-0.5 text-[11px] text-charcoal transition-colors duration-500 group-hover:text-white/80">${yacht.cabins || "—"}</p>
      </div>
    </div>
  </div>
</a>`.trim();
  }

  // ---------------------------------------------------------------------------
  // State machine: filter + pagination
  //
  // Single source of truth. Mutations go through `setState` which re-renders
  // and (optionally) updates the URL. Filter changes reset the page to 1;
  // pagination preserves the active filter.
  // ---------------------------------------------------------------------------

  const EMPTY_FILTER: FilterState = {
    search: "",
    length: { min: 0, max: 0, active: false },
    guests: { min: 0, max: 0, active: false },
    price: { min: 0, max: 0, active: false },
  };

  let allYachts: YachtCard[] = [];
  let activeYachtType = "";
  let activeRegion = "";
  let activeLocation = "";
  let activeSeason = "";
  let currentPage = 1;
  let filterState: FilterState = EMPTY_FILTER;
  let sortMode: SortMode = "default";

  /**
   * EUR-equivalent price in cents for a yacht. Returns null for "On Request"
   * yachts (no week or day price set, or ≤ 0). Conversion uses the current
   * activeRates from currency.ts — which start at fallbacks and update once
   * /api/fx-rates.json resolves. We deliberately do NOT re-sort when rates
   * arrive (would shuffle cards under the user); fallback rates are within
   * a few percent of live, so initial page-1 ordering is correct.
   */
  function priceInEurCents(y: YachtCard): number | null {
    const native = y.weekPricingFrom ?? y.dayPricingFrom;
    if (native == null || native <= 0) return null;
    return convertCents(native, y.currency, "EUR");
  }

  function compareByPrice(a: YachtCard, b: YachtCard, dir: "asc" | "desc"): number {
    const ap = priceInEurCents(a);
    const bp = priceInEurCents(b);
    // "On Request" always sorts last regardless of direction.
    if (ap == null && bp == null) return 0;
    if (ap == null) return 1;
    if (bp == null) return -1;
    return dir === "asc" ? ap - bp : bp - ap;
  }

  function sortYachts(items: YachtCard[], mode: SortMode): YachtCard[] {
    if (mode === "default") return items;
    const out = items.slice();
    switch (mode) {
      case "name-asc":    out.sort((a, b) => a.name.localeCompare(b.name)); break;
      case "price-asc":   out.sort((a, b) => compareByPrice(a, b, "asc")); break;
      case "price-desc":  out.sort((a, b) => compareByPrice(a, b, "desc")); break;
      case "length-asc":  out.sort((a, b) => a.length - b.length); break;
      case "length-desc": out.sort((a, b) => b.length - a.length); break;
    }
    return out;
  }

  function matchesFilter(y: YachtCard, f: FilterState): boolean {
    const q = f.search.trim().toLowerCase();
    if (q) {
      const name = (y.name || "").toLowerCase();
      const builder = (y.builder || "").toLowerCase();
      if (!name.includes(q) && !builder.includes(q)) return false;
    }
    if (f.length.active) {
      if (y.length < f.length.min || y.length > f.length.max) return false;
    }
    if (f.guests.active) {
      if (!Number.isFinite(y.sleeps) || y.sleeps <= 0) return false;
      if (y.sleeps < f.guests.min || y.sleeps > f.guests.max) return false;
    }
    if (f.price.active) {
      // priceCents may be week or day pricing; mirror the existing fallback.
      const cents = y.weekPricingFrom ?? y.dayPricingFrom;
      if (cents == null || cents <= 0) return false;
      const eur = cents / 100;
      if (eur < f.price.min || eur > f.price.max) return false;
    }
    return true;
  }

  function buildUrl(): string {
    const params = new URLSearchParams();
    if (activeYachtType) params.set("yachtType", activeYachtType);
    if (activeRegion) params.set("region", activeRegion);
    if (activeLocation) params.set("location", activeLocation);
    if (activeSeason) params.set("season", activeSeason);
    if (sortMode !== "default") params.set("sort", sortMode);
    if (currentPage > 1) params.set("page", String(currentPage));
    const qs = params.toString();
    return qs ? `/yachts?${qs}` : "/yachts";
  }

  function syncUrl(): void {
    const next = buildUrl();
    if (location.pathname + location.search !== next) {
      history.pushState({ page: currentPage }, "", next);
    }
  }

  // Track the totalPages count we last built dropdown options for, so we
  // only rebuild the <option> list when the total changes (filter shrinks
  // or grows the result set). Avoids tearing the dropdown on every page click.
  let renderedTotalPages = 0;

  function render(): void {
    const fleet = document.getElementById("fleet");
    const pagination = document.getElementById("pagination") as HTMLElement | null;
    const select = document.getElementById("page-select") as HTMLSelectElement | null;
    const totalEl = document.getElementById("page-total");
    const prevBtn = document.getElementById("page-prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("page-next") as HTMLButtonElement | null;
    const sortSelect = document.getElementById("yacht-sort") as HTMLSelectElement | null;
    if (!fleet) return;

    // Keep the sort dropdown in sync with current state (matters on initial
    // URL-driven load + popstate; user-driven changes already match).
    if (sortSelect && sortSelect.value !== sortMode) sortSelect.value = sortMode;

    const filtered = allYachts.filter((y) => matchesFilter(y, filterState));
    const sorted = sortYachts(filtered, sortMode);
    const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    if (sorted.length === 0) {
      fleet.innerHTML = `<p class="text-sm text-taupe col-span-full">No yachts match your filters.</p>`;
      pagination?.setAttribute("hidden", "");
    } else {
      const start = (currentPage - 1) * PAGE_SIZE;
      const slice = sorted.slice(start, start + PAGE_SIZE);
      fleet.innerHTML = slice.map(renderCard).join("");
      if (totalPages > 1) {
        pagination?.removeAttribute("hidden");
        if (select && totalPages !== renderedTotalPages) {
          // Build options 1..totalPages once (or whenever total changes).
          const opts = [];
          for (let p = 1; p <= totalPages; p++) opts.push(`<option value="${p}">${p}</option>`);
          select.innerHTML = opts.join("");
          renderedTotalPages = totalPages;
        }
        if (select) select.value = String(currentPage);
        if (totalEl) totalEl.textContent = String(totalPages);
        if (prevBtn) prevBtn.disabled = currentPage <= 1;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
      } else {
        // Single-page result set — no need to show paginator.
        pagination?.setAttribute("hidden", "");
      }
    }

    window.dispatchEvent(new CustomEvent("yachts:rendered"));
  }

  function setPage(page: number, opts: { scroll?: boolean; pushUrl?: boolean } = {}): void {
    currentPage = page;
    render();
    if (opts.pushUrl !== false) syncUrl();
    if (opts.scroll) {
      const top = document.getElementById("fleet-top");
      top?.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  }

  function setFilter(next: FilterState): void {
    filterState = next;
    currentPage = 1; // Any filter change snaps back to page 1.
    render();
    syncUrl();
  }

  function setSort(next: SortMode, opts: { pushUrl?: boolean } = {}): void {
    sortMode = next;
    currentPage = 1; // Sort change snaps back to page 1 (same as filter change).
    render();
    if (opts.pushUrl !== false) syncUrl();
  }

  /** Read sort + page from current URL. Used on initial load and popstate. */
  function readUrlState(): { sort: SortMode; page: number } {
    const params = new URL(location.href).searchParams;
    const sortParam = params.get("sort") ?? "default";
    const sort: SortMode = isSortMode(sortParam) ? sortParam : "default";
    const pageRaw = parseInt(params.get("page") ?? "1", 10);
    const page = Number.isFinite(pageRaw) && pageRaw > 0 ? pageRaw : 1;
    return { sort, page };
  }

  async function load(): Promise<void> {
    const root = document.querySelector<HTMLElement>("[data-yachts-root]");
    if (!root) return;
    activeYachtType = root.dataset.activeType ?? "";
    activeRegion = root.dataset.activeRegion ?? "";
    activeLocation = root.dataset.activeLocation ?? "";
    activeSeason = root.dataset.activeSeason ?? "";
    const params = new URLSearchParams();
    if (activeYachtType) params.set("yachtType", activeYachtType);
    if (activeRegion) params.set("region", activeRegion);
    if (activeLocation) params.set("location", activeLocation);
    if (activeSeason) params.set("season", activeSeason);
    const qs = params.toString();
    const url = qs ? `/api/yachts.json?${qs}` : "/api/yachts.json";

    // Read initial page + sort from URL so /yachts?sort=price-asc&page=3 works.
    const initial = readUrlState();
    sortMode = initial.sort;
    currentPage = initial.page;

    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error(`status ${res.status}`);
      const data = (await res.json()) as YachtsResponse;
      allYachts = data.items;
      render();
      window.dispatchEvent(new CustomEvent("yachts:loaded"));
    } catch (err) {
      console.error("[yachts] load failed:", err);
      const errMsg = document.getElementById("yachts-error");
      const fleet = document.getElementById("fleet");
      if (fleet) fleet.innerHTML = "";
      errMsg?.classList.remove("hidden");
    }
  }

  function wirePagination(): void {
    const prev = document.getElementById("page-prev");
    const next = document.getElementById("page-next");
    const select = document.getElementById("page-select") as HTMLSelectElement | null;

    prev?.addEventListener("click", () => setPage(currentPage - 1, { scroll: true }));
    next?.addEventListener("click", () => setPage(currentPage + 1, { scroll: true }));
    select?.addEventListener("change", () => {
      const v = parseInt(select.value, 10);
      if (Number.isFinite(v) && v >= 1) setPage(v, { scroll: true });
    });

    // Browser back/forward: re-read URL, restore both sort + page (don't push
    // back to history — would create a loop with the navigation we're handling).
    window.addEventListener("popstate", () => {
      const { sort, page } = readUrlState();
      sortMode = sort;
      setPage(page, { pushUrl: false });
    });
  }

  function wireSort(): void {
    const sortSelect = document.getElementById("yacht-sort") as HTMLSelectElement | null;
    sortSelect?.addEventListener("change", () => {
      const v = sortSelect.value;
      if (isSortMode(v)) setSort(v);
    });
  }

  function wireFilters(): void {
    window.addEventListener("yachts:filterchange", (e) => {
      const detail = (e as CustomEvent<FilterState>).detail;
      if (!detail) return;
      setFilter(detail);
    });
  }

  // Detect overflowing text on any .marquee-on-overflow element and toggle .is-marquee.
  function checkMarquees(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>(".marquee-on-overflow").forEach((wrap) => {
      const original = wrap.querySelector<HTMLElement>(".marquee-text:not(.marquee-clone)");
      if (!original) return;
      const wrapW = wrap.clientWidth;
      const textW = original.getBoundingClientRect().width;
      if (wrapW === 0 || textW === 0) return;
      const overflow = textW > wrapW + 1;
      wrap.classList.toggle("is-marquee", overflow);
    });
  }

  function observeNewCards() {
    if (!("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          checkMarquees(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      }
    }, { rootMargin: "200px" });
    document.querySelectorAll<HTMLElement>(".yacht-card").forEach((c) => io.observe(c));
  }

  wirePagination();
  wireSort();
  wireFilters();
  load();

  // `yachts:rendered` fires after every state-driven re-render (initial load,
  // filter change, or page change). Re-run marquee detection + reveal on the
  // freshly inserted cards each time.
  window.addEventListener("yachts:rendered", () => {
    requestAnimationFrame(() => {
      checkMarquees();
      observeNewCards();
      document.querySelectorAll<HTMLElement>(".yacht-card").forEach((el) => {
        el.classList.add("revealed");
      });
    });
  });

  window.addEventListener("resize", () => requestAnimationFrame(() => checkMarquees()));
</script>

<script>
  // Mobile filter panel toggle. At lg+ the panel is always visible via
  // tailwind `lg:block`; this script only matters below the lg breakpoint.
  const toggleBtn = document.getElementById("filters-toggle");
  const panel = document.getElementById("filters-panel");
  const chevron = document.getElementById("filters-toggle-chevron");
  if (toggleBtn && panel) {
    toggleBtn.addEventListener("click", () => {
      const open = panel.classList.toggle("hidden") === false;
      toggleBtn.setAttribute("aria-expanded", String(open));
      if (chevron) chevron.style.transform = open ? "rotate(180deg)" : "";
    });
  }

  // Mobile floating "Filters" button: shown once the fleet grid has scrolled
  // above the viewport top. Clicking it scrolls back to the filter toggle and
  // expands the panel if it's collapsed.
  const fab = document.getElementById("filters-fab");
  const fleetTop = document.getElementById("fleet-top");
  if (fab && fleetTop) {
    const setVisible = (visible: boolean) => {
      fab.classList.toggle("opacity-0", !visible);
      fab.classList.toggle("translate-y-2", !visible);
      fab.classList.toggle("pointer-events-none", !visible);
    };
    let ticking = false;
    const update = () => {
      const past = fleetTop.getBoundingClientRect().top < 0;
      setVisible(past);
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );

    fab.addEventListener("click", () => {
      // Auto-expand the collapsed filter panel so the user lands on visible content.
      if (toggleBtn && panel && panel.classList.contains("hidden")) {
        toggleBtn.click();
      }
      const aside = toggleBtn?.closest("aside");
      const targetY =
        (aside?.getBoundingClientRect().top ?? 0) + window.scrollY - 80; // navbar offset
      window.scrollTo({ top: Math.max(targetY, 0), behavior: "smooth" });
    });
  }
</script>
