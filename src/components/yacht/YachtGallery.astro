---
import type { YachtImage } from "../../data/types/yacht";

interface Props {
  images: YachtImage[];
  yachtName: string;
}

const { images, yachtName } = Astro.props;
// Skip first image (used in hero)
const galleryImages = images.slice(1);
---

{galleryImages.length > 0 && (
  <section class="bg-white py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div data-reveal>
        <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">Gallery</p>
        <h2 class="mt-3 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl"
          style="font-family: 'Raleway', sans-serif; font-weight: 300;">
          {yachtName}
        </h2>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {galleryImages.map((img) => (
          <div class="aspect-[4/3] overflow-hidden bg-cream">
            <img
              src={img.url}
              alt={img.alt}
              class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
              loading="lazy"
              width="400"
              height="300"
            />
          </div>
        ))}
      </div>
    </div>
  </section>
)}
