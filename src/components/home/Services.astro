---
import Container from "../ui/Container.astro";
import services from "../../data/services.json";
---

<section id="services" class="relative overflow-hidden bg-warm-white pb-24 lg:pb-32 lg:pt-12">
  <Container>
    <!-- Header -->
    <div class="max-w-2xl" data-reveal>
      <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">
        What We Offer
      </p>
      <h2
        class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
        style="font-family: 'Raleway', sans-serif; font-weight: 300;"
      >
        Our Services
      </h2>
      <div class="mt-6 h-px w-10 bg-gold/40"></div>
      <p class="mt-8 text-base leading-[1.8] text-taupe">
        Four disciplines, one quiet standard. Every engagement is handled by a single broker. Personally, and from end to end.
      </p>
    </div>

    <!-- Services list -->
    <ul class="mt-16 lg:mt-20 border-t border-deep/10" data-reveal>
      {services.map((service, i) => (
        <li class="group border-b border-deep/10 transition-colors duration-500 hover:bg-cream/40">
          <div class="grid grid-cols-12 items-baseline gap-6 px-1 py-8 sm:py-10 lg:gap-10 lg:py-12">
            <!-- Number -->
            <div class="col-span-12 sm:col-span-2 lg:col-span-1">
              <span
                class="num text-[11px] font-light tracking-[0.3em] text-gold"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>

            <!-- Title -->
            <div class="col-span-12 sm:col-span-5 lg:col-span-5">
              <h3
                class="text-2xl font-light tracking-[0.12em] uppercase text-charcoal transition-colors duration-500 group-hover:text-gold-dim sm:text-3xl lg:text-[2rem]"
                style="font-family: 'Raleway', sans-serif; font-weight: 300;"
              >
                {service.title}
              </h3>
            </div>

            <!-- Description -->
            <div class="col-span-12 sm:col-span-5 lg:col-span-6">
              <p class="max-w-xl text-sm leading-[1.85] text-taupe sm:text-base">
                {service.description}
              </p>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <!-- CTA -->
    <div class="mt-14 flex justify-center lg:mt-20" data-reveal>
      <a
        href="/yachts"
        class="btn-fill inline-flex items-center gap-4 border border-deep/20 px-12 py-5 text-[12px] font-medium tracking-[0.3em] uppercase text-charcoal"
      >
        View Available Yachts
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </Container>
</section>
