---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Hero from "../components/home/Hero.astro";
import About from "../components/home/About.astro";
import Services from "../components/home/Services.astro";
import YachtCatalogue from "../components/home/YachtCatalogue.astro";
import Itineraries from "../components/home/Itineraries.astro";
import Experiences from "../components/home/Experiences.astro";
import Contact from "../components/home/Contact.astro";
import Footer from "../components/layout/Footer.astro";
---

<BaseLayout>
  <Navbar transparent />
  <main>
    <!-- Hero scrolls normally upward. -->
    <div id="hero-wrap" class="relative z-[5]">
      <Hero />
    </div>
    <!-- About is pulled up beneath the Hero via a JS translate during the
         first 100vh of scroll, so the Hero appears to slide up and uncover it. -->
    <div id="about-wrap" class="relative z-[1] will-change-transform">
      <About />
    </div>
    <Services />
    <!-- YachtCatalogue slides up over Itineraries for the uncover effect. -->
    <div id="catalogue-wrap" class="relative z-[5]">
      <YachtCatalogue />
    </div>
    <div id="itineraries-wrap" class="relative z-[1] will-change-transform">
      <Itineraries />
    </div>
    <Experiences />
    <Contact />
  </main>
  <Footer />
</BaseLayout>

<script>
  // Generic "uncover" reveal: pin `target` at viewport top during the last 100vh
  // of the previous section's scroll, so the previous section appears to slide
  // upward and uncover `target` beneath it.
  function setupReveal(targetId: string) {
    const el = document.getElementById(targetId);
    if (!el) return;
    let anchor = 0;
    let ticking = false;

    const measure = () => {
      el.style.transform = "none";
      anchor = el.getBoundingClientRect().top + window.scrollY;
      update();
    };

    const update = () => {
      const h = window.innerHeight;
      const delta = window.scrollY - anchor;
      const translate = Math.max(-h, Math.min(0, delta));
      el.style.transform = `translate3d(0, ${translate}px, 0)`;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    };

    measure();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", measure, { passive: true });
  }

  setupReveal("about-wrap");
  setupReveal("itineraries-wrap");
</script>
