---
import Container from "../ui/Container.astro";
---

<section id="contact" class="bg-cream/40 py-24 lg:py-32 overflow-hidden">
  <Container>
    <!-- Header -->
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">
        Get in Touch
      </p>
      <h2
        class="mt-4 text-4xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-5xl lg:text-6xl"
        style="font-family: 'Raleway', sans-serif; font-weight: 300;"
      >
        Begin Your Journey
      </h2>
    </div>

    <!-- Contact card -->
    <div class="mx-auto mt-14 max-w-2xl" data-reveal>
      <div
        id="contact-card"
        class="relative border border-deep/10 bg-white p-8 shadow-sm sm:p-12 lg:p-14"
      >
        <!-- Stage: animates height between the two views so the card grows /
             shrinks smoothly instead of snapping. -->
        <div id="contact-stage" class="relative overflow-hidden">
        <!-- View 1: Channel picker -->
        <div
          id="contact-picker"
          class="contact-view"
          style="opacity: 1; transform: translateY(0);"
        >
          <p class="text-center text-[10px] font-medium tracking-[0.3em] uppercase text-taupe-light">
            How would you like to reach us?
          </p>
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            <button
              type="button"
              data-channel-pick="whatsapp"
              class="contact-channel group flex flex-col items-start gap-4 border border-deep/15 p-6 text-left transition-all duration-300 hover:cursor-pointer hover:border-deep hover:bg-deep"
            >
              <svg
                class="h-7 w-7 text-charcoal transition-colors duration-300 group-hover:text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
              </svg>
              <span class="block">
                <span
                  class="block text-sm font-medium tracking-[0.2em] uppercase text-charcoal transition-colors duration-300 group-hover:text-white"
                  style="font-family: 'Raleway', sans-serif;"
                >WhatsApp</span>
                <span class="mt-2 block text-[11px] font-light leading-relaxed text-taupe transition-colors duration-300 group-hover:text-white/60">
                  Quick &amp; informal. Fastest response
                </span>
              </span>
            </button>

            <button
              type="button"
              data-channel-pick="email"
              class="contact-channel group flex flex-col items-start gap-4 border border-deep/15 p-6 text-left transition-all duration-300 hover:cursor-pointer hover:border-deep hover:bg-deep"
            >
              <svg
                class="h-7 w-7 text-charcoal transition-colors duration-300 group-hover:text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 8.5l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="block">
                <span
                  class="block text-sm font-medium tracking-[0.2em] uppercase text-charcoal transition-colors duration-300 group-hover:text-white"
                  style="font-family: 'Raleway', sans-serif;"
                >Email</span>
                <span class="mt-2 block text-[11px] font-light leading-relaxed text-taupe transition-colors duration-300 group-hover:text-white/60">
                  A formal inquiry, on your time
                </span>
              </span>
            </button>
          </div>
        </div>

        <!-- View 2: Multi-step form -->
        <div
          id="contact-form-view"
          class="contact-view"
          style="display: none; opacity: 0; transform: translateY(24px); pointer-events: none;"
        >
          <!-- Top bar: Back + channel + step count -->
          <div class="flex items-center justify-between text-[10px] font-medium tracking-[0.25em] uppercase">
            <button
              id="contact-back"
              type="button"
              class="inline-flex items-center gap-2 text-taupe transition-colors duration-300 hover:cursor-pointer hover:text-charcoal"
            >
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
              Back
            </button>
            <span class="flex items-center gap-2 text-taupe">
              <span id="contact-channel-label" class="text-charcoal"></span>
              <span class="text-taupe-light">·</span>
              <span class="num">
                <span id="contact-step-num">1</span>
                <span class="text-taupe-light"> / </span>
                <span id="contact-step-total">3</span>
              </span>
            </span>
          </div>

          <!-- Steps -->
          <div id="contact-steps" class="relative mt-10 sm:mt-12" style="min-height: 220px;">
            <!-- Step 1: Name -->
            <div
              data-step="1"
              class="contact-step absolute inset-0 transition-all duration-500"
              style="opacity: 1; transform: translateY(0); pointer-events: auto;"
            >
              <p class="text-[10px] font-medium tracking-[0.3em] uppercase text-gold">01</p>
              <label
                for="contact-input-1"
                class="mt-3 block text-2xl font-light leading-snug text-charcoal sm:text-3xl"
                style="font-family: 'Raleway', sans-serif; font-weight: 300;"
              >
                What's your name?
              </label>
              <input
                id="contact-input-1"
                type="text"
                placeholder="Type your answer here…"
                autocomplete="name"
                maxlength="80"
                spellcheck="false"
                aria-describedby="contact-counter-1 contact-error-1"
                data-step-input
                class="mt-6 w-full border-b border-deep/20 bg-transparent py-3 text-lg text-charcoal placeholder:text-taupe-light/50 focus:border-gold focus:outline-none transition-colors duration-300"
              />
              <div class="mt-2 flex items-center justify-between text-[10px] tracking-[0.15em] uppercase">
                <span id="contact-error-1" class="text-rose-700/80" aria-live="polite"></span>
                <span id="contact-counter-1" class="num text-taupe-light/70">0 / 80</span>
              </div>
              <div class="mt-6 flex items-center gap-4">
                <button
                  type="button"
                  data-step-next
                  disabled
                  class="inline-flex items-center gap-2 bg-deep px-5 py-3 text-[11px] font-medium tracking-[0.2em] uppercase text-white transition-colors duration-300 hover:cursor-pointer hover:bg-gold disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-deep"
                >
                  OK
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </button>
                <span class="text-[10px] tracking-[0.2em] uppercase text-taupe-light">
                  press <kbd class="border border-deep/15 px-1.5 py-0.5 text-[9px]">Enter</kbd>
                </span>
              </div>
            </div>

            <!-- Step 2: Contact info -->
            <div
              data-step="2"
              class="contact-step absolute inset-0 transition-all duration-500"
              style="opacity: 0; transform: translateY(24px); pointer-events: none;"
            >
              <p class="text-[10px] font-medium tracking-[0.3em] uppercase text-gold">02</p>
              <label
                for="contact-input-2"
                class="mt-3 block text-2xl font-light leading-snug text-charcoal sm:text-3xl"
                style="font-family: 'Raleway', sans-serif; font-weight: 300;"
              >
                What's your <span data-contact-mode-label>email</span>?
              </label>
              <input
                id="contact-input-2"
                type="email"
                placeholder="you@example.com"
                autocomplete="email"
                maxlength="254"
                spellcheck="false"
                aria-describedby="contact-counter-2 contact-error-2"
                data-step-input
                class="mt-6 w-full border-b border-deep/20 bg-transparent py-3 text-lg text-charcoal placeholder:text-taupe-light/50 focus:border-gold focus:outline-none transition-colors duration-300"
              />
              <div class="mt-2 flex items-center justify-between text-[10px] tracking-[0.15em] uppercase">
                <span id="contact-error-2" class="text-rose-700/80" aria-live="polite"></span>
                <span id="contact-counter-2" class="num text-taupe-light/70">0 / 254</span>
              </div>
              <div class="mt-6 flex items-center gap-4">
                <button
                  type="button"
                  data-step-next
                  disabled
                  class="inline-flex items-center gap-2 bg-deep px-5 py-3 text-[11px] font-medium tracking-[0.2em] uppercase text-white transition-colors duration-300 hover:cursor-pointer hover:bg-gold disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-deep"
                >
                  OK
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </button>
                <span class="text-[10px] tracking-[0.2em] uppercase text-taupe-light">
                  press <kbd class="border border-deep/15 px-1.5 py-0.5 text-[9px]">Enter</kbd>
                </span>
              </div>
            </div>

            <!-- Step 3: Message -->
            <div
              data-step="3"
              class="contact-step absolute inset-0 transition-all duration-500"
              style="opacity: 0; transform: translateY(24px); pointer-events: none;"
            >
              <p class="text-[10px] font-medium tracking-[0.3em] uppercase text-gold">03</p>
              <label
                for="contact-input-3"
                class="mt-3 block text-2xl font-light leading-snug text-charcoal sm:text-3xl"
                style="font-family: 'Raleway', sans-serif; font-weight: 300;"
              >
                Tell us about your inquiry
              </label>
              <textarea
                id="contact-input-3"
                rows="3"
                placeholder="Yacht, dates, region, anything we should know…"
                maxlength="2000"
                aria-describedby="contact-counter-3 contact-error-3"
                data-step-input
                class="mt-6 w-full resize-none border-b border-deep/20 bg-transparent py-3 text-lg text-charcoal placeholder:text-taupe-light/50 focus:border-gold focus:outline-none transition-colors duration-300"
              ></textarea>
              <div class="mt-2 flex items-center justify-between text-[10px] tracking-[0.15em] uppercase">
                <span id="contact-error-3" class="text-rose-700/80" aria-live="polite"></span>
                <span id="contact-counter-3" class="num text-taupe-light/70">0 / 2000</span>
              </div>
              <div class="mt-6 flex items-center gap-4">
                <button
                  type="button"
                  data-step-next
                  data-step-submit
                  disabled
                  class="inline-flex items-center gap-2 bg-gold px-6 py-3 text-[11px] font-medium tracking-[0.2em] uppercase text-white transition-colors duration-300 hover:cursor-pointer hover:bg-gold-dim disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-gold"
                >
                  Send
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </button>
                <span class="text-[10px] tracking-[0.2em] uppercase text-taupe-light">
                  <kbd class="border border-deep/15 px-1.5 py-0.5 text-[9px]">Shift</kbd>
                  + <kbd class="border border-deep/15 px-1.5 py-0.5 text-[9px]">Enter</kbd>
                  for newline
                </span>
              </div>
            </div>

            <!-- Step 4: Thanks (post-submit visual confirmation) -->
            <div
              data-step="4"
              class="contact-step absolute inset-0 transition-all duration-500"
              style="opacity: 0; transform: translateY(24px); pointer-events: none;"
            >
              <p class="text-[10px] font-medium tracking-[0.3em] uppercase text-gold">04</p>
              <p
                class="mt-3 text-2xl font-light leading-snug text-charcoal sm:text-3xl"
                style="font-family: 'Raleway', sans-serif; font-weight: 300;"
              >
                Thank you. We'll be in touch shortly.
              </p>
              <p class="mt-4 max-w-md text-sm leading-relaxed text-taupe">
                One of our brokers will reach out via your preferred channel within
                one business day.
              </p>
            </div>
          </div>

          <!-- Progress bar -->
          <div class="mt-12 h-px w-full overflow-hidden bg-deep/10">
            <div
              id="contact-progress"
              class="h-full bg-gold transition-all duration-500 ease-out"
              style="width: 33.33%;"
            ></div>
          </div>
        </div>
        </div><!-- /#contact-stage -->
      </div>
    </div>
  </Container>
</section>

<style>
  #contact-stage {
    transition: height 0.4s ease-out;
  }
  #contact-steps {
    /* Steps are absolutely positioned inside this wrapper, so the wrapper's
       height has to be driven by JS to fit the active step's natural content.
       The transition keeps the resize smooth as the user advances. */
    transition: height 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .contact-view {
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }
  kbd {
    font-family: 'Raleway', sans-serif;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.1em;
  }
</style>

<script>
  const picker = document.getElementById("contact-picker");
  const formView = document.getElementById("contact-form-view");
  const card = document.getElementById("contact-card") as HTMLElement | null;
  const channelBtns =
    document.querySelectorAll<HTMLButtonElement>("[data-channel-pick]");
  const backBtn = document.getElementById("contact-back");
  const channelLabel = document.getElementById("contact-channel-label");
  const stepNumEl = document.getElementById("contact-step-num");
  const stepTotalEl = document.getElementById("contact-step-total");
  const progress = document.getElementById("contact-progress");
  const modeLabels =
    document.querySelectorAll<HTMLElement>("[data-contact-mode-label]");
  const steps =
    document.querySelectorAll<HTMLElement>(".contact-step");
  const nextBtns =
    document.querySelectorAll<HTMLButtonElement>("[data-step-next]");
  const inputs =
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
      "[data-step-input]",
    );

  if (picker && formView && card) {
    // Total step count excludes the "thanks" confirmation step.
    const TOTAL_STEPS = 3;
    let currentStep = 1;
    let channel: "whatsapp" | "email" | null = null;

    // Input guardrails. maxlength is also enforced at the HTML attribute
    // level — these constants exist so JS validation matches.
    const LIMITS = { name: 80, email: 254, phone: 20, message: 2000 };
    // Conservative, non-backtracking regex — no ReDoS risk.
    const EMAIL_RE = /^[^\s@]{1,64}@[^\s@]{1,255}\.[^\s@]{1,63}$/;
    const PHONE_RE = /^[+()\d\s.-]{7,20}$/;

    function validateStep(stepEl: HTMLElement): { ok: boolean; msg: string } {
      const inp = stepEl.querySelector<
        HTMLInputElement | HTMLTextAreaElement
      >("input, textarea");
      if (!inp) return { ok: false, msg: "" };
      const val = inp.value.trim();
      const step = parseInt(stepEl.dataset.step || "0", 10);
      if (step === 1) {
        if (!val) return { ok: false, msg: "" };
        if (val.length > LIMITS.name)
          return { ok: false, msg: `Max ${LIMITS.name} characters` };
        return { ok: true, msg: "" };
      }
      if (step === 2) {
        if (!val) return { ok: false, msg: "" };
        if (channel === "whatsapp") {
          if (val.length > LIMITS.phone)
            return { ok: false, msg: `Max ${LIMITS.phone} characters` };
          if (!PHONE_RE.test(val))
            return { ok: false, msg: "Enter a valid phone number" };
        } else {
          if (val.length > LIMITS.email)
            return { ok: false, msg: `Max ${LIMITS.email} characters` };
          if (!EMAIL_RE.test(val))
            return { ok: false, msg: "Enter a valid email address" };
        }
        return { ok: true, msg: "" };
      }
      if (step === 3) {
        if (!val) return { ok: false, msg: "" };
        if (val.length > LIMITS.message)
          return { ok: false, msg: `Max ${LIMITS.message} characters` };
        return { ok: true, msg: "" };
      }
      return { ok: true, msg: "" };
    }

    function refreshStepValidity(stepEl: HTMLElement | null) {
      if (!stepEl) return;
      const next = stepEl.querySelector<HTMLButtonElement>("[data-step-next]");
      const inp = stepEl.querySelector<
        HTMLInputElement | HTMLTextAreaElement
      >("input, textarea");
      const step = parseInt(stepEl.dataset.step || "0", 10);
      const counter = document.getElementById(`contact-counter-${step}`);
      const errEl = document.getElementById(`contact-error-${step}`);
      if (!inp || !next) return;

      // Update counter — max comes from the input's own maxLength attribute,
      // which we keep in sync with `LIMITS` whenever channel changes.
      const max = inp.maxLength > 0 ? inp.maxLength : null;
      if (counter && max != null) {
        counter.textContent = `${inp.value.length} / ${max}`;
      }

      const { ok, msg } = validateStep(stepEl);
      next.disabled = !ok;
      // Only surface error text when the user has typed something invalid —
      // an empty field shouldn't read as "error".
      if (errEl) errEl.textContent = inp.value.length > 0 ? msg : "";
      inp.setAttribute("aria-invalid", String(!ok && inp.value.length > 0));
    }

    // Crossfade between the picker view and the form view, with the stage
    // wrapper animating its height between the two natural sizes so the card
    // grows/shrinks smoothly instead of snapping.
    let transitioning = false;
    const stage = document.getElementById("contact-stage") as HTMLElement | null;

    function showView(view: "picker" | "form") {
      if (!picker || !formView || !stage) return;
      if (transitioning) return;
      transitioning = true;

      const FADE_MS = 400;
      const incoming = view === "form" ? formView : (picker as HTMLElement);
      const outgoing = view === "form" ? (picker as HTMLElement) : formView;
      const outgoingOffset = view === "form" ? "translateY(-24px)" : "translateY(24px)";

      // 1. Measure the current stage height (it reflects the outgoing view).
      const startH = stage.offsetHeight;

      // 2. Briefly hide outgoing + show incoming alone to measure the target.
      const prevOutDisplay = outgoing.style.display;
      outgoing.style.display = "none";
      incoming.style.display = "";
      // eslint-disable-next-line @typescript-eslint/no-unused-expressions
      stage.offsetHeight; // reflow for measurement
      const endH = stage.offsetHeight;

      // 3. Restore outgoing but lift it out of flow so it can fade in place
      //    without affecting the stage's height during the animation.
      outgoing.style.display = prevOutDisplay || "";
      outgoing.style.position = "absolute";
      outgoing.style.top = "0";
      outgoing.style.left = "0";
      outgoing.style.right = "0";

      // 4. Lock stage to start height, force reflow, then transition to end.
      stage.style.height = startH + "px";
      // eslint-disable-next-line @typescript-eslint/no-unused-expressions
      stage.offsetHeight;
      stage.style.height = endH + "px";

      // 5. Run the crossfade in parallel.
      outgoing.style.opacity = "0";
      outgoing.style.transform = outgoingOffset;
      outgoing.style.pointerEvents = "none";
      incoming.style.opacity = "1";
      incoming.style.transform = "translateY(0)";
      incoming.style.pointerEvents = "auto";

      // 6. After the transition completes: hide outgoing, restore its
      //    positioning, and clear the stage's inline height so it tracks
      //    the incoming view's natural size from then on.
      window.setTimeout(() => {
        outgoing.style.display = "none";
        outgoing.style.position = "";
        outgoing.style.top = "";
        outgoing.style.left = "";
        outgoing.style.right = "";
        stage.style.height = "";
        transitioning = false;
      }, FADE_MS);
    }

    const stepsWrapper = document.getElementById(
      "contact-steps",
    ) as HTMLElement | null;

    // Steps are `absolute inset-0` inside #contact-steps, so the wrapper has
    // no natural height — without this it stays at the inline `min-height`
    // and clips taller steps (e.g. step 3's textarea + Send button).
    function syncStepsHeight(activeStep: HTMLElement): void {
      if (!stepsWrapper) return;
      // scrollHeight is the active step's true content height regardless of
      // how the absolute box is currently sized.
      const h = activeStep.scrollHeight;
      stepsWrapper.style.height = h + "px";
    }

    function setStep(n: number) {
      const total = TOTAL_STEPS + 1; // includes the thanks slide
      if (n < 1 || n > total) return;
      steps.forEach((s) => {
        const idx = parseInt(s.dataset.step || "0", 10);
        if (idx === n) {
          s.style.opacity = "1";
          s.style.transform = "translateY(0)";
          s.style.pointerEvents = "auto";
          // Grow/shrink the wrapper so the active step's button is never clipped.
          syncStepsHeight(s);
          // Focus the first editable element after the transition
          if (idx <= TOTAL_STEPS) {
            window.setTimeout(() => {
              const inp = s.querySelector<
                HTMLInputElement | HTMLTextAreaElement
              >("input, textarea");
              inp?.focus();
            }, 350);
          }
        } else {
          s.style.opacity = "0";
          s.style.transform =
            idx < n ? "translateY(-24px)" : "translateY(24px)";
          s.style.pointerEvents = "none";
        }
      });
      currentStep = n;
      if (stepNumEl) stepNumEl.textContent = String(Math.min(n, TOTAL_STEPS));
      if (progress) {
        const pct = Math.min(n / TOTAL_STEPS, 1) * 100;
        progress.style.width = pct + "%";
      }
    }

    // Re-fit on viewport resize — labels can wrap and change the active
    // step's natural height when the column width changes.
    window.addEventListener("resize", () => {
      const active = steps.find(
        (s) => parseInt(s.dataset.step || "0", 10) === currentStep,
      );
      if (active) syncStepsHeight(active);
    });

    channelBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        channel = (btn.dataset.channelPick as "whatsapp" | "email") || null;
        if (channelLabel)
          channelLabel.textContent =
            channel === "whatsapp" ? "WhatsApp" : "Email";
        modeLabels.forEach((el) => {
          el.textContent = channel === "whatsapp" ? "phone number" : "email";
        });
        if (stepTotalEl) stepTotalEl.textContent = String(TOTAL_STEPS);

        // Reconfigure step 2 input for the chosen channel — keyboard hint,
        // autocomplete and max length all swap.
        const step2Input = document.getElementById(
          "contact-input-2",
        ) as HTMLInputElement | null;
        const step2Counter = document.getElementById("contact-counter-2");
        if (step2Input) {
          if (channel === "whatsapp") {
            step2Input.type = "tel";
            step2Input.inputMode = "tel";
            step2Input.autocomplete = "tel";
            step2Input.maxLength = LIMITS.phone;
            step2Input.placeholder = "+34 612 345 678";
          } else {
            step2Input.type = "email";
            step2Input.inputMode = "email";
            step2Input.autocomplete = "email";
            step2Input.maxLength = LIMITS.email;
            step2Input.placeholder = "you@example.com";
          }
          // Clear previous value so the user starts fresh on channel switch
          step2Input.value = "";
          if (step2Counter)
            step2Counter.textContent = `0 / ${step2Input.maxLength}`;
        }
        // Clear name and message too so re-entry starts clean.
        steps.forEach((s) => {
          const inp = s.querySelector<
            HTMLInputElement | HTMLTextAreaElement
          >("input, textarea");
          if (inp) inp.value = "";
          refreshStepValidity(s);
        });

        // Reset to step 1 each time a channel is picked
        setStep(1);
        showView("form");
      });
    });

    backBtn?.addEventListener("click", () => {
      if (currentStep > 1 && currentStep <= TOTAL_STEPS) {
        setStep(currentStep - 1);
      } else {
        // From step 1 or thanks, leave the form entirely.
        showView("picker");
      }
    });

    nextBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        // Guard against bypassing validation via stray clicks.
        if (btn.disabled) return;
        const stepEl = btn.closest<HTMLElement>(".contact-step");
        if (stepEl && !validateStep(stepEl).ok) return;
        if (currentStep >= TOTAL_STEPS) setStep(TOTAL_STEPS + 1);
        else setStep(currentStep + 1);
      });
    });

    // Live validation + counter on every keystroke / paste.
    inputs.forEach((inp) => {
      const stepEl = inp.closest<HTMLElement>(".contact-step");
      const handler = () => refreshStepValidity(stepEl);
      inp.addEventListener("input", handler);
      inp.addEventListener("blur", handler);

      // Enter to advance. In textarea, Shift+Enter inserts a newline.
      inp.addEventListener("keydown", (e) => {
        if (e.key !== "Enter") return;
        if (inp.tagName === "TEXTAREA" && e.shiftKey) return; // allow newline
        e.preventDefault();
        // Silently no-op if invalid — disabled button mirrors this.
        if (stepEl && !validateStep(stepEl).ok) return;
        stepEl?.querySelector<HTMLButtonElement>("[data-step-next]")?.click();
      });
    });

  }
</script>
