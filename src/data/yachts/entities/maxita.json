  "crew": [
    {
      "name": "Hrvoje Vučemil Korać",
      "avatar": "/media/media::image::c::8164602117::vessel::779458b0-486c-11ee-a45f-fdfff6163a60::assets::3e732a10-b0c7-11ef-9570-c5a2e43618b2/{imageVariant}",
      "role": "Captain",
      "bio": "Captain Hrvoje boasts a wealth of knowledge and extensive experience in the maritime industry, with a career spanning over 15 years in the tourism and hospitality sectors. He has held various positions, from deckhand to captain, continually upgrading his skills and certifications. He has captained numerous vessels, including M/Y Romantic Star and M/S Queen Eleganza, demonstrating his expertise in managing both small cruise ships and yachts. His proficiency extends engine room operations, and even carpentry, showcasing his versatile skill set. Hrvoje's experience includes working on newly built ships from construction to completion, ensuring a thorough understanding of vessel operations from the ground up. Fluent in English and Croatian, Hrvoje excels in communicating with diverse crews and guests, ensuring a seamless and enjoyable experience for all aboard."
    }
