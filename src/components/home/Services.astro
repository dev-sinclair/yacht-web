---
import Container from "../ui/Container.astro";
import services from "../../data/services.json";
import experiences from "../../data/experiences.json";
---

<section id="services" class="relative" style={`height: ${services.length * 100}vh;`}>
  <!-- Sticky viewport -->
  <div class="sticky top-0 h-screen flex items-center overflow-hidden"
    style="background: linear-gradient(180deg, #151A24 0%, #1D2330 100%);">

    <!-- Film grain overlay -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.06] z-10"
      style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E'); background-size: 200px 200px;">
    </div>

    <!-- Subtle warm vignette -->
    <div class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.4) 100%);"></div>

    <Container>
      <div class="relative z-20 grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-12 lg:gap-28 items-center">
        <!-- Left: services text -->
        <div>
          <!-- Header -->
          <div class="mb-4">
            <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold-light/70">
              What We Offer
            </p>
            <h2 class="mt-4 text-4xl font-light tracking-[0.15em] uppercase text-white/90 sm:text-5xl lg:text-6xl"
              style="font-family: 'Raleway', sans-serif; font-weight: 300;">
              Our Services
            </h2>
          </div>

          <!-- Service content area -->
          <div class="relative" style="min-height: 160px;">
            {services.map((service, i) => (
              <div
                class="service-slide absolute inset-0 flex flex-col justify-center transition-all duration-500"
                data-service-index={i}
                style={i === 0 ? "opacity: 1; transform: translateY(0);" : "opacity: 0; transform: translateY(30px);"}
              >
                <h3 class="text-2xl font-light tracking-[0.1em] uppercase text-white/90 sm:text-3xl"
                  style="font-family: 'Raleway', sans-serif; font-weight: 300;">
                  {service.title}
                </h3>
                <p class="mt-5 text-base leading-relaxed text-white/50 max-w-lg">
                  {service.description}
                </p>
              </div>
            ))}
          </div>

          <!-- Progress bars -->
          <div class="mt-10 flex max-w-md gap-3">
            {services.map((_, i) => (
              <div class="flex-1 h-[2px] bg-white/10 overflow-hidden">
                <div
                  class="service-bar h-full bg-white/80 transition-transform duration-500 origin-left"
                  data-bar-index={i}
                  style={i === 0 ? "transform: scaleX(1);" : "transform: scaleX(0);"}
                ></div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: client testimonials (one per service, scroll-driven) -->
        <div class="hidden lg:block relative lg:w-[480px]" style="height: 340px;">
          {experiences.map((exp, i) => (
            <div
              class="experience-slide absolute inset-0 flex flex-col justify-between border border-white/10 bg-white/[0.03] backdrop-blur-sm p-8 transition-all duration-600"
              data-experience-index={i}
              style={i === 0 ? "opacity: 1; transform: translateY(0);" : "opacity: 0; transform: translateY(40px);"}
            >
              <!-- Top: stars + quote -->
              <div>
                <div class="flex gap-1">
                  {[...Array(5)].map(() => (
                    <svg class="w-3.5 h-3.5 text-gold-light" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <p class="mt-6 text-base leading-[1.7] text-white/85 italic"
                  style="font-family: 'Raleway', sans-serif; font-weight: 300;">
                  &ldquo;{exp.quote}&rdquo;
                </p>
              </div>

              <!-- Bottom: author + location -->
              <div class="mt-6 pt-6 border-t border-white/10">
                <p class="text-sm font-medium tracking-wide text-white/90">{exp.author}</p>
                <p class="mt-1 text-[10px] tracking-[0.2em] uppercase text-white/40">{exp.location}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </div>
</section>

<script>
  const section = document.getElementById("services");
  if (section) {
    const slides = section.querySelectorAll<HTMLElement>(".service-slide");
    const bars = section.querySelectorAll<HTMLElement>(".service-bar");
    const experienceSlides = section.querySelectorAll<HTMLElement>(".experience-slide");
    const totalServices = slides.length;
    let currentIndex = -1;

    function updateService(index: number) {
      if (index === currentIndex) return;
      currentIndex = index;

      slides.forEach((slide, i) => {
        if (i === index) {
          slide.style.opacity = "1";
          slide.style.transform = "translateY(0)";
        } else {
          slide.style.opacity = "0";
          slide.style.transform = i < index ? "translateY(-30px)" : "translateY(30px)";
        }
      });

      bars.forEach((bar, i) => {
        bar.style.transform = i <= index ? "scaleX(1)" : "scaleX(0)";
      });

      experienceSlides.forEach((slide, i) => {
        if (i === index) {
          slide.style.opacity = "1";
          slide.style.transform = "translateY(0)";
        } else {
          slide.style.opacity = "0";
          slide.style.transform = i < index ? "translateY(-40px)" : "translateY(40px)";
        }
      });
    }

    function onScroll() {
      const rect = section!.getBoundingClientRect();
      const sectionHeight = section!.offsetHeight;
      const scrollIntoSection = -rect.top;
      const progress = Math.max(0, Math.min(1, scrollIntoSection / (sectionHeight - window.innerHeight)));
      const index = Math.min(totalServices - 1, Math.floor(progress * totalServices));
      updateService(index);
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
