  "crew": [
    {
      "name": "NASRUL NASH JUJE",
      "avatar": "/media/media::image::a::vessel::d5cc2592-fe8c-11ed-889f-43d4bb723744::assets::c109a450-189e-11f1-9e9d-95da3f960574/{imageVariant}",
      "role": "Captain",
      "bio": "Nash, our experienced Captain, hails from Labuan Bajo, Flores, and comes from the Bajo tribe. With over 20 years of experience in the maritime industry, he has worked on a variety of vessels, ranging from dive boats to luxury ships, operating across some of Indonesia’s most stunning regions, including Komodo, Sumbawa, and Bali. His extensive career reflects his dedication to navigating the seas with skill and passion.\n\nWhen he's not at the helm, Nash enjoys touring and exploring off-road trails, reflecting his adventurous spirit."
    },
    {
      "name": "DAVID DURAN ROYO",
      "avatar": "/media/media::image::a::vessel::d5cc2592-fe8c-11ed-889f-43d4bb723744::assets::bd738fd0-189f-11f1-9e9d-95da3f960574/{imageVariant}",
      "role": "Captain",
      "bio": "David, from Barcelona, Spain, joined Mischief Voyage in July 2024. With experience in the maritime and diving industry since 2018, he holds certifications such as PADI Master Instructor and SSI Scuba Instructor. David has worked in Spain, Mexico, and Indonesia (Raja Ampat & Komodo), bringing his expertise in diving and trip leadership to the crew. Passionate about sustainability, conservation, and water sports, he also enjoys meditation, reading, music, running, and hiking."
    },
    {
      "name": "IRSAN",
      "avatar": "/media/media::image::a::vessel::d5cc2592-fe8c-11ed-889f-43d4bb723744::assets::eb3dd240-189f-11f1-9e9d-95da3f960574/{imageVariant}",
      "role": "Captain",
      "bio": "Irsan, from Bima, Nusa Tenggara Barat, joined Mischief Voyage on November 1, 2022. With years of experience in various maritime roles, including working as a tender boat operator at Ayana Komodo Resort and other key operations around Komodo, he brings a wealth of knowledge to the crew. His extensive background ensures a high level of skill and safety on the water. Outside of work, Irsan is passionate about football."
    },
    {
      "name": "VINSENSIUS SUTRIAN",
      "avatar": "/media/media::image::a::vessel::d5cc2592-fe8c-11ed-889f-43d4bb723744::assets::135445c0-18a0-11f1-9e9d-95da3f960574/{imageVariant}",
      "role": "Captain",
      "bio": "Vinsensius, from West Manggarai, became part of the Mischief Voyage crew on June 1, 2024. With experience in hospitality from Ayana Komodo and Trans Luxury Yacht, he ensures that every cabin is impeccably maintained, creating a welcoming and comfortable space for guests. From fresh linens to a well-kept environment, his attention to detail enhances the onboard experience. Vinsensius enjoys playing guitar and singing, bringing a warm and musical spirit to life at sea."
    },
    {
      "name": "MUHAMAD MUSTAKIM",
      "avatar": "/media/media::image::a::vessel::d5cc2592-fe8c-11ed-889f-43d4bb723744::assets::415e0230-18a0-11f1-9e9d-95da3f960574/{imageVariant}",
      "role": "Captain",
      "bio": "Takim, from Labuan Bajo, joined Mischief Voyage in 2024 after starting with Samara Liveaboard in 2023. As a chef, he brings his culinary skills to create delicious meals for guests. He has also worked with Local Collection, enhancing his experience in the kitchen. In his free time, Takim enjoys fishing."
    },
    {
      "name": "ADI USMAN",
      "avatar": "/media/media::image::a::vessel::d5cc2592-fe8c-11ed-889f-43d4bb723744::assets::5f2525a0-18a0-11f1-9e9d-95da3f960574/{imageVariant}",
      "role": "Captain",
      "bio": "Adi Usman, our friendly bartender from Lombok, joined the Mischief Voyage team on May 6, 2024. With experience working on a cruise ship, he brings a wealth of knowledge and a passion for creating exceptional cocktails. Adi loves ensuring every guest enjoys a memorable experience onboard. When he's not shaking up drinks, he enjoys playing badminton to stay active and energized."
    },
    {
      "name": "SURIYADI",
      "avatar": "/media/media::image::a::vessel::d5cc2592-fe8c-11ed-889f-43d4bb723744::assets::839dd8f0-18a0-11f1-8974-27ce0fc35fc0/{imageVariant}",
      "role": "Captain",
      "bio": "Suriyadi, from Ujung Pandang, joined Mischief Voyage on February 28, 2024, bringing his expertise as a Second Engineer from KM Lako Sae at Ayana Komodo. With a strong technical background, he ensures smooth sailing and efficient onboard operations. Outside of work, he enjoys playing futsal to stay active."
    },
    {
      "name": "YORI MAITIMU",
      "avatar": "/media/media::image::a::vessel::d5cc2592-fe8c-11ed-889f-43d4bb723744::assets::9d322820-18a0-11f1-8974-27ce0fc35fc0/{imageVariant}",
      "role": "Captain",
      "bio": "Yori, from Ambon, Maluku, joined Mischief Voyage in June 2022 after starting with Samara in November 2021. With a strong background in engineering, he has worked on several vessels, including KLM Sama-Sama, KLM Sayang Laga Ligo, and KLM Moana. Yori’s technical skills are crucial in ensuring the smooth operation of the ship. In his free time, he enjoys listening to music."
    },
    {
      "name": "ALFONSIUS SANDRO RADU",
      "avatar": "/media/media::image::a::vessel::d5cc2592-fe8c-11ed-889f-43d4bb723744::assets::ca04eb30-18a0-11f1-8974-27ce0fc35fc0/{imageVariant}",
      "role": "Captain",
      "bio": "Sandro, from Labuan Bajo, Manggarai Barat, Flores, NTT, joined Mischief Voyage on November 26, 2022, as a tender boat operator. Prior to joining Mischief, he worked with KLM Reviéro from January 2022 to October 2022. With his experience on the water, he ensures smooth and safe transfers between the boat and shore. Sandro is also passionate about exploring new places and is always ready for a game of football with his crew mates."
    }
  ],
