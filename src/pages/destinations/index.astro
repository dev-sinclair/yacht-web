---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import DestinationsHero from "../../components/destinations/DestinationsHero.astro";
import DestinationSearch from "../../components/destinations/DestinationSearch.astro";
import DestinationGrid from "../../components/destinations/DestinationGrid.astro";
import { getAllRegions } from "../../lib/destinations/registry";

const regions = getAllRegions();
const locationCount = regions.reduce((acc, r) => acc + r.locations.length, 0);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=86400, stale-while-revalidate=604800",
);
---

<BaseLayout
  title="Destinations — Sinclair Yachting"
  description="Explore our curated cruising regions, from the West Mediterranean to Antarctica. Choose where in the world you want to wake up tomorrow."
>
  <Navbar />
  <main>
    <DestinationsHero />
    <DestinationSearch
      regionCount={regions.length}
      locationCount={locationCount}
    />
    <DestinationGrid regions={regions} />
  </main>
  <Footer />
</BaseLayout>

<script>
  type RegionCard = HTMLLIElement;

  const grid = document.querySelector<HTMLElement>("[data-dest-grid]");
  const searchInput = document.getElementById("dest-search") as HTMLInputElement | null;
  const countLabel = document.querySelector<HTMLElement>("[data-dest-count]");
  const emptyState = document.querySelector<HTMLElement>("[data-dest-empty]");
  const searchWrapper = document.querySelector<HTMLElement>("[data-dest-search-wrapper]");

  if (grid && searchInput && countLabel && emptyState && searchWrapper) {
    const cards = Array.from(
      grid.querySelectorAll<RegionCard>("[data-region-card]"),
    );
    const totalRegions = Number(searchWrapper.dataset.regionCount ?? cards.length);
    const totalLocations = Number(searchWrapper.dataset.locationCount ?? 0);
    const baseCountText = `${totalRegions} Regions · ${totalLocations} Destinations`;

    let currentOpen: RegionCard | null = null;
    let currentQuery = "";
    let debounceId: number | null = null;

    function setOpen(card: RegionCard, open: boolean) {
      const toggle = card.querySelector<HTMLButtonElement>("[data-region-toggle]");
      const panel = card.querySelector<HTMLElement>("[data-region-panel]");
      const ctaText = card.querySelector<HTMLElement>("[data-region-cta-text]");
      if (!toggle || !panel) return;

      card.dataset.open = open ? "true" : "false";
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      panel.setAttribute("aria-hidden", open ? "false" : "true");
      if (ctaText) ctaText.textContent = open ? "Collapse" : "Explore";
    }

    function closeAll() {
      if (currentOpen) {
        setOpen(currentOpen, false);
        currentOpen = null;
      }
    }

    function openCard(card: RegionCard) {
      if (currentOpen && currentOpen !== card) setOpen(currentOpen, false);
      setOpen(card, true);
      currentOpen = card;
    }

    cards.forEach((card) => {
      const toggle = card.querySelector<HTMLButtonElement>("[data-region-toggle]");
      if (!toggle) return;
      toggle.addEventListener("click", () => {
        if (card.dataset.open === "true") {
          setOpen(card, false);
          currentOpen = null;
        } else {
          openCard(card);
        }
      });
    });

    function applyFilter(query: string) {
      const q = query.trim().toLowerCase();
      currentQuery = q;
      let visibleRegions = 0;
      let visibleLocations = 0;

      cards.forEach((card) => {
        const regionName = card.dataset.regionName ?? "";
        const locationsBlob = card.dataset.locations ?? "";
        const locationNames = locationsBlob.split("|").filter(Boolean);

        const regionMatch = q === "" || regionName.includes(q);
        const locationMatchCount = q === ""
          ? locationNames.length
          : locationNames.filter((n) => n.includes(q)).length;
        const matches = regionMatch || locationMatchCount > 0;

        if (matches) {
          card.dataset.dimmed = "false";
          visibleRegions += 1;
          visibleLocations += locationMatchCount;
        } else {
          card.dataset.dimmed = "true";
        }

        // Per-link dim within open dropdowns
        const links = card.querySelectorAll<HTMLAnchorElement>("[data-location-link]");
        links.forEach((link) => {
          const name = (link.dataset.locationName ?? "").toLowerCase();
          if (q === "" || name.includes(q) || regionMatch) {
            link.style.opacity = "";
            if (q !== "" && !regionMatch && name.includes(q)) {
              link.classList.add("ring-1", "ring-gold");
            } else {
              link.classList.remove("ring-1", "ring-gold");
            }
          } else {
            link.style.opacity = "0.35";
            link.classList.remove("ring-1", "ring-gold");
          }
        });

        // Auto-open region if query matches a location (not the region name)
        if (q !== "" && !regionMatch && locationMatchCount > 0) {
          if (card.dataset.open !== "true") openCard(card);
        }
      });

      if (q === "") {
        countLabel!.textContent = baseCountText;
        emptyState!.classList.add("hidden");
      } else if (visibleRegions === 0) {
        countLabel!.textContent = `No matches for “${query.trim()}”`;
        emptyState!.classList.remove("hidden");
      } else {
        countLabel!.textContent = `Showing ${visibleRegions} of ${totalRegions} regions`;
        emptyState!.classList.add("hidden");
      }
    }

    searchInput.addEventListener("input", () => {
      if (debounceId !== null) window.clearTimeout(debounceId);
      debounceId = window.setTimeout(() => {
        applyFilter(searchInput.value);
        debounceId = null;
      }, 80);
    });

    // Sticky search shadow on scroll
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          searchWrapper.classList.add("shadow-md");
        } else {
          searchWrapper.classList.remove("shadow-md");
        }
      },
      { threshold: [0], rootMargin: "-80px 0px 0px 0px" },
    );
    const sentinel = document.createElement("div");
    sentinel.style.cssText = "height:1px;";
    searchWrapper.parentElement?.insertBefore(sentinel, searchWrapper);
    observer.observe(sentinel);

    // Reset filter via Escape
    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && searchInput.value !== "") {
        searchInput.value = "";
        applyFilter("");
      }
    });
  }
</script>
