---
import Container from "../ui/Container.astro";
import RegionTile from "../destinations/RegionTile.astro";
import { getAllRegions } from "../../lib/destinations/registry";

const regions = getAllRegions();
---

<section id="destinations" class="relative bg-warm-white py-24 lg:py-32">
  <Container>
    <!-- Header -->
    <div class="max-w-2xl" data-reveal>
      <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">
        Where We Sail
      </p>
      <h2
        class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
        style="font-family: 'Raleway', sans-serif; font-weight: 300;"
      >
        Destinations
      </h2>
      <div class="mt-6 h-px w-10 bg-gold/40"></div>
      <p class="mt-8 text-base leading-[1.8] text-taupe">
        From Mediterranean classics to the polar extremes, our brokers source charters across every major cruising ground. Choose a region to see what's possible.
      </p>
    </div>

    <!-- Region grid (edge-to-edge, no gaps) -->
    <ul
      class="mt-14 lg:mt-20 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
      data-reveal
    >
      {regions.map((region, index) => (
        <RegionTile region={region} index={index} />
      ))}
    </ul>
  </Container>
</section>
