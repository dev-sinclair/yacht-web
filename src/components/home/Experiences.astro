---
import Container from "../ui/Container.astro";
import experiences from "../../data/experiences.json";
---

<section id="experiences" class="bg-white py-24 lg:py-36">
  <Container>
    <div data-reveal>
      <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">
        Testimonials
      </p>
      <h2 class="mt-4 text-4xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-5xl lg:text-6xl"
        style="font-family: 'Raleway', sans-serif; font-weight: 300;">
        Client Experiences
      </h2>
      <div class="mt-5 h-px w-12 bg-gold/30" data-reveal-line></div>
    </div>

    <div class="mt-16 grid gap-12 md:grid-cols-3" data-reveal-stagger>
      {experiences.map((exp) => (
        <div class="border-t border-beige pt-8">
          <!-- 5 stars -->
          <div class="flex gap-0.5 mb-4">
            {[...Array(5)].map(() => (
              <svg class="w-3.5 h-3.5 text-gold" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-base leading-[1.8] text-charcoal/80 italic">
            {exp.quote}
          </p>
          <div class="mt-8">
            <p class="text-sm font-medium tracking-wide text-charcoal">{exp.author}</p>
            <p class="mt-1 text-xs tracking-wider uppercase text-taupe-light">{exp.location}</p>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>
