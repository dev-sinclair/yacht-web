---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import Container from "../../components/ui/Container.astro";

// Hero: photo by Mathias Reding on Unsplash
// https://unsplash.com/photos/GjYDZXCLGRQ — white and black speedboat on the ocean
const heroSrc =
  "https://images.unsplash.com/photo-1571769637676-619b62e64f94?w=1920&q=80&auto=format&fit=crop";
const heroSrcMd =
  "https://images.unsplash.com/photo-1571769637676-619b62e64f94?w=1280&q=80&auto=format&fit=crop";

// Why-Sinclair portrait: photo by Maurits Bausenhart on Unsplash
// https://unsplash.com/photos/v-5m2uAzhYM — large modern yacht on calm sea
const portraitSrc =
  "https://images.unsplash.com/photo-1759135695910-0a6aaaab6b14?w=1200&q=80&auto=format&fit=crop";
const portraitSrcHi =
  "https://images.unsplash.com/photo-1759135695910-0a6aaaab6b14?w=1800&q=80&auto=format&fit=crop";

const pillars = [
  {
    label: "Technical",
    text: "Planned maintenance, surveys, refit schedules, class and flag compliance, keeping the yacht in prime condition, year-round.",
  },
  {
    label: "Crew",
    text: "Employment structures, recruitment, payroll, leave and documentation — ensuring professional crew are continuously supported.",
  },
  {
    label: "Compliance",
    text: "Safety management, certification, audits and regulatory oversight — the yacht is always ready to sail.",
  },
  {
    label: "Finance",
    text: "Budgeting, cash flow, accounting and reporting — clear, consistent supervision at every stage.",
  },
];
---

<BaseLayout
  title="Yacht Management · Sinclair Yachting"
  description="Full-service yacht management from Sinclair. Technical, crew, compliance and finance. The operational running of the yacht, whether it charters or not."
>
  <Navbar />

  <!-- Hero -->
  <section
    class="relative h-screen w-full bg-white px-3 pb-3 sm:px-4 sm:pb-4 lg:px-5 lg:pb-5"
  >
    <div class="relative h-full w-full overflow-hidden bg-deep">
      <img
        src={heroSrc}
        srcset={`${heroSrcMd} 1280w, ${heroSrc} 1920w`}
        sizes="100vw"
        alt="White and black speedboat on the ocean"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/45 to-black/45"
      >
      </div>

      <div
        class="absolute bottom-0 left-0 right-0 z-10 px-6 pb-36 sm:px-8 lg:px-12"
      >
        <div
          class="mx-auto max-w-[1440px]"
          style="text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);"
        >
          <p
            class="text-[11px] font-light tracking-[0.3em] uppercase text-white/70"
          >
            Sinclair Yachting · Yacht Management
          </p>
          <h1
            class="mt-4 text-4xl leading-[1.1] tracking-[0.08em] uppercase text-white sm:text-5xl lg:text-6xl xl:text-7xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;"
          >
            Yacht<br />
            Management
          </h1>
          <p
            class="mt-6 text-lg font-light tracking-[0.04em] text-white/90 sm:text-xl"
            style="font-family: 'Raleway', sans-serif;"
          >
            Expert care, exceptional service.
          </p>
          <p
            class="mt-5 max-w-xl text-sm leading-relaxed text-white/80 sm:text-base"
          >
            Your yacht, always ready.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="/#contact"
              class="btn-fill-light inline-flex items-center gap-3 border border-white/40 px-7 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-white"
            >
              Enquire Here
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Sinclair / pillars -->
  <section class="bg-white py-24 lg:py-32">
    <Container>
      <div
        class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,480px)] lg:gap-20"
      >
        <!-- Left: intro copy -->
        <div>
          <p
            class="text-[11px] font-light tracking-[0.3em] uppercase text-deep-dark"
          >
            Why Sinclair
          </p>
          <h2
            class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;"
          >
            One Team.<br />
            Complete Oversight.
          </h2>
          <div class="mt-6 h-px w-10 bg-deep/40"></div>
          <p class="mt-8 max-w-xl text-base leading-[1.8] text-taupe">
            A single point of contact who understands the operational realities
            of yacht ownership — ensuring peace of mind and consistency across
            every aspect of the programme.
          </p>

          <p
            class="mt-12 text-[11px] font-light tracking-[0.3em] uppercase text-deep-dark"
          >
            What We Oversee
          </p>
          <p class="mt-3 max-w-xl text-base font-light leading-[1.6] text-charcoal">
            Technical, crew, compliance and finance.
          </p>

          <!-- Pillars -->
          <div class="mt-8 grid grid-cols-2 gap-y-8 gap-x-8">
            {
              pillars.map((p) => (
                <div>
                  <p
                    class="text-xl font-light tracking-[0.25em] uppercase text-charcoal sm:text-2xl"
                    style="font-family: 'Raleway', sans-serif; font-weight: 300;"
                  >
                    {p.label}
                  </p>
                  <p class="mt-2 text-sm leading-[1.7] text-taupe">{p.text}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Right: portrait image. Remote Unsplash asset — plain <img> since
             Astro's <Image> is tuned for local imports. -->
        <div class="relative hidden lg:block">
          <div class="relative aspect-[4/5] w-full overflow-hidden">
            <img
              src={portraitSrc}
              srcset={`${portraitSrc} 1200w, ${portraitSrcHi} 1800w`}
              sizes="(min-width: 1024px) 480px, 100vw"
              alt="Large modern yacht on calm sea"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Also chartering? — brand blue band, cross-link to Charter Management -->
  <section
    class="relative overflow-hidden py-20 lg:py-24"
    style="background-color: #6e8e8f;"
  >
    <div
      class="absolute inset-0 pointer-events-none"
      style="background-color: rgba(15, 24, 25, 0.14);"
    >
    </div>
    <Container>
      <div
        class="relative flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-center"
      >
        <div class="max-w-xl">
          <p
            class="text-[11px] font-light tracking-[0.3em] uppercase text-white/80"
          >
            Also Chartering?
          </p>
          <h2
            class="mt-4 text-2xl font-light tracking-[0.12em] uppercase text-white sm:text-3xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;"
          >
            Add Charter Management
          </h2>
          <p class="mt-4 text-base leading-[1.8] text-white/85">
            Yacht Management maintains your asset. Charter Management
            commercialises it — the same standard, two distinct programmes.
          </p>
        </div>
        <a
          href="/charter-management"
          class="btn-fill-light inline-flex items-center gap-3 border border-white/40 px-8 py-4 text-[11px] font-medium tracking-[0.2em] uppercase text-white"
        >
          Charter Management
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </Container>
  </section>

  <!-- Closing CTA -->
  <section class="bg-white py-24 lg:py-32 text-center">
    <Container>
      <p class="text-[11px] font-light tracking-[0.3em] uppercase text-deep-dark">
        Ready When You Are
      </p>
      <h2
        class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
        style="font-family: 'Raleway', sans-serif; font-weight: 300;"
      >
        Begin a Confidential Conversation
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-taupe">
        We will review your requirements and advise accordingly.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/#contact"
          class="btn-fill inline-flex items-center gap-3 border border-deep/20 px-8 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-charcoal"
        >
          Request a Consultation
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </Container>
  </section>

  <Footer />
</BaseLayout>
