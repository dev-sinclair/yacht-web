---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import DestinationsHero from "../../components/destinations/DestinationsHero.astro";
import DestinationSearch from "../../components/destinations/DestinationSearch.astro";
import DestinationGrid from "../../components/destinations/DestinationGrid.astro";
import { getOrderedRegions } from "../../lib/destinations/registry";

const regions = getOrderedRegions();
const locationCount = regions.reduce((acc, r) => acc + r.locations.length, 0);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=86400, stale-while-revalidate=604800",
);
---

<BaseLayout
  title="Destinations · Sinclair Yachting"
  description="Explore our curated cruising regions, from Northern Europe to Antarctica. Choose where in the world you want to wake up tomorrow."
>
  <Navbar />
  <main>
    <DestinationsHero />
    <DestinationSearch
      regionCount={regions.length}
      locationCount={locationCount}
    />
    <DestinationGrid regions={regions} />
  </main>
  <Footer />
</BaseLayout>

<script>
  type RegionCard = HTMLLIElement;

  const grid = document.querySelector<HTMLElement>("[data-dest-grid]");
  const searchInput = document.getElementById("dest-search") as HTMLInputElement | null;
  const countLabel = document.querySelector<HTMLElement>("[data-dest-count]");
  const emptyState = document.querySelector<HTMLElement>("[data-dest-empty]");
  const searchWrapper = document.querySelector<HTMLElement>("[data-dest-search-wrapper]");

  if (grid && searchInput && countLabel && emptyState && searchWrapper) {
    const cards = Array.from(
      grid.querySelectorAll<RegionCard>("[data-region-card]"),
    );
    const totalRegions = Number(searchWrapper.dataset.regionCount ?? cards.length);
    const totalLocations = Number(searchWrapper.dataset.locationCount ?? 0);
    const baseCountText = `${totalRegions} Regions · ${totalLocations} Destinations`;

    let debounceId: number | null = null;

    function applyFilter(query: string) {
      const q = query.trim().toLowerCase();
      let visibleRegions = 0;
      let visibleLocations = 0;
      let firstMatch: HTMLElement | null = null;

      cards.forEach((card) => {
        const regionName = card.dataset.regionName ?? "";
        const locationsBlob = card.dataset.locations ?? "";
        const locationNames = locationsBlob.split("|").filter(Boolean);

        const regionMatch = q === "" || regionName.includes(q);
        const locationMatchCount = q === ""
          ? locationNames.length
          : locationNames.filter((n) => n.includes(q)).length;
        const matches = regionMatch || locationMatchCount > 0;

        if (matches) {
          card.dataset.dimmed = "false";
          visibleRegions += 1;
          visibleLocations += locationMatchCount;
          if (!firstMatch) firstMatch = card;
        } else {
          card.dataset.dimmed = "true";
        }
      });

      if (q === "") {
        countLabel!.textContent = baseCountText;
        emptyState!.classList.add("hidden");
      } else if (visibleRegions === 0) {
        countLabel!.textContent = `No matches for “${query.trim()}”`;
        emptyState!.classList.remove("hidden");
      } else {
        countLabel!.textContent = `Showing ${visibleRegions} of ${totalRegions} regions`;
        emptyState!.classList.add("hidden");
      }

      // Only scroll when the top match is actually OFFSCREEN — if it's already
      // visible, leave the viewport alone (scrolling per keystroke feels jumpy).
      if (q !== "" && firstMatch) {
        const target = firstMatch as HTMLElement;
        const rect = target.getBoundingClientRect();
        const searchRect = searchWrapper!.getBoundingClientRect();
        // Top edge of usable area: just below the sticky search bar.
        const topBoundary = searchRect.bottom;
        const bottomBoundary = window.innerHeight;
        const isOffscreen = rect.top < topBoundary || rect.top > bottomBoundary;
        if (isOffscreen) {
          target.scrollIntoView({ behavior: "auto", block: "start" });
        }
      }
    }

    searchInput.addEventListener("input", () => {
      if (debounceId !== null) window.clearTimeout(debounceId);
      debounceId = window.setTimeout(() => {
        applyFilter(searchInput.value);
        debounceId = null;
      }, 80);
    });

    // Reset filter via Escape
    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && searchInput.value !== "") {
        searchInput.value = "";
        applyFilter("");
      }
    });
  }
</script>
