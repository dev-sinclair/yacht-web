  "crew": [
    {
      "name": "Ben Dakin",
      "avatar": "/media/media::image::a::vessel::d5cca19d-fe8c-11ed-889f-43d4bb723744::assets::29625780-50dd-11ef-8228-031516b6d687.jpeg/{imageVariant}",
      "role": "Captain",
      "bio": "Ben is a seasoned maritime professional with over 20 years of experience navigating the globe, from the rugged North Atlantic to the turquoise waters of the Caribbean and the South Pacific. His love for water sports and fishing brings an exciting energy to every voyage, always seeking out opportunities for adventure and generously sharing his knowledge and fishing tips along the way. Under Ben’s guidance every charter becomes unforgettable."
    },
    {
      "name": "Jay Bowers",
      "avatar": "/media/media::image::a::vessel::d5cca19d-fe8c-11ed-889f-43d4bb723744::assets::37507930-50dd-11ef-8228-031516b6d687.jpeg/{imageVariant}",
      "role": "Captain",
      "bio": "Originally from Sydney and now calling the Whitsundays home, Jay brings a wealth of hands-on experience to Phoenix One. With a background in marine mechanics and a career that evolved from sailing on maxi racing yachts he now enjoys working on board luxury superyachts. When he’s not ensuring the vessel runs seamlessly, you’ll find him spearfishing, casting a line or enjoying a round of golf."
    },
    {
      "name": "Nick Toon",
      "avatar": "/media/media::image::a::vessel::d5cca19d-fe8c-11ed-889f-43d4bb723744::assets::44d26b90-50dd-11ef-8228-031516b6d687.jpeg/{imageVariant}",
      "role": "Captain",
      "bio": "As Second Officer, Nick plays an integral role delivering a harmonious and unforgettable experience on board Phoenix One. His contagious, enthusiastic personality and natural rapport with guests creates a welcoming, delightful atmosphere from the moment you step on board. Whether he is assisting with day-to-day operations or adding a personal touch to the journey, Nick makes every charter feel effortless."
    },
    {
      "name": "Natasha Cully",
      "avatar": "/media/media::image::a::vessel::d5cca19d-fe8c-11ed-889f-43d4bb723744::assets::5175bdc0-50dd-11ef-8228-031516b6d687.jpeg/{imageVariant}",
      "role": "Captain",
      "bio": "Natasha brings a calm, conscientious presence to every charter, shaped by over a decade of global yachting experience across Europe, the Caribbean, the South Pacific and Australia. She is the direct point of contact for guests and brokers, coordinating every detail and crafting meaningful moments that linger long after the charter ends. When she’s not on board, Natasha is based on the Gold Coast, embracing coastal life and staying connected to the ocean she loves."
    },
    {
      "name": "Autumn Treasure",
      "avatar": "/media/media::image::a::vessel::d5cca19d-fe8c-11ed-889f-43d4bb723744::assets::6101d800-50dd-11ef-8228-031516b6d687.jpeg/{imageVariant}",
      "role": "Captain",
      "bio": "From the shores of Western Australia, Autumn brings warmth, precision and a keen eye for detail to her role as Second Stewardess. With a background in luxury yachting, she is skilled in both elegant table settings and creative mixology, always striving to elevate the guest experience. Autumn’s thoughtful approach and personable service ensures every moment on board is flawless and memorable for the guests."
    }
  ],
