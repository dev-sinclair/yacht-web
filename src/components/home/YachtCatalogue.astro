---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import yachts from "../../data/yachts.json";

import yacht1 from "../../assets/yacht1.webp";
import yacht2 from "../../assets/yacht2.jpg";
import yacht3 from "../../assets/yacht3.jpg";

// Pick 3 random yachts at build time
const shuffled = [...yachts].sort(() => Math.random() - 0.5);
const featured = shuffled.slice(0, 3);

const yachtImages = [yacht1, yacht2, yacht3];

function formatLength(length: number) {
  const feet = Math.round(length * 3.28084);
  return `${length.toFixed(2)}m / ${feet}'`;
}
---

<section class="bg-white py-24 lg:py-36">
  <Container>
    <div class="mb-16" data-reveal>
      <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">
        Our Fleet
      </p>
      <h2 class="mt-4 text-4xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-5xl lg:text-6xl"
        style="font-family: 'Raleway', sans-serif; font-weight: 300;">
        Yacht Catalogue
      </h2>
      <div class="mt-5 h-px w-12 bg-gold/30" data-reveal-line></div>
    </div>

    <!-- Yacht spec cards — 3 in a row -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3" data-reveal-stagger>
      {featured.map((yacht, i) => (
        <a href={`/catalogue/${yacht.id}`} class="group block border border-beige/60 transition-shadow duration-300 hover:shadow-lg">
          <!-- Header: Name + Price -->
          <div class="flex items-start justify-between px-5 pt-5 pb-3">
            <h3 class="text-lg font-normal tracking-[0.1em] uppercase text-charcoal sm:text-xl"
              style="font-family: 'Raleway', sans-serif; font-weight: 500;">
              {yacht.name}
            </h3>
            <div class="text-right shrink-0 ml-3">
              <p class="text-[9px] font-medium tracking-[0.15em] uppercase text-taupe-light">Price from</p>
              <p class="num text-sm tracking-[0.05em] text-charcoal sm:text-base">
                {yacht.price === "On Request" ? "On Request" : yacht.price}
              </p>
            </div>
          </div>

          <!-- Specs row -->
          <div class="grid grid-cols-4 border-t border-beige/60 px-5 py-2.5">
            <div>
              <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light">Length</p>
              <p class="num mt-0.5 text-[11px] text-charcoal">{formatLength(yacht.length)}</p>
            </div>
            <div>
              <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light">Guests</p>
              <p class="num mt-0.5 text-[11px] text-charcoal">{yacht.guests}</p>
            </div>
            <div>
              <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light">Year</p>
              <p class="num mt-0.5 text-[11px] text-charcoal">{yacht.year}</p>
            </div>
            <div>
              <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light">Cabins</p>
              <p class="num mt-0.5 text-[11px] text-charcoal">{yacht.cabins}</p>
            </div>
          </div>

          <!-- Image -->
          <div class="aspect-[16/9] overflow-hidden bg-cream">
            <Image
              src={yachtImages[i]}
              alt={yacht.name}
              class="h-full w-full object-cover"
              widths={[400, 600]}
              loading="lazy"
            />
          </div>
        </a>
      ))}
    </div>

    <!-- View all CTA -->
    <div class="mt-12" data-reveal>
      <a
        href="/catalogue"
        class="btn-fill inline-flex items-center gap-3 border border-charcoal/20 px-8 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-charcoal"
      >
        View All Yachts
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </Container>
</section>
