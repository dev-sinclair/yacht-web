---
// Skeleton tree for /yachts/[slug] — matches the layout of the real components
// so there's no shift when data arrives.
---

<!-- Hero -->
<section class="relative h-screen w-full bg-white px-3 pb-3 sm:px-4 sm:pb-4 lg:px-5 lg:pb-5">
  <div id="hero" class="relative h-full w-full overflow-hidden bg-deep">
    <div class="absolute inset-0 bg-deep/60 animate-pulse"></div>
    <div class="relative z-10 flex h-full items-end px-6 pb-16 sm:px-12 lg:px-20 lg:pb-24">
      <div class="max-w-3xl space-y-4 w-full">
        <div class="h-3 w-20 bg-white/15 animate-pulse"></div>
        <div class="h-12 w-3/4 sm:h-16 bg-white/20 animate-pulse"></div>
        <div class="h-4 w-1/2 bg-white/15 animate-pulse"></div>
      </div>
    </div>
  </div>
</section>

<!-- Quick specs bar -->
<section class="border-y border-beige/60 bg-warm-white">
  <div class="mx-auto max-w-7xl grid grid-cols-2 gap-y-6 gap-x-4 px-4 py-8 sm:grid-cols-4 sm:px-6 lg:grid-cols-8 lg:px-8">
    {Array.from({ length: 8 }).map(() => (
      <div class="space-y-2">
        <div class="h-2 w-16 bg-cream animate-pulse"></div>
        <div class="h-4 w-12 bg-cream animate-pulse"></div>
      </div>
    ))}
  </div>
</section>

<!-- Description + pricing -->
<section class="bg-white py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_380px] lg:gap-20">
      <div class="space-y-4">
        <div class="h-3 w-20 bg-cream animate-pulse"></div>
        <div class="h-8 w-2/3 bg-cream animate-pulse"></div>
        <div class="space-y-3 pt-4">
          <div class="h-3 w-full bg-cream animate-pulse"></div>
          <div class="h-3 w-full bg-cream animate-pulse"></div>
          <div class="h-3 w-11/12 bg-cream animate-pulse"></div>
          <div class="h-3 w-5/6 bg-cream animate-pulse"></div>
          <div class="h-3 w-3/4 bg-cream animate-pulse"></div>
        </div>
      </div>
      <div class="border border-beige/60 p-6 space-y-6">
        <div class="space-y-2">
          <div class="h-3 w-24 bg-cream animate-pulse"></div>
          <div class="h-8 w-32 bg-cream animate-pulse"></div>
        </div>
        <div class="grid grid-cols-2 gap-3 border-t border-beige/40 pt-6">
          {Array.from({ length: 4 }).map(() => (
            <div class="space-y-1.5">
              <div class="h-2 w-12 bg-cream animate-pulse"></div>
              <div class="h-4 w-10 bg-cream animate-pulse"></div>
            </div>
          ))}
        </div>
        <div class="h-12 w-full bg-cream animate-pulse"></div>
      </div>
    </div>
  </div>
</section>

<!-- Amenities (4 column grid) -->
<section class="bg-warm-white py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="space-y-3 mb-10">
      <div class="h-3 w-20 bg-cream animate-pulse"></div>
      <div class="h-8 w-48 bg-cream animate-pulse"></div>
    </div>
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {Array.from({ length: 4 }).map(() => (
        <div class="space-y-3">
          <div class="h-4 w-24 bg-cream animate-pulse"></div>
          <div class="space-y-2 pt-2">
            <div class="h-3 w-full bg-cream animate-pulse"></div>
            <div class="h-3 w-5/6 bg-cream animate-pulse"></div>
            <div class="h-3 w-3/4 bg-cream animate-pulse"></div>
            <div class="h-3 w-2/3 bg-cream animate-pulse"></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Gallery (3 column 4:3) -->
<section class="bg-white py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="space-y-3 mb-10">
      <div class="h-3 w-16 bg-cream animate-pulse"></div>
      <div class="h-8 w-32 bg-cream animate-pulse"></div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {Array.from({ length: 6 }).map(() => (
        <div class="aspect-[4/3] bg-cream animate-pulse"></div>
      ))}
    </div>
  </div>
</section>
