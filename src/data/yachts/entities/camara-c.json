  "crew": [
    {
      "name": "Eric-Yves Meudal",
      "avatar": "/media/media::image::a::vessel::d5cca2fa-fe8c-11ed-889f-43d4bb723744::assets::35a79830-df48-11ef-ab3e-0b0d23707481/{imageVariant}",
      "role": "Captain",
      "bio": "Eric has more than 25 years' experience in the maritime industry and is Captain on board CAMARA C since 2020. During his career, he has extensively cruised Thailand, Malaysia, Myanmar, Andaman Sea, New Caledonia, but also Australia, New Zealand, and Vanuatu. Eric became Captain of his first yacht in 2016 and gained experience on both charter and private yachts. Eric got his French Master of Law in 1990 and his Captain 200 UMS certificate in 1996. Не is thrilled to work on board the beautiful CAMARA C and he cannot wait to take you around the wonderful land of Thailand."
    },
    {
      "name": "Lee Thai",
      "avatar": "/media/media::image::a::vessel::d5cca2fa-fe8c-11ed-889f-43d4bb723744::assets::5cf5d9b0-df48-11ef-8f59-f1550bd40248/{imageVariant}",
      "role": "Captain",
      "bio": "Lee is an experienced Captain that cruised in Thailand for 14 years and with Captain Eric Meudal for 7 years!"
    },
    {
      "name": "Ailyn Martinez",
      "avatar": "/media/media::image::a::vessel::d5cca2fa-fe8c-11ed-889f-43d4bb723744::assets::97fdd990-df48-11ef-88ae-3d9d4a4df9f2/{imageVariant}",
      "role": "Captain",
      "bio": "Originally from the Philippines, Ailyn joined the yachting industry in 2015. She has been onboard CAMARA C for almost three years now working as a Chief Stewardess. She loves communicating with people and she always aims at providing guests with unforgettable experiences. Ailyn worked on board both motor and sailing yachts up to 40 meters as Chief and Solo Stewardess and Head of the Interior. Her experience has made her flexible with all interior areas and provided her with valuable knowledge and skills. She speaks English and cannot wait to welcome new guests on board CAMARA C."
    },
    {
      "name": "Mark Lin Jaco Eballes",
      "avatar": "/media/media::image::a::vessel::d5cca2fa-fe8c-11ed-889f-43d4bb723744::assets::b6db9d20-df48-11ef-8f59-f1550bd40248/{imageVariant}",
      "role": "Captain",
      "bio": "Originally from the Philippines, Mark is very passionate about his job. He previously worked on CAMARA C in 2019 as First Officer/Deckhand and now is thrilled to be back as Chief Engineer of the yacht with the AECI MCA certification. Mark completed his technical studies in 2017 and is very action orientated and a pro-active solution finder. He will make sure CAMARA C's guests and crew are always in a safe environment."
    },
    {
      "name": "Jomkwan (Kwan) Konklong",
      "avatar": "/media/media::image::a::vessel::d5cca2fa-fe8c-11ed-889f-43d4bb723744::assets::ef32add0-df48-11ef-a655-ad294a2fca08/{imageVariant}",
      "role": "Captain",
      "bio": "Chef Kwan is an International & Thai Food Specialist with three decades of experience in the kitchen. His passion is to enhance the experience of guests abroad Camara C. Kwan's ever positive attitude and beaming smile are the secret ingredients to the delightful culinary experience he delivers daily. A great communicator in Thai & English, he is always eager to cater his menus to his guests desires."
    },
    {
      "name": "Rowena Abello",
      "avatar": "/media/media::image::a::vessel::d5cca2fa-fe8c-11ed-889f-43d4bb723744::assets::1470fb10-df49-11ef-a655-ad294a2fca08/{imageVariant}",
      "role": "Captain",
      "bio": "Rowena is from the Philippines. She has more than four years of experience in the hospitality industry and is comfortable with housekeeping. During her career, she worked as a waitress & front desk manager in a restaurant in Phuket called \"La Dolce Vita\"; as a waitress and cook in a restaurant in Singapore and as a Stewardess on yachts based in Thailand since 2020. Rowena is very passionate about her job, and she will make sure the guests on board CAMARA C have an amazing time."
    },
    {
      "name": "Francis",
      "avatar": "/media/media::image::a::vessel::d5cca2fa-fe8c-11ed-889f-43d4bb723744::assets::3854e870-df49-11ef-a655-ad294a2fca08/{imageVariant}",
      "role": "Captain"
    }
  ],
