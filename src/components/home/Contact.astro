---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import dockImg from "../../assets/dock.png";
---

<section id="contact" class="bg-cream/40 py-24 lg:py-36">
  <Container>
    <div class="grid items-stretch gap-12 lg:grid-cols-2 lg:gap-20">
      <!-- Left: text + form -->
      <div class="flex flex-col">
        <div data-reveal>
          <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">
            Get in Touch
          </p>
          <h2 class="mt-4 text-4xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-5xl lg:text-6xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;">
            Begin Your Journey
          </h2>
        </div>
        <p class="mt-6 text-base leading-relaxed text-taupe" data-reveal>
          Whether you are seeking the perfect charter, looking to buy or sell,
          or need expert yacht management — our team is ready to assist.
        </p>

        <!-- WhatsApp quick CTA -->
        <div class="mt-8 flex items-center gap-4" data-reveal>
          <a
            href="https://wa.me/34971000000?text=Hi%2C%20I%27m%20interested%20in%20your%20yacht%20brokerage%20services."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-fill inline-flex items-center gap-3 border border-charcoal/20 px-8 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-charcoal"
          >
            Message on WhatsApp
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
          <span class="text-xs text-taupe-light">Prefer a quick chat?</span>
        </div>

        <p class="mt-6 text-[11px] font-light tracking-[0.15em] uppercase text-taupe-light/60" data-reveal>Or send us a message</p>

        <form class="mt-4 space-y-6 text-left flex-1 flex flex-col" data-reveal>
          <div class="grid gap-6 sm:grid-cols-2">
            <input
              type="text"
              placeholder="Your Name"
              class="w-full border-b border-beige bg-transparent px-1 py-3 text-sm text-charcoal placeholder:text-taupe-light focus:border-gold focus:outline-none transition-colors duration-300"
            />
            <input
              type="email"
              placeholder="Your Email"
              class="w-full border-b border-beige bg-transparent px-1 py-3 text-sm text-charcoal placeholder:text-taupe-light focus:border-gold focus:outline-none transition-colors duration-300"
            />
          </div>
          <textarea
            placeholder="Tell us about your inquiry..."
            rows={4}
            class="w-full border-b border-beige bg-transparent px-1 py-3 text-sm text-charcoal placeholder:text-taupe-light focus:border-gold focus:outline-none transition-colors duration-300 resize-none"
          ></textarea>
          <div class="pt-4">
            <button
              type="submit"
              class="btn-fill inline-flex items-center gap-3 border border-charcoal/20 px-10 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-charcoal cursor-pointer"
            >
              Send Inquiry
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </form>
      </div>

      <!-- Right: dock image -->
      <div class="hidden lg:block relative" data-reveal="right">
        <Image
          src={dockImg}
          alt="Yacht at dock"
          class="w-full h-full object-cover"
          widths={[600, 900]}
          loading="lazy"
        />
      </div>
    </div>
  </Container>
</section>
