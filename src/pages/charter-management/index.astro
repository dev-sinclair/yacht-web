---
import { Image } from "astro:assets";
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import Container from "../../components/ui/Container.astro";
import heroImg from "../../assets/pano2.jpg";
import portraitImg from "../../assets/dock.jpg";

const WHATSAPP_HREF =
  "https://wa.me/34971000000?text=Hi%2C%20I%27d%20like%20to%20discuss%20charter%20management%20with%20Sinclair.";

const pillars = [
  { label: "Operations", text: "Day-to-day running, fuel, provisioning and port logistics handled without surprises." },
  { label: "Crew", text: "Recruitment, training, payroll and visas. Quietly retained and properly rewarded." },
  { label: "Finance", text: "Transparent reporting, monthly P&L and budget oversight you can act on." },
  { label: "Compliance", text: "Flag state, surveys, MLC and class — kept current so the yacht stays cleared to sail." },
];

const steps = [
  {
    n: "01",
    title: "Audit",
    text: "We open with a private review: Current contracts, accounts, crew, systems and condition. Honest, end-to-end, no blame.",
  },
  {
    n: "02",
    title: "Setup",
    text: "Banking, payroll, vendors and compliance moved onto our systems. One handover, no parallel running, no lost data.",
  },
  {
    n: "03",
    title: "Operate",
    text: "Single broker accountable for the entire programme. Issues escalated before they become emergencies, decisions cleared with you, not around you.",
  },
  {
    n: "04",
    title: "Report",
    text: "Monthly P&L, year-end accounts and an annual strategy session. You always know where the yacht stands financially and operationally.",
  },
];
---

<BaseLayout
  title="Charter Management · Sinclair Yachting"
  description="Full-service yacht management. Sinclair runs operations, crew, finance and compliance for owners who want their vessel cared for to the highest standard, year-round."
>
  <Navbar />

  <!-- Hero -->
  <section class="relative h-[70vh] min-h-[520px] w-full overflow-hidden bg-deep">
    <Image
      src={heroImg}
      alt="Yacht moored at sunset"
      class="absolute inset-0 h-full w-full object-cover"
      widths={[1280, 1920]}
      sizes="100vw"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-black/40"></div>

    <div class="absolute bottom-0 left-0 right-0 z-10 px-6 pb-16 sm:px-8 lg:px-12">
      <div class="mx-auto max-w-[1440px]">
        <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold-light/80">
          Management
        </p>
        <h1
          class="mt-4 text-4xl leading-[1.1] tracking-[0.08em] uppercase text-white sm:text-5xl lg:text-6xl xl:text-7xl"
          style="font-family: 'Raleway', sans-serif; font-weight: 300;"
        >
          Charter Management<br />
          done quietly
        </h1>
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-white/80 sm:text-base">
          Operations, crew, finance and compliance — handled end-to-end by a single broker, so the
          yacht arrives in perfect order and the owner is freed from the running of it.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/#contact"
            class="btn-fill-light inline-flex items-center gap-3 border border-white/40 px-7 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-white"
          >
            Speak with a broker
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href={WHATSAPP_HREF}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-2 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-white/80 transition-colors duration-300 hover:text-white"
          >
            Or message on WhatsApp
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Sinclair / pillars -->
  <section class="bg-white py-24 lg:py-32">
    <Container>
      <div class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,480px)] lg:gap-20">
        <!-- Left: intro copy -->
        <div>
          <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">
            Why Sinclair
          </p>
          <h2
            class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;"
          >
            Quiet Standards,<br />
            Year-Round
          </h2>
          <div class="mt-6 h-px w-10 bg-gold/40"></div>
          <p class="mt-8 max-w-xl text-base leading-[1.8] text-taupe">
            A managed yacht should feel like a private residence: Always ready, always accounted for,
            never the subject of an awkward phone call. We take a small number of vessels under
            management at a time, treat each as a programme rather than a portfolio, and let the
            owner spend their attention elsewhere.
          </p>

          <!-- Pillars -->
          <div class="mt-12 grid grid-cols-2 gap-y-8 gap-x-8">
            {pillars.map((p) => (
              <div>
                <p
                  class="text-xl font-light tracking-[0.25em] uppercase text-charcoal sm:text-2xl"
                  style="font-family: 'Raleway', sans-serif; font-weight: 300;"
                >
                  {p.label}
                </p>
                <p class="mt-2 text-sm leading-[1.7] text-taupe">{p.text}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: portrait image -->
        <div class="relative hidden lg:block">
          <div class="relative aspect-[4/5] w-full overflow-hidden">
            <Image
              src={portraitImg}
              alt="Yacht in port"
              class="absolute inset-0 h-full w-full object-cover"
              widths={[600, 900, 1200]}
              sizes="(min-width: 1024px) 480px, 100vw"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Process -->
  <section class="bg-cream/40 py-24 lg:py-32">
    <Container>
      <div class="max-w-3xl">
        <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">The Process</p>
        <h2
          class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
          style="font-family: 'Raleway', sans-serif; font-weight: 300;"
        >
          A Single Handover, A Single Point of Contact
        </h2>
        <div class="mt-6 h-px w-10 bg-gold/40"></div>
      </div>

      <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step) => (
          <div class="border-t border-deep/15 pt-6">
            <p class="num text-[11px] font-medium tracking-[0.25em] text-gold">{step.n}</p>
            <h3
              class="mt-4 text-xl font-light tracking-[0.15em] uppercase text-charcoal"
              style="font-family: 'Raleway', sans-serif; font-weight: 300;"
            >
              {step.title}
            </h3>
            <p class="mt-4 text-sm leading-[1.75] text-taupe">{step.text}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Closing CTA -->
  <section class="bg-white py-24 lg:py-32 text-center">
    <Container>
      <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">Ready When You Are</p>
      <h2
        class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
        style="font-family: 'Raleway', sans-serif; font-weight: 300;"
      >
        Begin a Confidential Conversation
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-taupe">
        An initial audit costs nothing and is entirely private. We'll review the current state of
        the yacht, the operating costs, and whether our way of working would suit yours. With no
        obligation either way.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/#contact"
          class="btn-fill inline-flex items-center gap-3 border border-deep/20 px-8 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-charcoal"
        >
          Request an audit
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href={WHATSAPP_HREF}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-2 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-taupe transition-colors duration-300 hover:text-charcoal"
        >
          Chat on WhatsApp
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </a>
      </div>
    </Container>
  </section>

  <Footer />
</BaseLayout>
