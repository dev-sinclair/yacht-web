---
import { Image } from "astro:assets";
import logo from "../../assets/logo.png";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const currentPath = Astro.url.pathname;

const links = [
  { label: "Home", href: "/" },
  { label: "Yachts", href: "/catalogue" },
  { label: "Services", href: "/#services" },
  { label: "About", href: "/#about" },
  { label: "Contact", href: "/#contact" },
];
---

<nav
  id="navbar"
  class:list={[
    "fixed top-0 left-0 z-50 w-full transition-all duration-700",
    transparent ? "bg-transparent py-7" : "bg-white/95 py-5 backdrop-blur-md",
  ]}
  data-transparent={transparent ? "" : undefined}
>
  <div class="mx-auto flex max-w-[1440px] items-center justify-between px-6 sm:px-8 lg:px-12">
    <!-- Hamburger menu — thin minimalist lines -->
    <button
      id="menu-toggle"
      class="flex flex-col gap-[6px] z-50 hover:cursor-pointer p-3"
      aria-label="Toggle menu"
    >
      <span class="block h-px w-6 transition-all duration-300" id="bar1"
        style={transparent ? "background-color: white" : "background-color: #151A24"}></span>
      <span class="block h-px w-6 transition-all duration-300" id="bar2"
        style={transparent ? "background-color: white" : "background-color: #151A24"}></span>
    </button>

    <!-- Center logo + text -->
    <a href="/" class="absolute left-1/2 -translate-x-1/2 flex items-center gap-3">
      <Image
        src={logo}
        alt="Sinclair Yachting"
        class:list={[
          "h-10 w-auto sm:h-12 transition-all duration-300",
          transparent ? "brightness-0 invert" : "",
        ]}
        widths={[120, 200]}
        loading="eager"
      />
      <span
        id="logo-text"
        class:list={[
          "hidden sm:inline text-[11px] font-light tracking-[0.25em] uppercase transition-colors duration-300",
          transparent ? "text-white" : "text-charcoal",
        ]}
        style="font-family: 'Raleway', sans-serif; font-weight: 300;"
      >
        Sinclair Yachting
      </span>
    </a>

    <!-- Empty right spacer to keep logo centered -->
    <div class="w-6"></div>
  </div>
</nav>

<!-- Fullscreen overlay menu -->
<div
  id="overlay-menu"
  class="fixed inset-0 z-40 flex items-center justify-center bg-white/80 backdrop-blur-xl opacity-0 pointer-events-none transition-all duration-500"
>
  <ul class="flex flex-col items-center gap-8">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class="overlay-link text-3xl tracking-[0.2em] uppercase text-charcoal transition-colors duration-300 hover:text-gold sm:text-4xl"
          style="font-family: 'Raleway', sans-serif; font-weight: 300;"
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  const navbar = document.getElementById("navbar")!;
  const toggle = document.getElementById("menu-toggle")!;
  const overlay = document.getElementById("overlay-menu")!;
  const isTransparent = navbar.hasAttribute("data-transparent");
  const bar1 = document.getElementById("bar1")!;
  const bar2 = document.getElementById("bar2")!;

  function updateBarColors(scrolled: boolean) {
    const color = (menuOpen || scrolled || !isTransparent) ? "#151A24" : "white";
    bar1.style.backgroundColor = color;
    bar2.style.backgroundColor = color;
  }

  if (isTransparent) {
    const onScroll = () => {
      const scrolled = window.scrollY > 80;
      if (scrolled) {
        navbar.classList.remove("bg-transparent", "py-7");
        navbar.classList.add("bg-white/95", "backdrop-blur-md", "py-5");
      } else {
        navbar.classList.add("bg-transparent", "py-7");
        navbar.classList.remove("bg-white/95", "backdrop-blur-md", "py-5");
      }
      if (!menuOpen) updateBarColors(scrolled);
      // Update logo + text
      const logoImg = navbar.querySelector("img");
      const logoText = document.getElementById("logo-text");
      if (logoImg) {
        if (scrolled || menuOpen) {
          logoImg.classList.remove("brightness-0", "invert");
        } else {
          logoImg.classList.add("brightness-0", "invert");
        }
      }
      if (logoText) {
        if (scrolled || menuOpen) {
          logoText.classList.remove("text-white");
          logoText.classList.add("text-charcoal");
        } else {
          logoText.classList.add("text-white");
          logoText.classList.remove("text-charcoal");
        }
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  let menuOpen = false;
  toggle.addEventListener("click", () => {
    menuOpen = !menuOpen;
    if (menuOpen) {
      overlay.classList.remove("opacity-0", "pointer-events-none");
      overlay.classList.add("opacity-100", "pointer-events-auto");
      bar1.style.transform = "rotate(45deg) translate(3px, 3.5px)";
      bar2.style.transform = "rotate(-45deg) translate(3px, -3.5px)";
      document.body.style.overflow = "hidden";
    } else {
      overlay.classList.add("opacity-0", "pointer-events-none");
      overlay.classList.remove("opacity-100", "pointer-events-auto");
      bar1.style.transform = "";
      bar2.style.transform = "";
      document.body.style.overflow = "";
    }
    updateBarColors(window.scrollY > 80);
    // Update logo + text on menu toggle
    const logoImg = navbar.querySelector("img");
    const logoText = document.getElementById("logo-text");
    if (logoImg && isTransparent) {
      if (menuOpen || window.scrollY > 80) {
        logoImg.classList.remove("brightness-0", "invert");
      } else {
        logoImg.classList.add("brightness-0", "invert");
      }
    }
    if (logoText && isTransparent) {
      if (menuOpen || window.scrollY > 80) {
        logoText.classList.remove("text-white");
        logoText.classList.add("text-charcoal");
      } else {
        logoText.classList.add("text-white");
        logoText.classList.remove("text-charcoal");
      }
    }
  });

  // Close menu on link click
  overlay.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => {
      menuOpen = false;
      overlay.classList.add("opacity-0", "pointer-events-none");
      overlay.classList.remove("opacity-100", "pointer-events-auto");
      bar1.style.transform = "";
      bar2.style.transform = "";
      document.body.style.overflow = "";
      updateBarColors(window.scrollY > 80);
    });
  });
</script>
