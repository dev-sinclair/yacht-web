---
import { Image } from "astro:assets";
import logo from "../../assets/logo.png";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const links = [
  { label: "About", href: "/#about" },
  { label: "Yacht Charter", href: "/yachts" },
  { label: "Destinations", href: "/destinations" },
  { label: "Services", href: "/#services" },
  { label: "Contact", href: "/#contact" },
];
---

<nav
  id="navbar"
  class:list={[
    "fixed top-0 left-0 z-50 w-full transition-all duration-700",
    transparent ? "nav-fade-bottom bg-charcoal/30 py-7 backdrop-blur-md" : "bg-white/95 py-5 backdrop-blur-md",
  ]}
  data-transparent={transparent ? "" : undefined}
>
  <div class="mx-auto flex max-w-[1440px] items-center justify-between px-6 sm:px-8 lg:px-12">
    <!-- Left: inline section links -->
    <ul class="hidden md:flex items-center gap-8 lg:gap-10">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "nav-link text-[11px] font-medium tracking-[0.25em] uppercase transition-colors duration-300 hover:text-gold",
              transparent ? "text-white" : "text-charcoal",
            ]}
            style="font-family: 'Raleway', sans-serif;"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile fallback: small toggle for the inline list on narrow screens -->
    <button
      id="menu-toggle"
      class="flex md:hidden flex-col gap-[6px] hover:cursor-pointer p-3"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="block h-px w-6 transition-all duration-300" id="bar1"
        style={transparent ? "background-color: white" : "background-color: #151A24"}></span>
      <span class="block h-px w-6 transition-all duration-300" id="bar2"
        style={transparent ? "background-color: white" : "background-color: #151A24"}></span>
    </button>

    <!-- Right: logo -->
    <div class="flex items-center gap-4 sm:gap-6">
      <a href="/" class="flex items-center gap-3">
        <span
          id="logo-text"
          class:list={[
            "hidden sm:inline text-[11px] font-light tracking-[0.25em] uppercase transition-colors duration-300",
            transparent ? "text-white" : "text-charcoal",
          ]}
          style="font-family: 'Raleway', sans-serif; font-weight: 300;"
        >
          Sinclair Yachting
        </span>
        <Image
          src={logo}
          alt="Sinclair Yachting"
          class="h-10 w-auto sm:h-12 transition-all duration-300"
          widths={[120, 200]}
          loading="eager"
        />
      </a>
    </div>
  </div>

  <style>
    /* When the navbar is over a dark section, fade the bottom edge so the
       blurred background dissolves into the section beneath instead of
       showing a hard line. */
    .nav-fade-bottom {
      -webkit-mask-image: linear-gradient(to bottom, black calc(100% - 40px), transparent 100%);
      mask-image: linear-gradient(to bottom, black calc(100% - 40px), transparent 100%);
    }
  </style>

  <!-- Mobile dropdown panel (compact, NOT fullscreen) -->
  <div
    id="mobile-panel"
    class="md:hidden overflow-hidden max-h-0 transition-[max-height] duration-500 ease-out"
  >
    <ul class="flex flex-col gap-4 px-6 py-6 border-t border-white/10">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "nav-link block text-[11px] font-medium tracking-[0.25em] uppercase transition-colors duration-300 hover:text-gold",
              transparent ? "text-white" : "text-charcoal",
            ]}
            style="font-family: 'Raleway', sans-serif;"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const navbar = document.getElementById("navbar")!;
  const toggle = document.getElementById("menu-toggle")!;
  const mobilePanel = document.getElementById("mobile-panel")!;
  const isTransparent = navbar.hasAttribute("data-transparent");
  const bar1 = document.getElementById("bar1")!;
  const bar2 = document.getElementById("bar2")!;

  let menuOpen = false;

  // Sections with dark backgrounds where the navbar should render transparent.
  const darkSectionIds = ["hero", "services", "destinations-section", "destination-detail-hero"];
  const navHeight = 80;

  function isOverDarkSection() {
    for (const id of darkSectionIds) {
      const el = document.getElementById(id);
      if (!el) continue;
      const rect = el.getBoundingClientRect();
      if (rect.top < navHeight && rect.bottom > 0) return true;
    }
    return false;
  }

  function updateBarColors(white: boolean) {
    const color = (menuOpen || white || !isTransparent) ? "#151A24" : "white";
    bar1.style.backgroundColor = color;
    bar2.style.backgroundColor = color;
  }

  function setLinkColors(white: boolean) {
    const items = navbar.querySelectorAll<HTMLElement>(
      ".nav-link, .currency-btn, .currency-divider",
    );
    items.forEach((item) => {
      if (white) {
        item.classList.remove("text-white");
        item.classList.add("text-charcoal");
      } else {
        item.classList.add("text-white");
        item.classList.remove("text-charcoal");
      }
    });
  }

  function applyState() {
    if (!isTransparent) return;
    const showTransparent = isOverDarkSection();

    if (showTransparent) {
      navbar.classList.add("bg-charcoal/30", "py-7", "backdrop-blur-md", "nav-fade-bottom");
      navbar.classList.remove("bg-white/95", "py-5");
    } else {
      navbar.classList.remove("bg-charcoal/30", "py-7", "nav-fade-bottom");
      navbar.classList.add("bg-white/95", "backdrop-blur-md", "py-5");
    }

    const wantDark = !showTransparent || menuOpen;
    if (!menuOpen) updateBarColors(!showTransparent);
    setLinkColors(wantDark);

    const logoText = document.getElementById("logo-text");
    if (logoText) {
      if (wantDark) {
        logoText.classList.remove("text-white");
        logoText.classList.add("text-charcoal");
      } else {
        logoText.classList.add("text-white");
        logoText.classList.remove("text-charcoal");
      }
    }
  }

  if (isTransparent) {
    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          applyState();
          ticking = false;
        });
        ticking = true;
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", applyState, { passive: true });
    applyState();
  }

  toggle.addEventListener("click", () => {
    menuOpen = !menuOpen;
    toggle.setAttribute("aria-expanded", String(menuOpen));
    if (menuOpen) {
      mobilePanel.style.maxHeight = mobilePanel.scrollHeight + "px";
      bar1.style.transform = "rotate(45deg) translate(3px, 3.5px)";
      bar2.style.transform = "rotate(-45deg) translate(3px, -3.5px)";
    } else {
      mobilePanel.style.maxHeight = "0px";
      bar1.style.transform = "";
      bar2.style.transform = "";
    }
    applyState();
  });

  // Close mobile panel on link click
  mobilePanel.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menuOpen = false;
      toggle.setAttribute("aria-expanded", "false");
      mobilePanel.style.maxHeight = "0px";
      bar1.style.transform = "";
      bar2.style.transform = "";
      applyState();
    });
  });
</script>
