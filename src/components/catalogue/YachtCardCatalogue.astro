---
import type { Yacht } from "../../data/types/yacht";
import { formatPrice, formatLength } from "../../data/yacht-service";

interface Props {
  yacht: Yacht;
}

const { yacht } = Astro.props;
const image = yacht.images[0];
const price = formatPrice(yacht.dayPricingFrom, yacht.currency);
---

<a
  href={`/catalogue/${yacht.slug}`}
  class="group block border border-beige/60 bg-white transition-all duration-500 hover:bg-charcoal hover:border-charcoal hover:shadow-lg"
  data-yacht-type={yacht.yachtType[0]}
  data-yacht-length={yacht.blueprint.length}
  data-yacht-guests={yacht.blueprint.sleeps}
  data-yacht-price={yacht.dayPricingFrom || 0}
>
  <!-- Header: Name + Price -->
  <div class="flex items-start justify-between px-5 pt-5 pb-3">
    <h3 class="text-lg tracking-[0.1em] uppercase text-charcoal transition-colors duration-500 group-hover:text-white sm:text-xl"
      style="font-family: 'Raleway', sans-serif; font-weight: 500;">
      {yacht.blueprint.name}
    </h3>
    <div class="text-right shrink-0 ml-3">
      <p class="text-[9px] font-medium tracking-[0.15em] uppercase text-taupe-light transition-colors duration-500 group-hover:text-white/50">Price from</p>
      <p class="num text-sm tracking-[0.05em] text-charcoal transition-colors duration-500 group-hover:text-white sm:text-base">
        {price}{yacht.dayPricingFrom ? " / Day" : ""}
      </p>
    </div>
  </div>

  <!-- Specs row -->
  <div class="grid grid-cols-4 border-t border-beige/60 px-5 py-2.5 transition-colors duration-500 group-hover:border-white/10">
    <div>
      <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light transition-colors duration-500 group-hover:text-white/40">Length</p>
      <p class="num mt-0.5 text-[11px] text-charcoal transition-colors duration-500 group-hover:text-white/80">{formatLength(yacht.blueprint.length)}</p>
    </div>
    <div>
      <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light transition-colors duration-500 group-hover:text-white/40">Guests</p>
      <p class="num mt-0.5 text-[11px] text-charcoal transition-colors duration-500 group-hover:text-white/80">{yacht.blueprint.sleeps}</p>
    </div>
    <div>
      <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light transition-colors duration-500 group-hover:text-white/40">Year</p>
      <p class="num mt-0.5 text-[11px] text-charcoal transition-colors duration-500 group-hover:text-white/80">{yacht.blueprint.buildYear}</p>
    </div>
    <div>
      <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light transition-colors duration-500 group-hover:text-white/40">Cabins</p>
      <p class="num mt-0.5 text-[11px] text-charcoal transition-colors duration-500 group-hover:text-white/80">{yacht.cabins.total}</p>
    </div>
  </div>

  <!-- Image -->
  <div class="aspect-[16/9] overflow-hidden bg-cream">
    <img
      src={image.url}
      alt={image.alt}
      class="h-full w-full object-cover"
      loading="lazy"
      width="600"
      height="338"
    />
  </div>
</a>
