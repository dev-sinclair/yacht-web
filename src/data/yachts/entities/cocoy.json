  "crew": [
    {
      "name": "TIAGO GONÇALVES ARGOLO",
      "avatar": "/media/media::image::c::17338971224::vessel::1228a120-68fa-11ef-a710-5b623bea5cd1::assets::db47e540-65a4-11f1-9cad-6fef5d61686d/{imageVariant}",
      "role": "Captain",
      "bio": "Tiago is a Spanish Captain with 25 years of experience in the maritime sector, bringing a calm, seasoned presence to every voyage. He has commanded both sailing and motor yachts of up to 43 metres, cruising extensively across the Mediterranean, the Caribbean and the U.S. East Coast, and has successfully completed numerous Atlantic crossings. He combines deep technical knowledge with a refined approach to private and charter operations. Speaking Spanish, English, Portuguese, Italian and Catalan,."
    },
    {
      "name": "MERISHEN WESSELS",
      "avatar": "/media/media::image::c::17338971224::vessel::1228a120-68fa-11ef-a710-5b623bea5cd1::assets::f3ce6df0-65a4-11f1-b666-5b69fe490ad6/{imageVariant}",
      "role": "Captain",
      "bio": "Merishen brings a unique blend of creativity, warmth and refined attention to detail to every charter. She draws on an award-winning 17-year career as a Production Designer and Art Director in the South African film and television industry, where she developed a deep appreciation for aesthetics, presentation and seamless guest experiences. Energetic, calm under pressure and genuinely devoted to making every onboard moment special, including for the kids."
    },
    {
      "name": "EZINTLE MONDILE ",
      "avatar": "/media/media::image::c::17338971224::vessel::1228a120-68fa-11ef-a710-5b623bea5cd1::assets::055d3600-65a5-11f1-9d92-9504d959ef2f/{imageVariant}",
      "role": "Captain",
      "bio": "Ezintle brings warmth and a genuine love of the sea to every charter. Raised in South Africa, spent time on sea both in her home country and in the mediterranean. Fully trained across both interior and exterior. Ezintle, or Ezzy for friends, combines a positive, adaptable attitude with the attention to detail guests expect aboard a luxury yacht."
    }
