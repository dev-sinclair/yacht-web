---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Container from "../../components/ui/Container.astro";
import YachtHero from "../../components/yacht/YachtHero.astro";
import YachtSpecs from "../../components/yacht/YachtSpecs.astro";
import YachtAmenities from "../../components/yacht/YachtAmenities.astro";
import YachtGallery from "../../components/yacht/YachtGallery.astro";
import YachtInquiry from "../../components/yacht/YachtInquiry.astro";
import Footer from "../../components/layout/Footer.astro";
import { getYachtBySlug, formatPrice } from "../../data/yacht-service";

const { slug } = Astro.params;
const yacht = slug ? await getYachtBySlug(slug) : null;

// Slug not in Ankor (delisted, renamed, or never existed) — fall back to the
// catalogue page so the user always lands somewhere useful.
if (!yacht) {
  return Astro.redirect("/yachts", 302);
}

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=86400, stale-while-revalidate=604800",
);

const price = formatPrice(yacht.dayPricingFrom, yacht.currency);
const waUrl = `https://wa.me/34971000000?text=${encodeURIComponent(`Hi, I'm interested in chartering ${yacht.blueprint.name}. Can you send me more details?`)}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: yacht.blueprint.name,
  description: yacht.description,
  image: yacht.images[0]?.url,
  brand: { "@type": "Brand", name: yacht.blueprint.builder },
  ...(yacht.dayPricingFrom ? {
    offers: {
      "@type": "Offer",
      priceCurrency: yacht.currency,
      price: (yacht.dayPricingFrom / 100).toString(),
      availability: "https://schema.org/InStock",
    },
  } : {}),
};
---

<BaseLayout
  title={`${yacht.blueprint.name} — Charter | Sinclair Yachting`}
  description={yacht.description.slice(0, 160)}
>
  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Navbar transparent />

  <main>
    <YachtHero yacht={yacht} />
    <YachtSpecs yacht={yacht} />

    <!-- Description + pricing -->
    <section class="bg-white py-16 lg:py-20">
      <Container>
        <div class="grid gap-12 lg:grid-cols-[1fr_380px] lg:gap-20">
          <!-- Description -->
          <div data-reveal>
            <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">Overview</p>
            <h2 class="mt-3 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl"
              style="font-family: 'Raleway', sans-serif; font-weight: 300;">
              About {yacht.blueprint.name}
            </h2>
            <p class="mt-6 text-base leading-[1.8] text-taupe">
              {yacht.description}
            </p>
            {yacht.geographicZones.length > 0 && (
              <div class="mt-6">
                <p class="text-xs font-medium tracking-[0.1em] uppercase text-taupe-light mb-2">Cruising Areas</p>
                <div class="flex flex-wrap gap-2">
                  {yacht.geographicZones.map((zone) => (
                    <span class="px-3 py-1 text-[10px] font-medium tracking-[0.1em] uppercase border border-beige/60 text-taupe">
                      {zone}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Pricing card -->
          <div class="lg:sticky lg:top-28 self-start" data-reveal>
            <div class="border border-beige/60 p-6">
              <p class="text-[10px] font-medium tracking-[0.15em] uppercase text-taupe-light">Charter from</p>
              <p class="num mt-1 text-2xl tracking-[0.05em] text-charcoal sm:text-3xl">
                {price}
                {yacht.dayPricingFrom ? (<span class="text-base text-taupe-light font-light"> / day</span>) : null}
              </p>

              <div class="mt-6 grid grid-cols-2 gap-3 border-t border-beige/40 pt-6">
                <div>
                  <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light">Length</p>
                  <p class="num mt-0.5 text-sm text-charcoal">{yacht.blueprint.length}m</p>
                </div>
                <div>
                  <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light">Guests</p>
                  <p class="num mt-0.5 text-sm text-charcoal">{yacht.blueprint.sleeps}</p>
                </div>
                <div>
                  <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light">Cabins</p>
                  <p class="num mt-0.5 text-sm text-charcoal">{yacht.cabins.total}</p>
                </div>
                <div>
                  <p class="text-[8px] font-medium tracking-[0.15em] uppercase text-taupe-light">Crew</p>
                  <p class="num mt-0.5 text-sm text-charcoal">{yacht.crew.length}</p>
                </div>
              </div>

              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-fill mt-6 w-full inline-flex items-center justify-center gap-3 border border-charcoal/20 px-6 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-charcoal"
              >
                Inquire on WhatsApp
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <YachtAmenities yacht={yacht} />
    <YachtGallery images={yacht.images} yachtName={yacht.blueprint.name} />
    <YachtInquiry yachtName={yacht.blueprint.name} />
  </main>

  <Footer />
</BaseLayout>
