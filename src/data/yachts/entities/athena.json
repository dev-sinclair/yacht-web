  "crew": [
    {
      "name": "David Stone",
      "avatar": "/media/media::image::a::vessel::b11b5ca0-a516-11f1-a348-4533e8d3f661::assets::4b5e5750-a51b-11f1-8519-43f2e750a9df/{imageVariant}",
      "role": "Captain",
      "bio": "David is an experienced sailor with over 45 years of sailing across inland and offshore waters, including extensive time in the British Virgin Islands and the Mediterranean. His previous career in educational leadership developed strong skills in communication and problem-solving, and he approaches every charter with a focus on preparation, safety, and attentive guest service. Outside of sailing, David is passionate about watersports and adventure. He has windsurfed, worked as a professional whitewater raft guide, and is an experienced Class V whitewater kayaker with expedition experience on numerous rivers across the United States. For David, chartering is about more than navigating from one destination to another. He enjoys sharing the places he loves, helping guests feel comfortable and confident on the water, and creating a relaxed, well-run experience where everyone can make the most of their time together. His goal is for guests to feel safe, cared for, and free to enjoy the adventure from the moment they step aboard."
    },
    {
      "name": "Stephanie Stone",
      "avatar": "/media/media::image::a::vessel::b11b5ca0-a516-11f1-a348-4533e8d3f661::assets::5c2ab9c0-a51b-11f1-8519-43f2e750a9df/{imageVariant}",
      "role": "Captain",
      "bio": "Stephanie brings a love of cooking, hospitality, and life on the water to every charter. She is highly skilled at managing everything from menu planning and provisioning to creating\n\nfresh, thoughtful dishes, and she particularly enjoys creating food that feels both special and approachable, using the freshest ingredients available to create meals that bring people together. Stephanie's culinary style prioritizes fresh, locally sourced ingredients and vibrant flavors. She is currently expanding her professional culinary training at Ballymaloe Cookery School in Ireland and Ashburton Cookery School in England and is looking\n\nforward to bringing fresh menu ideas to each charter experience. For Stephanie, some of the best moments of a charter happen around the table, and she loves creating meals and experiences that guests will remember long after their time on the water."
    }
  ],
