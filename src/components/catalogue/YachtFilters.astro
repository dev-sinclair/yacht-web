---
import type { YachtFacets } from "../../data/types/yacht";
import { getAllRegions } from "../../lib/destinations/registry";
import { YACHT_CATEGORIES, YACHT_SEASONS, formatSeason } from "../../data/yacht-service";

interface Props {
  facets: YachtFacets;
  activeType?: string;
  activeRegion?: string;
  activeLocation?: string;
  activeSeason?: string;
}

const {
  facets,
  activeType = "",
  activeRegion = "",
  activeLocation = "",
  activeSeason = "",
} = Astro.props;

const regions = getAllRegions();

const activeRegionForLabel = activeRegion ? regions.find((r) => r.slug === activeRegion) : undefined;
const activeLocationForLabel =
  activeRegionForLabel && activeLocation
    ? activeRegionForLabel.locations.find((l) => l.slug === activeLocation)
    : undefined;
const locationButtonLabel =
  activeLocationForLabel?.name ?? activeRegionForLabel?.name ?? "All locations";

function withParam(base: Record<string, string>, key: string, value: string): string {
  const params = new URLSearchParams();
  for (const [k, v] of Object.entries(base)) if (v) params.set(k, v);
  if (value) params.set(key, value);
  else params.delete(key);
  const qs = params.toString();
  return qs ? `/yachts?${qs}` : "/yachts";
}

// Region/location URL helpers: a region link drops any active location;
// a location link keeps both region and location set (the API needs both).
function regionHref(regionSlug: string): string {
  return withParam(
    { yachtType: activeType, season: activeSeason },
    "region",
    regionSlug,
  );
}

function locationHref(regionSlug: string, locationSlug: string): string {
  const params = new URLSearchParams();
  if (activeType) params.set("yachtType", activeType);
  if (activeSeason) params.set("season", activeSeason);
  params.set("region", regionSlug);
  params.set("location", locationSlug);
  return `/yachts?${params.toString()}`;
}

// 24m is the lowest eligible length (catamaran cutoff); non-catamarans start
// at 30m. See isEligibleYacht in yacht-service.ts.
const LENGTH_MIN = 24;
const LENGTH_MAX = 150;
const LENGTH_STEP = 1;

const GUESTS_MIN = 1;
// 12 is a hard cap globally (see isEligibleYacht in yacht-service.ts) —
// no yacht in the catalog can exceed it, so the upper bound is firm rather
// than a "+" soft-max.
const GUESTS_MAX = 12;
const GUESTS_STEP = 1;

const PRICE_MIN = 0;
const PRICE_STEP = 5_000;
// Adapt the price slider's upper bound to the most expensive yacht in the
// eligible catalog (facets.priceRange.max comes from yacht-service.getFacets
// in EUR cents). Round up to the nearest €50k so the cap reads cleanly, and
// floor at €500k so an empty/sparse catalog doesn't collapse the slider.
const PRICE_MAX = Math.max(
  500_000,
  Math.ceil(facets.priceRange.max / 100 / 50_000) * 50_000,
);

const pillClass = (selected: boolean) =>
  selected
    ? "filter-pill flex min-h-8 w-full items-center justify-center px-1.5 py-1 text-center text-[8px] font-medium tracking-[0.08em] uppercase leading-tight border border-deep bg-deep text-white transition-all duration-300"
    : "filter-pill flex min-h-8 w-full items-center justify-center px-1.5 py-1 text-center text-[8px] font-medium tracking-[0.08em] uppercase leading-tight border border-deep/20 text-charcoal transition-all duration-300 hover:bg-deep hover:text-white";

const sectionLabelClass = "text-[10px] font-medium tracking-[0.2em] uppercase text-taupe-light";
const numInputClass = "w-full px-2 py-2 text-xs tracking-[0.05em] border border-deep/20 text-charcoal bg-transparent transition-colors duration-300 focus:outline-none focus:border-deep";

const regionHeaderClass = (active: boolean) =>
  active
    ? "block w-full px-2 py-1 text-[11px] font-semibold tracking-[0.15em] uppercase bg-deep text-white transition-colors duration-200"
    : "block w-full px-2 py-1 text-[11px] font-semibold tracking-[0.15em] uppercase text-charcoal transition-colors duration-200 hover:text-deep";

const locationItemClass = (active: boolean) =>
  active
    ? "block w-full pl-4 pr-2 py-1 text-[11px] font-light tracking-[0.05em] bg-deep text-white transition-colors duration-200"
    : "block w-full pl-4 pr-2 py-1 text-[11px] font-light tracking-[0.05em] text-deep transition-colors duration-200 hover:text-charcoal";
---

<aside id="yacht-filters" class="space-y-5">
  <!-- Type pills -->
  <div>
    <p class={sectionLabelClass}>Type</p>
    <div class="mt-2 grid grid-cols-2 gap-1.5">
      <a class={pillClass(activeType === "")} href={withParam({ region: activeRegion, location: activeLocation, season: activeSeason }, "yachtType", "")}>All</a>
      {YACHT_CATEGORIES.map((type) => (
        <a class={pillClass(activeType === type)} href={withParam({ region: activeRegion, location: activeLocation, season: activeSeason }, "yachtType", type)}>{type}</a>
      ))}
    </div>
  </div>

  <!-- Season select -->
  <div>
    <p class={sectionLabelClass}>Season</p>
    <div class="relative mt-2">
      <select
        id="filter-season"
        class="num w-full appearance-none border border-deep/20 bg-transparent px-3 py-2.5 pr-9 text-xs tracking-[0.05em] text-charcoal transition-colors duration-300 focus:outline-none focus:border-deep cursor-pointer"
      >
        <option value="">All seasons</option>
        {YACHT_SEASONS.map((s) => (
          <option value={s} selected={activeSeason === s}>{formatSeason(s)}</option>
        ))}
      </select>
      <svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-3 h-3 text-taupe-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
    {activeSeason && (
      <a
        href={withParam({ yachtType: activeType, region: activeRegion, location: activeLocation }, "season", "")}
        class="mt-2 inline-flex items-center gap-1 text-[10px] font-medium tracking-[0.2em] uppercase text-taupe transition-colors duration-300 hover:text-charcoal"
      >
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
        Clear season
      </a>
    )}
  </div>

  <!-- Location dropdown: button opens a panel with the nested region/location tree -->
  <div>
    <p class={sectionLabelClass}>Location</p>
    <div class="relative mt-2" data-location-dropdown>
      <button
        id="filter-location-button"
        type="button"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls="filter-location-panel"
        class="num w-full appearance-none border border-deep/20 bg-transparent px-3 py-2.5 pr-9 text-xs tracking-[0.05em] text-charcoal transition-colors duration-300 focus:outline-none focus:border-deep cursor-pointer text-left"
      >
        <span data-location-label class="block truncate">{locationButtonLabel}</span>
      </button>
      <svg
        class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-3 h-3 text-taupe-light transition-transform duration-200"
        data-location-chevron
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>

      <div
        id="filter-location-panel"
        hidden
        class="absolute left-0 right-0 top-full z-30 mt-1 max-h-96 overflow-y-auto border border-deep/20 bg-white shadow-lg"
        role="listbox"
        tabindex="-1"
      >
        <ul class="py-1 space-y-1">
          <li>
            <a
              href="/yachts"
              class={regionHeaderClass(!activeRegion && !activeLocation)}
            >
              All locations
            </a>
          </li>
          {regions.map((region) => (
            <li>
              <a
                href={regionHref(region.slug)}
                class={regionHeaderClass(activeRegion === region.slug && !activeLocation)}
              >
                {region.name}
              </a>
              {region.locations.length > 0 && (
                <ul class="mt-0.5 space-y-0.5">
                  {region.locations.map((loc) => (
                    <li>
                      <a
                        href={locationHref(region.slug, loc.slug)}
                        class={locationItemClass(activeRegion === region.slug && activeLocation === loc.slug)}
                      >
                        {loc.name}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
    {(activeRegion || activeLocation) && (
      <a
        href={withParam({ yachtType: activeType, season: activeSeason }, "region", "")}
        class="mt-2 inline-flex items-center gap-1 text-[10px] font-medium tracking-[0.2em] uppercase text-taupe transition-colors duration-300 hover:text-charcoal"
      >
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
        Clear location
      </a>
    )}
  </div>

  <!-- Search -->
  <div>
    <label class={sectionLabelClass} for="filter-search">Name &amp; builder</label>
    <div class="relative mt-2">
      <input
        id="filter-search"
        type="search"
        placeholder="Name or builder…"
        class="w-full px-3 py-2.5 pr-9 text-xs tracking-[0.05em] border border-deep/20 text-charcoal bg-transparent transition-colors duration-300 focus:outline-none focus:border-deep placeholder:text-taupe-light/70"
        autocomplete="off"
      />
      <svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-taupe-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
    </div>
  </div>

  <!-- Length range -->
  <div>
    <p class={sectionLabelClass}>Length (m)</p>
    <div class="mt-2 flex items-center gap-2">
      <input id="filter-length-min-num" type="number" min={LENGTH_MIN} max={LENGTH_MAX} step={LENGTH_STEP} value={LENGTH_MIN} class={numInputClass} aria-label="Minimum length" />
      <span class="text-[10px] tracking-[0.2em] uppercase text-taupe-light">to</span>
      <input id="filter-length-max-num" type="number" min={LENGTH_MIN} max={LENGTH_MAX} step={LENGTH_STEP} value={LENGTH_MAX} class={numInputClass} aria-label="Maximum length" />
    </div>
    <div class="range-slider mt-3 relative h-5">
      <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-px bg-deep/20"></div>
      <div id="filter-length-track" class="absolute top-1/2 -translate-y-1/2 h-px bg-deep"></div>
      <input id="filter-length-min" type="range" min={LENGTH_MIN} max={LENGTH_MAX} step={LENGTH_STEP} value={LENGTH_MIN} class="range-input absolute inset-0 w-full" aria-label="Minimum length" />
      <input id="filter-length-max" type="range" min={LENGTH_MIN} max={LENGTH_MAX} step={LENGTH_STEP} value={LENGTH_MAX} class="range-input absolute inset-0 w-full" aria-label="Maximum length" />
    </div>
    <p class="mt-2 text-[10px] tracking-[0.05em] text-taupe-light"><span id="filter-length-display">24m – 150m+</span></p>
  </div>

  <!-- Guests range -->
  <div>
    <p class={sectionLabelClass}>Guests</p>
    <div class="mt-2 flex items-center gap-2">
      <input id="filter-guests-min-num" type="number" min={GUESTS_MIN} max={GUESTS_MAX} step={GUESTS_STEP} value={GUESTS_MIN} class={numInputClass} aria-label="Minimum guests" />
      <span class="text-[10px] tracking-[0.2em] uppercase text-taupe-light">to</span>
      <input id="filter-guests-max-num" type="number" min={GUESTS_MIN} max={GUESTS_MAX} step={GUESTS_STEP} value={GUESTS_MAX} class={numInputClass} aria-label="Maximum guests" />
    </div>
    <div class="range-slider mt-3 relative h-5">
      <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-px bg-deep/20"></div>
      <div id="filter-guests-track" class="absolute top-1/2 -translate-y-1/2 h-px bg-deep"></div>
      <input id="filter-guests-min" type="range" min={GUESTS_MIN} max={GUESTS_MAX} step={GUESTS_STEP} value={GUESTS_MIN} class="range-input absolute inset-0 w-full" aria-label="Minimum guests" />
      <input id="filter-guests-max" type="range" min={GUESTS_MIN} max={GUESTS_MAX} step={GUESTS_STEP} value={GUESTS_MAX} class="range-input absolute inset-0 w-full" aria-label="Maximum guests" />
    </div>
    <p class="mt-2 text-[10px] tracking-[0.05em] text-taupe-light"><span id="filter-guests-display">1 – 12</span></p>
  </div>

  <!-- Price range -->
  <div>
    <p class={sectionLabelClass}>Price / week (EUR)</p>
    <div class="mt-2 flex items-center gap-2">
      <input id="filter-price-min-num" type="number" min={PRICE_MIN} max={PRICE_MAX} step={PRICE_STEP} value={PRICE_MIN} class={numInputClass} aria-label="Minimum price" />
      <span class="text-[10px] tracking-[0.2em] uppercase text-taupe-light">to</span>
      <input id="filter-price-max-num" type="number" min={PRICE_MIN} max={PRICE_MAX} step={PRICE_STEP} value={PRICE_MAX} class={numInputClass} aria-label="Maximum price" />
    </div>
    <div class="range-slider mt-3 relative h-5">
      <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-px bg-deep/20"></div>
      <div id="filter-price-track" class="absolute top-1/2 -translate-y-1/2 h-px bg-deep"></div>
      <input id="filter-price-min" type="range" min={PRICE_MIN} max={PRICE_MAX} step={PRICE_STEP} value={PRICE_MIN} class="range-input absolute inset-0 w-full" aria-label="Minimum price" />
      <input id="filter-price-max" type="range" min={PRICE_MIN} max={PRICE_MAX} step={PRICE_STEP} value={PRICE_MAX} class="range-input absolute inset-0 w-full" aria-label="Maximum price" />
    </div>
    <p class="mt-2 text-[10px] tracking-[0.05em] text-taupe-light"><span id="filter-price-display">{`€${PRICE_MIN.toLocaleString("en-US")} – €${PRICE_MAX.toLocaleString("en-US")}+`}</span></p>
  </div>

</aside>

<style>
  .range-input {
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    pointer-events: none;
    height: 20px;
  }
  .range-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    pointer-events: auto;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #2a2a2a;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.2);
    cursor: pointer;
  }
  .range-input::-moz-range-thumb {
    pointer-events: auto;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #2a2a2a;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.2);
    cursor: pointer;
  }
  .range-input::-webkit-slider-runnable-track,
  .range-input::-moz-range-track {
    background: transparent;
    height: 20px;
  }
  .range-input:focus { outline: none; }
</style>

<script>
  type RangeIds = {
    minRange: string;
    maxRange: string;
    minNum: string;
    maxNum: string;
    track: string;
    display: string;
    fmt: (v: number) => string;
    /** When true, render the upper bound as "<value>+" so the slider's
     *  hardcoded cap (30 guests, 150m, €2M) doesn't read as a hard limit
     *  for yachts that exceed it (SH Vega has 152 guests, etc). */
    treatMaxAsPlus?: boolean;
  };

  function setupRange(ids: RangeIds, onUpdate: () => void) {
    const minR = document.getElementById(ids.minRange) as HTMLInputElement | null;
    const maxR = document.getElementById(ids.maxRange) as HTMLInputElement | null;
    const minN = document.getElementById(ids.minNum) as HTMLInputElement | null;
    const maxN = document.getElementById(ids.maxNum) as HTMLInputElement | null;
    const track = document.getElementById(ids.track);
    const display = document.getElementById(ids.display);
    if (!minR || !maxR || !track || !display) return null;

    const lo = parseFloat(minR.min);
    const hi = parseFloat(minR.max);

    const sync = () => {
      let minV = parseFloat(minR.value);
      let maxV = parseFloat(maxR.value);
      if (minV > maxV) {
        // whichever was last touched stays; clamp the other
        minV = Math.min(minV, maxV);
        minR.value = String(minV);
      }
      const range = hi - lo;
      const left = ((minV - lo) / range) * 100;
      const right = ((maxV - lo) / range) * 100;
      (track as HTMLElement).style.left = `${left}%`;
      (track as HTMLElement).style.width = `${Math.max(right - left, 0)}%`;
      const maxLabel =
        ids.treatMaxAsPlus && maxV === hi
          ? `${ids.fmt(maxV)}+`
          : ids.fmt(maxV);
      display.textContent = `${ids.fmt(minV)} – ${maxLabel}`;
      if (minN) minN.value = String(minV);
      if (maxN) maxN.value = String(maxV);
    };

    const clamp = (v: number) => Math.min(Math.max(v, lo), hi);
    const onNumChange = () => {
      let mn = clamp(parseFloat(minN?.value || `${lo}`));
      let mx = clamp(parseFloat(maxN?.value || `${hi}`));
      if (Number.isNaN(mn)) mn = lo;
      if (Number.isNaN(mx)) mx = hi;
      if (mn > mx) mn = mx;
      minR.value = String(mn);
      maxR.value = String(mx);
      sync();
      onUpdate();
    };

    minR.addEventListener("input", () => {
      if (parseFloat(minR.value) > parseFloat(maxR.value)) minR.value = maxR.value;
      sync();
      onUpdate();
    });
    maxR.addEventListener("input", () => {
      if (parseFloat(maxR.value) < parseFloat(minR.value)) maxR.value = minR.value;
      sync();
      onUpdate();
    });
    minN?.addEventListener("change", onNumChange);
    maxN?.addEventListener("change", onNumChange);
    minN?.addEventListener("blur", onNumChange);
    maxN?.addEventListener("blur", onNumChange);

    sync();

    return {
      get: () => ({ min: parseFloat(minR.value), max: parseFloat(maxR.value) }),
      bounds: { lo, hi },
    };
  }

  // The filter component no longer mutates card visibility directly. It owns
  // the slider/search UI and emits a `yachts:filterchange` CustomEvent whose
  // detail describes the active filter state. The page (yachts/index.astro)
  // listens, applies the filter to its master yacht array, resets to page 1,
  // and re-renders. This keeps pagination + filtering composable and avoids
  // the legacy "render all 1040 cards then hide" pattern.
  const searchInput = document.getElementById("filter-search") as HTMLInputElement | null;

  let searchQuery = "";
  let debounce: ReturnType<typeof setTimeout> | null = null;

  function emitFilterChange(): void {
    const lenR = lengthRange?.get();
    const gstR = guestsRange?.get();
    const priR = priceRange?.get();

    const lenActive = !!(lenR && (lenR.min > lengthRange!.bounds.lo || lenR.max < lengthRange!.bounds.hi));
    const gstActive = !!(gstR && (gstR.min > guestsRange!.bounds.lo || gstR.max < guestsRange!.bounds.hi));
    const priActive = !!(priR && (priR.min > priceRange!.bounds.lo || priR.max < priceRange!.bounds.hi));

    // When the upper thumb is parked at the slider's cap, treat it as "no
    // upper limit" so outliers like SH Vega (152 guests) or yachts >150m /
    // >€2M/week aren't silently filtered out.
    const lenMax =
      lenR && lenR.max === lengthRange!.bounds.hi
        ? Number.POSITIVE_INFINITY
        : lenR?.max ?? 0;
    const gstMax =
      gstR && gstR.max === guestsRange!.bounds.hi
        ? Number.POSITIVE_INFINITY
        : gstR?.max ?? 0;
    const priMax =
      priR && priR.max === priceRange!.bounds.hi
        ? Number.POSITIVE_INFINITY
        : priR?.max ?? 0;

    const detail = {
      search: searchQuery,
      length: { min: lenR?.min ?? 0, max: lenMax, active: lenActive },
      guests: { min: gstR?.min ?? 0, max: gstMax, active: gstActive },
      price:  { min: priR?.min ?? 0, max: priMax, active: priActive },
    };

    window.dispatchEvent(new CustomEvent("yachts:filterchange", { detail }));
  }

  const lengthRange = setupRange({
    minRange: "filter-length-min",
    maxRange: "filter-length-max",
    minNum: "filter-length-min-num",
    maxNum: "filter-length-max-num",
    track: "filter-length-track",
    display: "filter-length-display",
    fmt: (v) => `${v}m`,
    treatMaxAsPlus: true,
  }, () => emitFilterChange());

  const guestsRange = setupRange({
    minRange: "filter-guests-min",
    maxRange: "filter-guests-max",
    minNum: "filter-guests-min-num",
    maxNum: "filter-guests-max-num",
    track: "filter-guests-track",
    display: "filter-guests-display",
    fmt: (v) => `${v}`,
    // 12 is a hard cap globally — no "+" suffix.
    treatMaxAsPlus: false,
  }, () => emitFilterChange());

  const priceRange = setupRange({
    minRange: "filter-price-min",
    maxRange: "filter-price-max",
    minNum: "filter-price-min-num",
    maxNum: "filter-price-max-num",
    track: "filter-price-track",
    display: "filter-price-display",
    fmt: (v) => `€${v.toLocaleString("en-US")}`,
    treatMaxAsPlus: true,
  }, () => emitFilterChange());

  searchInput?.addEventListener("input", (e) => {
    if (debounce) clearTimeout(debounce);
    debounce = setTimeout(() => {
      searchQuery = (e.target as HTMLInputElement).value;
      emitFilterChange();
    }, 150);
  });

  // Season select: same shape as Region — server-side filter (the snapshot's
  // seasons array is read on the API path), full-page reload to keep URL
  // state authoritative.
  const seasonSelect = document.getElementById("filter-season") as HTMLSelectElement | null;
  seasonSelect?.addEventListener("change", () => {
    const params = new URL(window.location.href).searchParams;
    if (seasonSelect.value) params.set("season", seasonSelect.value);
    else params.delete("season");
    params.delete("page");
    const qs = params.toString();
    window.location.href = qs ? `/yachts?${qs}` : "/yachts";
  });

  // Location dropdown: click toggles the panel; outside-click and Escape close it.
  // Each item inside the panel is a plain <a href> so selecting one triggers a
  // full page navigation — no need to manage the panel state across selection.
  const locationDropdown = document.querySelector<HTMLElement>("[data-location-dropdown]");
  const locationButton = document.getElementById("filter-location-button");
  const locationPanel = document.getElementById("filter-location-panel");
  const locationChevron = document.querySelector<HTMLElement>("[data-location-chevron]");

  function setLocationOpen(open: boolean) {
    if (!locationButton || !locationPanel) return;
    locationButton.setAttribute("aria-expanded", String(open));
    if (open) locationPanel.removeAttribute("hidden");
    else locationPanel.setAttribute("hidden", "");
    if (locationChevron) locationChevron.style.transform = open ? "rotate(180deg)" : "";
  }

  locationButton?.addEventListener("click", () => {
    const isOpen = locationButton.getAttribute("aria-expanded") === "true";
    setLocationOpen(!isOpen);
  });

  document.addEventListener("click", (e) => {
    if (!locationDropdown) return;
    if (locationDropdown.contains(e.target as Node)) return;
    setLocationOpen(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setLocationOpen(false);
  });
</script>
