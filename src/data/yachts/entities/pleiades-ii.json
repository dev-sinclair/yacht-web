  "crew": [
    {
      "name": "Ross Heginbotham",
      "avatar": "/media/media::image::c::7818389938::vessel::d5cc7934-fe8c-11ed-889f-43d4bb723744::assets::1be73d80-cb47-11ee-8a41-47f163b01e02.jpeg/{imageVariant}",
      "role": "Captain",
      "bio": "Captain Ross has been on the water for most of his life, growing up in Sydney he then moved to QLD and worked at Sea World as a water-skiier in the famous ski shows! Ross obtained his first commercial tickets in 1980 and worked on many of the cruise boats on the Gold Coast before heading North to Hamilton Island and further up to Cairns. He also has lived in Europe, working onboard superyachts around Spain & Nice in the south of France for many years. Ross has spent the last 7 years with the same company rotating between a fleet of yachts along the East Coast of Australia. The Whitsundays is a second home to Ross and he can't wait to show you around this beautiful part of the world! When at home, he likes to spend time with family, travelling, diving and snow skiing. Make sure you ask him about his car!"
    }
  ],
