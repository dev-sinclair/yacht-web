---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Container from "../ui/Container.astro";
import { formatPrice, formatLength } from "../../data/yacht-service";
import { resolveImage } from "../../lib/ankor/image";
import type { YachtCard } from "../../data/types/yacht";
import featuredYachts from "../../data/featured-yachts.json";

// Hard-coded featured set — avoids any Ankor API calls on the home page so the
// shell renders instantly. The detail page (`/yachts/{slug}`) still hits Ankor
// for live data; if the slug has been delisted, it redirects to `/yachts`.
const featured = featuredYachts as YachtCard[];
const track = [...featured, ...featured, ...featured]; // triple for true infinite loop

// Local hero override: drop a file at `src/assets/yachts/{slug}.{jpg,png,webp,avif}`
// and the carousel will use it (processed through Astro's image pipeline → AVIF/WebP
// + srcset). If no local file is present, falls back to the Ankor CDN URL.
const localHeroes = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/yachts/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const heroBySlug: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(localHeroes).map(([path, mod]) => {
    const slug = path.split("/").pop()!.replace(/\.[^.]+$/, "");
    return [slug, mod.default];
  }),
);
---

<section class="relative overflow-hidden bg-white py-24 lg:py-36">
  <Container>
    <div class="mb-12" data-reveal>
      <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">
        Hand-picked
      </p>
      <h2
        class="mt-4 text-3xl font-light tracking-[0.1em] uppercase text-charcoal whitespace-nowrap sm:text-5xl sm:tracking-[0.15em] lg:text-6xl"
        style="font-family: 'Raleway', sans-serif; font-weight: 300;"
      >
        Yacht Charter
      </h2>
      <div class="mt-5 h-px w-12 bg-gold/30" data-reveal-line></div>
    </div>
  </Container>

  {featured.length > 0 ? (
    <>
      <!-- Carousel viewport + overlaid navigation control -->
      <div class="yc-wrapper" data-reveal>
        <div class="yc-viewport" id="yc-viewport">
          <div class="yc-track" id="yc-track">
            {track.map((yacht, i) => {
              const weekPrice = formatPrice(yacht.weekPricingFrom, yacht.currency);
              const dayPrice = formatPrice(yacht.dayPricingFrom, yacht.currency);
              const hasWeek = yacht.weekPricingFrom != null;
              const hasDay = yacht.dayPricingFrom != null;
              const priceMain = hasWeek ? weekPrice : hasDay ? dayPrice : "On Request";
              const priceUnit = hasWeek ? "/ week" : hasDay ? "/ day" : "";
              const heroHi = resolveImage(yacht.hero, "2560w");
              const heroMd = resolveImage(yacht.hero, "1280w");
              const localHero = heroBySlug[yacht.slug];
              const isReal = i >= featured.length && i < 2 * featured.length;
              return (
                <a
                  href={`/yachts/${yacht.slug}`}
                  class="yc-card group"
                  aria-hidden={!isReal ? "true" : undefined}
                  tabindex={!isReal ? -1 : undefined}
                  data-yacht-name={yacht.name}
                  data-yacht-length={formatLength(yacht.length)}
                  data-yacht-guests={yacht.sleeps || "—"}
                  data-yacht-year={yacht.builtYear ?? "—"}
                  data-yacht-cabins={yacht.cabins || "—"}
                  data-yacht-price={`${priceMain}${priceUnit ? ` ${priceUnit}` : ""}`}
                >
                  {localHero ? (
                    <Image
                      src={localHero}
                      widths={[640, 1280, 2560]}
                      sizes="(min-width: 1024px) 1100px, 85vw"
                      alt={yacht.name}
                      class="yc-card-img"
                      loading="eager"
                    />
                  ) : yacht.hero ? (
                    <img
                      src={heroHi}
                      srcset={`${heroMd} 1280w, ${heroHi} 2560w`}
                      sizes="(min-width: 1024px) 1100px, 85vw"
                      alt={yacht.name}
                      class="yc-card-img"
                      loading="eager"
                      decoding="async"
                    />
                  ) : (
                    <div class="yc-card-img bg-cream"></div>
                  )}
                  <div class="yc-card-overlay"></div>

                  <!-- Bottom-left: label + name + specs -->
                  <div class="yc-card-content">
                    <p class="text-[10px] sm:text-[11px] font-light tracking-[0.3em] uppercase text-charcoal/60 sm:text-white/80">
                      For Charter
                    </p>
                    <h3
                      class="mt-2 text-2xl tracking-[0.08em] uppercase text-charcoal sm:mt-3 sm:text-4xl sm:text-white lg:text-5xl"
                      style="font-family: 'Playfair Display', serif; font-weight: 400;"
                    >
                      {yacht.name}
                    </h3>
                    <p class="yc-card-specs">
                      {formatLength(yacht.length)}{" · "}{yacht.sleeps} guests{" · "}{yacht.builtYear ?? "—"}{" · "}{yacht.cabins} cabins{" · "}<span
                        class="cur-price"
                        data-week-cents={yacht.weekPricingFrom ?? ""}
                        data-day-cents={yacht.dayPricingFrom ?? ""}
                        data-native={yacht.currency || "EUR"}
                      >{priceMain}{priceUnit ? ` ${priceUnit}` : ""}</span>
                    </p>
                  </div>

                  <!-- Bottom-right: VIEW button (hidden on mobile to avoid overlap) -->
                  <div class="yc-card-view-wrap hidden sm:block">
                    <span class="yc-card-view-btn">
                      View
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>

        <!-- Overlaid nav: < | 1/10 | > -->
        <div class="yc-ctrl">
          <button id="yc-prev" type="button" aria-label="Previous yacht" class="yc-ctrl-btn">
            <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
              <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="yc-ctrl-sep"></div>
          <span class="yc-ctrl-counter num">
            <span id="yc-current">1</span><span class="yc-ctrl-slash">/</span><span id="yc-total">{featured.length}</span>
          </span>
          <div class="yc-ctrl-sep"></div>
          <button id="yc-next" type="button" aria-label="Next yacht" class="yc-ctrl-btn">
            <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
              <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>

      <Container>
        <div class="mt-10 border-t border-charcoal/10 pt-8" data-reveal>
          <a
            href="/yachts"
            class="btn-fill inline-flex items-center gap-3 border border-charcoal/20 px-8 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-charcoal"
          >
            View All Yachts
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </Container>
    </>
  ) : (
    <Container>
      <p class="text-sm text-taupe">No yachts available right now.</p>
    </Container>
  )}
</section>

<!-- Custom drag cursor — fixed, follows mouse, only visible over carousel -->
<div class="yc-cursor" id="yc-cursor" aria-hidden="true">
  <svg class="yc-cursor-chevron yc-cursor-l" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="yc-cursor-label">Drag</span>
  <svg class="yc-cursor-chevron yc-cursor-r" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</div>

<style>
  .yc-wrapper {
    position: relative;
  }

  .yc-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    cursor: none;
  }

  /* Custom drag cursor */
  .yc-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(21, 26, 36, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 9999px;
    padding: 0.45rem 1rem;
    color: #fff;
    font-size: 9px;
    font-family: 'Raleway', sans-serif;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.2s ease;
    will-change: left, top;
  }
  .yc-cursor.is-visible { opacity: 1; }

  .yc-cursor-chevron { display: block; flex-shrink: 0; }

  .yc-cursor-l { animation: yc-chev-l 1.1s ease-in-out infinite; }
  .yc-cursor-r { animation: yc-chev-r 1.1s ease-in-out infinite; }

  @keyframes yc-chev-l {
    0%, 100% { transform: translateX(0); }
    50%       { transform: translateX(-4px); }
  }
  @keyframes yc-chev-r {
    0%, 100% { transform: translateX(0); }
    50%       { transform: translateX(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .yc-cursor-l, .yc-cursor-r { animation: none; }
  }

  .yc-track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    will-change: transform;
    transition: transform 0.7s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  /* Mobile default: image on top, text/specs below in normal flow. */
  .yc-card {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    width: 85vw;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    cursor: pointer;
    transition: transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1),
                box-shadow 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  /* sm+: revert to the overlay design — image fills the card, text sits over it. */
  @media (min-width: 640px) {
    .yc-card {
      display: block;
      width: 70vw;
      aspect-ratio: 16 / 9;
      background: var(--color-charcoal);
      border: none;
    }
  }
  @media (min-width: 1024px) {
    .yc-card {
      width: 62vw;
      max-width: 1100px;
    }
  }

  /* Mobile: image is the top section with a 16:10 aspect ratio. */
  .yc-card-img {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    flex: 0 0 auto;
    background: var(--color-charcoal);
  }
  /* sm+: image returns to filling the card. */
  @media (min-width: 640px) {
    .yc-card-img {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto;
      transition: transform 1.2s cubic-bezier(0.25, 0.1, 0.25, 1);
    }
    .yc-card.is-active .yc-card-img,
    .yc-card:hover .yc-card-img {
      transform: scale(1.04);
    }
  }

  /* Mobile: no dark gradient overlay (text sits below the image, not on it). */
  .yc-card-overlay { display: none; }
  @media (min-width: 640px) {
    .yc-card-overlay {
      display: block;
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0) 100%);
      pointer-events: none;
    }
  }

  /* Mobile: content flows under the image. sm+: it's pinned to the bottom-left. */
  .yc-card-content {
    position: relative;
    padding: 1.25rem 1.25rem 1.5rem;
  }
  @media (min-width: 640px) {
    .yc-card-content {
      position: absolute;
      bottom: 0;
      left: 0;
      padding: 2rem;
    }
  }
  @media (min-width: 768px) { .yc-card-content { padding: 3rem; } }
  @media (min-width: 1024px) { .yc-card-content { padding: 3.5rem; } }

  .yc-card-specs {
    margin-top: 0.6rem;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: rgba(21, 26, 36, 0.65);
    font-family: 'Raleway', sans-serif;
    font-weight: 300;
    line-height: 1.6;
  }
  @media (min-width: 640px) {
    .yc-card-specs {
      letter-spacing: 0.12em;
      color: rgba(255, 255, 255, 0.72);
      line-height: 1.5;
    }
  }

  /* Bottom-right: VIEW button */
  .yc-card-view-wrap {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    pointer-events: none;
  }
  @media (min-width: 768px) { .yc-card-view-wrap { bottom: 3rem; right: 3rem; } }
  @media (min-width: 1024px) { .yc-card-view-wrap { bottom: 3.5rem; right: 3.5rem; } }

  .yc-card-view-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    padding: 0.75rem 1.75rem;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #fff;
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
  }
  .yc-card:hover .yc-card-view-btn,
  .yc-card.is-active:hover .yc-card-view-btn {
    background-color: #fff;
    border-color: #fff;
    color: var(--color-charcoal);
  }
  @media (min-width: 640px) {
    .yc-card-view-btn { padding: 0.875rem 2rem; }
  }

  .yc-card.is-active {
    opacity: 1;
  }

  /* Overlaid nav control: < | 1/10 | > — centered over the active card */
  .yc-ctrl {
    position: absolute;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    z-index: 10;
    pointer-events: none;
  }
  @media (min-width: 640px)  { .yc-ctrl { top: 2rem; gap: 0.875rem; } }
  @media (min-width: 768px)  { .yc-ctrl { top: 3rem; } }
  @media (min-width: 1024px) { .yc-ctrl { top: 3.5rem; } }

  .yc-ctrl-btn {
    pointer-events: all;
    background: none;
    border: none;
    padding: 0.25rem;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    display: flex;
    align-items: center;
    transition: color 0.2s ease;
  }
  .yc-ctrl-btn:hover { color: #fff; }
  .yc-ctrl-btn:focus-visible {
    outline: 1px solid rgba(255,255,255,0.6);
    outline-offset: 3px;
  }

  .yc-ctrl-sep {
    width: 1rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.4);
    flex-shrink: 0;
  }
  @media (min-width: 640px) { .yc-ctrl-sep { width: 1.5rem; } }

  .yc-ctrl-counter {
    font-size: 9px;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.85);
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .yc-ctrl-counter { font-size: 11px; letter-spacing: 0.18em; }
  }
  .yc-ctrl-slash {
    display: inline-block;
    margin: 0 0.3em;
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .yc-track { transition: none; }
    .yc-card-img { transition: none; }
    .yc-card.is-active .yc-card-img,
    .yc-card:hover .yc-card-img { transform: none; }
  }
</style>

<script>
  type CardEl = HTMLAnchorElement & {
    dataset: DOMStringMap;
  };

  const viewport = document.getElementById("yc-viewport") as HTMLElement | null;
  const track = document.getElementById("yc-track") as HTMLElement | null;
  const prevBtn = document.getElementById("yc-prev") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("yc-next") as HTMLButtonElement | null;
  const currentEl = document.getElementById("yc-current");
  const totalEl = document.getElementById("yc-total");

  if (viewport && track && prevBtn && nextBtn) {
    const cards = Array.from(track.children) as CardEl[];
    const totalCards = cards.length;
    const N = Math.floor(totalCards / 3); // featured length (track is tripled)

    if (N > 0) {
      let realIdx = N; // start at middle copy so left neighbor always exists
      let isAnimating = false;
      const TRANSITION_MS = 700;
      const AUTOPLAY_MS = 6000;
      let autoplayTimer: number | null = null;

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function getCardW(): number {
        const c = cards[0];
        if (!c) return 0;
        const rect = c.getBoundingClientRect();
        const styles = getComputedStyle(track!);
        const gap = parseFloat(styles.gap) || 0;
        return rect.width + gap;
      }

      function applyTransform(animated: boolean) {
        if (!track || !viewport) return;
        track.style.transition = animated && !reduceMotion
          ? `transform ${TRANSITION_MS}ms cubic-bezier(0.25, 0.1, 0.25, 1)`
          : "none";
        const card = cards[0];
        if (!card) return;
        const cardWidth = card.getBoundingClientRect().width;
        const stepW = getCardW();
        const centerOffset = (viewport.clientWidth - cardWidth) / 2;
        const x = centerOffset - realIdx * stepW;
        track.style.transform = `translate3d(${x}px, 0, 0)`;
        if (!animated) {
          // force reflow so subsequent transitions re-engage
          // eslint-disable-next-line @typescript-eslint/no-unused-expressions
          track.offsetHeight;
        }
      }

      function setActiveCard() {
        cards.forEach((c, i) => {
          c.classList.toggle("is-active", i === realIdx);
        });
        const conceptual = realIdx % N;
        if (currentEl) currentEl.textContent = String(conceptual + 1);
      }

      function next() {
        if (isAnimating || !track) return;
        isAnimating = true;
        realIdx += 1;
        applyTransform(true);
        setActiveCard();

        const finish = () => {
          if (realIdx >= 2 * N) {
            realIdx -= N;
            applyTransform(false);
          }
          isAnimating = false;
        };
        if (reduceMotion) {
          finish();
        } else {
          window.setTimeout(finish, TRANSITION_MS + 30);
        }
      }

      function prev() {
        if (isAnimating || !track) return;
        isAnimating = true;
        realIdx -= 1;
        applyTransform(true);
        setActiveCard();

        const finish = () => {
          if (realIdx < N) {
            realIdx += N;
            applyTransform(false);
          }
          isAnimating = false;
        };
        if (reduceMotion) {
          finish();
        } else {
          window.setTimeout(finish, TRANSITION_MS + 30);
        }
      }

      function startAutoplay() {
        if (reduceMotion) return;
        stopAutoplay();
        autoplayTimer = window.setInterval(() => next(), AUTOPLAY_MS);
      }
      function stopAutoplay() {
        if (autoplayTimer != null) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      prevBtn.addEventListener("click", () => { stopAutoplay(); prev(); startAutoplay(); });
      nextBtn.addEventListener("click", () => { stopAutoplay(); next(); startAutoplay(); });

      // Custom cursor
      const cursor = document.getElementById("yc-cursor");
      const showCursor = () => cursor?.classList.add("is-visible");
      const hideCursor = () => cursor?.classList.remove("is-visible");

      viewport.addEventListener("mouseenter", () => { stopAutoplay(); showCursor(); });
      viewport.addEventListener("mouseleave", () => { startAutoplay(); hideCursor(); });
      viewport.addEventListener("focusin", stopAutoplay);
      viewport.addEventListener("focusout", startAutoplay);

      // Mouse drag — snaps to next/prev on release
      let mouseStartX = 0;
      let mouseDelta = 0;
      let isDragging = false;
      let didDrag = false;
      const DRAG_THRESHOLD = 60;

      viewport.addEventListener("mousedown", (e) => {
        if (e.button !== 0) return;
        mouseStartX = e.clientX;
        mouseDelta = 0;
        isDragging = true;
        didDrag = false;
        stopAutoplay();
      });

      document.addEventListener("mousemove", (e) => {
        if (cursor) { cursor.style.left = e.clientX + "px"; cursor.style.top = e.clientY + "px"; }
        if (!isDragging) return;
        mouseDelta = e.clientX - mouseStartX;
      });

      document.addEventListener("mouseup", () => {
        if (!isDragging) return;
        isDragging = false;
        if (Math.abs(mouseDelta) > DRAG_THRESHOLD) {
          didDrag = true;
          if (mouseDelta < 0) next(); else prev();
        } else if (Math.abs(mouseDelta) > 5) {
          didDrag = true; // suppress spurious click
        }
        startAutoplay();
      });

      // Prevent link navigation after a drag
      viewport.addEventListener("click", (e) => {
        if (didDrag) { e.preventDefault(); didDrag = false; }
      }, true);

      // Prevent native image/link drag
      viewport.addEventListener("dragstart", (e) => e.preventDefault());

      // Pause when offscreen
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) startAutoplay();
            else stopAutoplay();
          }
        }, { threshold: 0.2 });
        io.observe(viewport);
      }

      // Keyboard
      viewport.tabIndex = 0;
      viewport.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") { e.preventDefault(); prev(); }
        if (e.key === "ArrowRight") { e.preventDefault(); next(); }
      });

      // Touch swipe
      let touchStartX = 0;
      let touchDelta = 0;
      viewport.addEventListener("touchstart", (e) => {
        touchStartX = e.touches[0].clientX;
        touchDelta = 0;
        stopAutoplay();
      }, { passive: true });
      viewport.addEventListener("touchmove", (e) => {
        touchDelta = e.touches[0].clientX - touchStartX;
      }, { passive: true });
      viewport.addEventListener("touchend", () => {
        if (Math.abs(touchDelta) > 40) {
          if (touchDelta < 0) next();
          else prev();
        }
        startAutoplay();
      });

      // Resize
      let resizeT: number | null = null;
      window.addEventListener("resize", () => {
        if (resizeT != null) window.clearTimeout(resizeT);
        resizeT = window.setTimeout(() => applyTransform(false), 120);
      });

      // Init
      if (totalEl) totalEl.textContent = String(N);
      const init = () => {
        applyTransform(false);
        setActiveCard();
        startAutoplay();
      };
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(init);
      } else {
        requestAnimationFrame(init);
      }
    }
  }
</script>
