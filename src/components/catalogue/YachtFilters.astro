---
import type { YachtFacets } from "../../data/types/yacht";
import { getAllRegions } from "../../lib/destinations/registry";
import { YACHT_CATEGORIES } from "../../data/yacht-service";

interface Props {
  facets: YachtFacets;
  activeType?: string;
  activeRegion?: string;
}

const { activeType = "", activeRegion = "" } = Astro.props;

const regions = getAllRegions();

function withParam(base: Record<string, string>, key: string, value: string): string {
  const params = new URLSearchParams();
  for (const [k, v] of Object.entries(base)) if (v) params.set(k, v);
  if (value) params.set(key, value);
  else params.delete(key);
  const qs = params.toString();
  return qs ? `/yachts?${qs}` : "/yachts";
}

const LENGTH_MIN = 15;
const LENGTH_MAX = 150;
const LENGTH_STEP = 1;

const GUESTS_MIN = 1;
const GUESTS_MAX = 30;
const GUESTS_STEP = 1;

const PRICE_MIN = 0;
const PRICE_MAX = 2_000_000;
const PRICE_STEP = 5_000;

const pillClass = (selected: boolean) =>
  selected
    ? "filter-pill flex min-h-8 w-full items-center justify-center px-1.5 py-1 text-center text-[8px] font-medium tracking-[0.08em] uppercase leading-tight border border-charcoal bg-charcoal text-white transition-all duration-300"
    : "filter-pill flex min-h-8 w-full items-center justify-center px-1.5 py-1 text-center text-[8px] font-medium tracking-[0.08em] uppercase leading-tight border border-charcoal/20 text-charcoal transition-all duration-300 hover:bg-charcoal hover:text-white";

const sectionLabelClass = "text-[10px] font-medium tracking-[0.2em] uppercase text-taupe-light";
const numInputClass = "w-full px-2 py-2 text-xs tracking-[0.05em] border border-charcoal/20 text-charcoal bg-transparent transition-colors duration-300 focus:outline-none focus:border-charcoal";
---

<aside id="yacht-filters" class="space-y-5">
  <!-- Search -->
  <div>
    <label class={sectionLabelClass} for="filter-search">Search</label>
    <div class="relative mt-2">
      <input
        id="filter-search"
        type="search"
        placeholder="Name or builder…"
        class="w-full px-3 py-2.5 pr-9 text-xs tracking-[0.05em] border border-charcoal/20 text-charcoal bg-transparent transition-colors duration-300 focus:outline-none focus:border-charcoal placeholder:text-taupe-light/70"
        autocomplete="off"
      />
      <svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-taupe-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
    </div>
  </div>

  <!-- Type pills -->
  <div>
    <p class={sectionLabelClass}>Type</p>
    <div class="mt-2 grid grid-cols-2 gap-1.5">
      <a class={pillClass(activeType === "")} href={withParam({ region: activeRegion }, "yachtType", "")}>All</a>
      {YACHT_CATEGORIES.map((type) => (
        <a class={pillClass(activeType === type)} href={withParam({ region: activeRegion }, "yachtType", type)}>{type}</a>
      ))}
    </div>
  </div>

  <!-- Region select -->
  <div>
    <p class={sectionLabelClass}>Region</p>
    <div class="relative mt-2">
      <select
        id="filter-region"
        class="num w-full appearance-none border border-charcoal/20 bg-transparent px-3 py-2.5 pr-9 text-xs tracking-[0.05em] text-charcoal transition-colors duration-300 focus:outline-none focus:border-charcoal cursor-pointer"
      >
        <option value="">All regions</option>
        {regions.map((region) => (
          <option value={region.slug} selected={activeRegion === region.slug}>{region.name}</option>
        ))}
      </select>
      <svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-3 h-3 text-taupe-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
    {activeRegion && (
      <a
        href={withParam({ yachtType: activeType }, "region", "")}
        class="mt-2 inline-flex items-center gap-1 text-[10px] font-medium tracking-[0.2em] uppercase text-taupe transition-colors duration-300 hover:text-charcoal"
      >
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
        Clear region
      </a>
    )}
  </div>

  <!-- Length range -->
  <div>
    <p class={sectionLabelClass}>Length (m)</p>
    <div class="mt-2 flex items-center gap-2">
      <input id="filter-length-min-num" type="number" min={LENGTH_MIN} max={LENGTH_MAX} step={LENGTH_STEP} value={LENGTH_MIN} class={numInputClass} aria-label="Minimum length" />
      <span class="text-[10px] tracking-[0.2em] uppercase text-taupe-light">to</span>
      <input id="filter-length-max-num" type="number" min={LENGTH_MIN} max={LENGTH_MAX} step={LENGTH_STEP} value={LENGTH_MAX} class={numInputClass} aria-label="Maximum length" />
    </div>
    <div class="range-slider mt-3 relative h-5">
      <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-px bg-charcoal/20"></div>
      <div id="filter-length-track" class="absolute top-1/2 -translate-y-1/2 h-px bg-charcoal"></div>
      <input id="filter-length-min" type="range" min={LENGTH_MIN} max={LENGTH_MAX} step={LENGTH_STEP} value={LENGTH_MIN} class="range-input absolute inset-0 w-full" aria-label="Minimum length" />
      <input id="filter-length-max" type="range" min={LENGTH_MIN} max={LENGTH_MAX} step={LENGTH_STEP} value={LENGTH_MAX} class="range-input absolute inset-0 w-full" aria-label="Maximum length" />
    </div>
    <p class="mt-2 text-[10px] tracking-[0.05em] text-taupe-light"><span id="filter-length-display">15m – 150m</span></p>
  </div>

  <!-- Guests range -->
  <div>
    <p class={sectionLabelClass}>Guests</p>
    <div class="mt-2 flex items-center gap-2">
      <input id="filter-guests-min-num" type="number" min={GUESTS_MIN} max={GUESTS_MAX} step={GUESTS_STEP} value={GUESTS_MIN} class={numInputClass} aria-label="Minimum guests" />
      <span class="text-[10px] tracking-[0.2em] uppercase text-taupe-light">to</span>
      <input id="filter-guests-max-num" type="number" min={GUESTS_MIN} max={GUESTS_MAX} step={GUESTS_STEP} value={GUESTS_MAX} class={numInputClass} aria-label="Maximum guests" />
    </div>
    <div class="range-slider mt-3 relative h-5">
      <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-px bg-charcoal/20"></div>
      <div id="filter-guests-track" class="absolute top-1/2 -translate-y-1/2 h-px bg-charcoal"></div>
      <input id="filter-guests-min" type="range" min={GUESTS_MIN} max={GUESTS_MAX} step={GUESTS_STEP} value={GUESTS_MIN} class="range-input absolute inset-0 w-full" aria-label="Minimum guests" />
      <input id="filter-guests-max" type="range" min={GUESTS_MIN} max={GUESTS_MAX} step={GUESTS_STEP} value={GUESTS_MAX} class="range-input absolute inset-0 w-full" aria-label="Maximum guests" />
    </div>
    <p class="mt-2 text-[10px] tracking-[0.05em] text-taupe-light"><span id="filter-guests-display">1 – 30</span></p>
  </div>

  <!-- Price range -->
  <div>
    <p class={sectionLabelClass}>Price / week (EUR)</p>
    <div class="mt-2 flex items-center gap-2">
      <input id="filter-price-min-num" type="number" min={PRICE_MIN} max={PRICE_MAX} step={PRICE_STEP} value={PRICE_MIN} class={numInputClass} aria-label="Minimum price" />
      <span class="text-[10px] tracking-[0.2em] uppercase text-taupe-light">to</span>
      <input id="filter-price-max-num" type="number" min={PRICE_MIN} max={PRICE_MAX} step={PRICE_STEP} value={PRICE_MAX} class={numInputClass} aria-label="Maximum price" />
    </div>
    <div class="range-slider mt-3 relative h-5">
      <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-px bg-charcoal/20"></div>
      <div id="filter-price-track" class="absolute top-1/2 -translate-y-1/2 h-px bg-charcoal"></div>
      <input id="filter-price-min" type="range" min={PRICE_MIN} max={PRICE_MAX} step={PRICE_STEP} value={PRICE_MIN} class="range-input absolute inset-0 w-full" aria-label="Minimum price" />
      <input id="filter-price-max" type="range" min={PRICE_MIN} max={PRICE_MAX} step={PRICE_STEP} value={PRICE_MAX} class="range-input absolute inset-0 w-full" aria-label="Maximum price" />
    </div>
    <p class="mt-2 text-[10px] tracking-[0.05em] text-taupe-light"><span id="filter-price-display">€0 – €2,000,000</span></p>
  </div>

</aside>

<style>
  .range-input {
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    pointer-events: none;
    height: 20px;
  }
  .range-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    pointer-events: auto;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #2a2a2a;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.2);
    cursor: pointer;
  }
  .range-input::-moz-range-thumb {
    pointer-events: auto;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #2a2a2a;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.2);
    cursor: pointer;
  }
  .range-input::-webkit-slider-runnable-track,
  .range-input::-moz-range-track {
    background: transparent;
    height: 20px;
  }
  .range-input:focus { outline: none; }
</style>

<script>
  type RangeIds = {
    minRange: string;
    maxRange: string;
    minNum: string;
    maxNum: string;
    track: string;
    display: string;
    fmt: (v: number) => string;
  };

  function setupRange(ids: RangeIds, onUpdate: () => void) {
    const minR = document.getElementById(ids.minRange) as HTMLInputElement | null;
    const maxR = document.getElementById(ids.maxRange) as HTMLInputElement | null;
    const minN = document.getElementById(ids.minNum) as HTMLInputElement | null;
    const maxN = document.getElementById(ids.maxNum) as HTMLInputElement | null;
    const track = document.getElementById(ids.track);
    const display = document.getElementById(ids.display);
    if (!minR || !maxR || !track || !display) return null;

    const lo = parseFloat(minR.min);
    const hi = parseFloat(minR.max);

    const sync = () => {
      let minV = parseFloat(minR.value);
      let maxV = parseFloat(maxR.value);
      if (minV > maxV) {
        // whichever was last touched stays; clamp the other
        minV = Math.min(minV, maxV);
        minR.value = String(minV);
      }
      const range = hi - lo;
      const left = ((minV - lo) / range) * 100;
      const right = ((maxV - lo) / range) * 100;
      (track as HTMLElement).style.left = `${left}%`;
      (track as HTMLElement).style.width = `${Math.max(right - left, 0)}%`;
      display.textContent = `${ids.fmt(minV)} – ${ids.fmt(maxV)}`;
      if (minN) minN.value = String(minV);
      if (maxN) maxN.value = String(maxV);
    };

    const clamp = (v: number) => Math.min(Math.max(v, lo), hi);
    const onNumChange = () => {
      let mn = clamp(parseFloat(minN?.value || `${lo}`));
      let mx = clamp(parseFloat(maxN?.value || `${hi}`));
      if (Number.isNaN(mn)) mn = lo;
      if (Number.isNaN(mx)) mx = hi;
      if (mn > mx) mn = mx;
      minR.value = String(mn);
      maxR.value = String(mx);
      sync();
      onUpdate();
    };

    minR.addEventListener("input", () => {
      if (parseFloat(minR.value) > parseFloat(maxR.value)) minR.value = maxR.value;
      sync();
      onUpdate();
    });
    maxR.addEventListener("input", () => {
      if (parseFloat(maxR.value) < parseFloat(minR.value)) maxR.value = minR.value;
      sync();
      onUpdate();
    });
    minN?.addEventListener("change", onNumChange);
    maxN?.addEventListener("change", onNumChange);
    minN?.addEventListener("blur", onNumChange);
    maxN?.addEventListener("blur", onNumChange);

    sync();

    return {
      get: () => ({ min: parseFloat(minR.value), max: parseFloat(maxR.value) }),
      bounds: { lo, hi },
    };
  }

  // The filter component no longer mutates card visibility directly. It owns
  // the slider/search UI and emits a `yachts:filterchange` CustomEvent whose
  // detail describes the active filter state. The page (yachts/index.astro)
  // listens, applies the filter to its master yacht array, resets to page 1,
  // and re-renders. This keeps pagination + filtering composable and avoids
  // the legacy "render all 1040 cards then hide" pattern.
  const searchInput = document.getElementById("filter-search") as HTMLInputElement | null;

  let searchQuery = "";
  let debounce: ReturnType<typeof setTimeout> | null = null;

  function emitFilterChange(): void {
    const lenR = lengthRange?.get();
    const gstR = guestsRange?.get();
    const priR = priceRange?.get();

    const lenActive = !!(lenR && (lenR.min > lengthRange!.bounds.lo || lenR.max < lengthRange!.bounds.hi));
    const gstActive = !!(gstR && (gstR.min > guestsRange!.bounds.lo || gstR.max < guestsRange!.bounds.hi));
    const priActive = !!(priR && (priR.min > priceRange!.bounds.lo || priR.max < priceRange!.bounds.hi));

    const detail = {
      search: searchQuery,
      length: { min: lenR?.min ?? 0, max: lenR?.max ?? 0, active: lenActive },
      guests: { min: gstR?.min ?? 0, max: gstR?.max ?? 0, active: gstActive },
      price:  { min: priR?.min ?? 0, max: priR?.max ?? 0, active: priActive },
    };

    window.dispatchEvent(new CustomEvent("yachts:filterchange", { detail }));
  }

  const lengthRange = setupRange({
    minRange: "filter-length-min",
    maxRange: "filter-length-max",
    minNum: "filter-length-min-num",
    maxNum: "filter-length-max-num",
    track: "filter-length-track",
    display: "filter-length-display",
    fmt: (v) => `${v}m`,
  }, () => emitFilterChange());

  const guestsRange = setupRange({
    minRange: "filter-guests-min",
    maxRange: "filter-guests-max",
    minNum: "filter-guests-min-num",
    maxNum: "filter-guests-max-num",
    track: "filter-guests-track",
    display: "filter-guests-display",
    fmt: (v) => `${v}`,
  }, () => emitFilterChange());

  const priceRange = setupRange({
    minRange: "filter-price-min",
    maxRange: "filter-price-max",
    minNum: "filter-price-min-num",
    maxNum: "filter-price-max-num",
    track: "filter-price-track",
    display: "filter-price-display",
    fmt: (v) => `€${v.toLocaleString("en-US")}`,
  }, () => emitFilterChange());

  searchInput?.addEventListener("input", (e) => {
    if (debounce) clearTimeout(debounce);
    debounce = setTimeout(() => {
      searchQuery = (e.target as HTMLInputElement).value;
      emitFilterChange();
    }, 150);
  });

  // Region select: navigate to /yachts with the new region param. Region is
  // a server-side filter (the API needs to load entity zones), so it lives
  // in the URL alongside yachtType — full page transition keeps both
  // filter dimensions in sync with the URL state machine.
  const regionSelect = document.getElementById("filter-region") as HTMLSelectElement | null;
  regionSelect?.addEventListener("change", () => {
    const params = new URL(window.location.href).searchParams;
    if (regionSelect.value) params.set("region", regionSelect.value);
    else params.delete("region");
    // Drop pagination — a new region collapses the result set.
    params.delete("page");
    const qs = params.toString();
    window.location.href = qs ? `/yachts?${qs}` : "/yachts";
  });
</script>
