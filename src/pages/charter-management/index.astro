---
import { Image } from "astro:assets";
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import Container from "../../components/ui/Container.astro";
import heroImg from "../../assets/pano2.jpg";
import portraitImg from "../../assets/dock.jpg";

const pillars = [
  {
    label: "Marketing",
    text: "Presented to the right audience, through the right channels.",
  },
  {
    label: "Bookings",
    text: "Every enquiry handled, every charter meticulously prepared.",
  },
  {
    label: "Finance",
    text: "Accounts managed, reconciled and reported per charter.",
  },
  {
    label: "Compliance",
    text: "Charter licensing, flag state and crew requirements properly structured and verified throughout.",
  },
];
---

<BaseLayout
  title="Charter Management · Sinclair Yachting"
  description="Charter management from Sinclair. Marketing, bookings, contracts and APA. We commercialise your yacht and reconcile every cent."
>
  <Navbar />

  <!-- Hero -->
  <section
    class="relative h-screen w-full bg-white px-3 pb-3 sm:px-4 sm:pb-4 lg:px-5 lg:pb-5"
  >
    <div class="relative h-full w-full overflow-hidden bg-deep">
      <Image
        src={heroImg}
        alt="Yacht under charter"
        class="absolute inset-0 h-full w-full object-cover"
        widths={[1280, 1920]}
        sizes="100vw"
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/45 to-black/45"
      >
      </div>

      <div
        class="absolute bottom-0 left-0 right-0 z-10 px-6 pb-36 sm:px-8 lg:px-12"
      >
        <div
          class="mx-auto max-w-[1440px]"
          style="text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);"
        >
          <h1
            class="mt-4 text-4xl leading-[1.1] tracking-[0.08em] uppercase text-white sm:text-5xl lg:text-6xl xl:text-7xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;"
          >
            Charter<br />
            Management
          </h1>
          <p
            class="mt-6 text-lg font-light tracking-[0.04em] text-white/90 sm:text-xl"
            style="font-family: 'Raleway', sans-serif;"
          >
            The commercial programme your yacht deserves.
          </p>
          <p
            class="mt-5 max-w-xl text-sm leading-relaxed text-white/80 sm:text-base"
          >
            Charter operations, managed by a dedicated team with a single focus
            — your yacht.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="/#contact"
              class="btn-fill-light inline-flex items-center gap-3 border border-white/40 px-7 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-white"
            >
              Get in touch
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Sinclair / pillars -->
  <section class="bg-white py-24 lg:py-32">
    <Container>
      <div
        class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,480px)] lg:gap-20"
      >
        <!-- Left: intro copy -->
        <div>
          <p
            class="text-[11px] font-light tracking-[0.3em] uppercase text-deep-dark"
          >
            Why Sinclair
          </p>
          <h2
            class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;"
          >
            Experience, Care<br />
            &amp; Commitment
          </h2>
          <div class="mt-6 h-px w-10 bg-deep/40"></div>
          <p class="mt-8 max-w-xl text-base leading-[1.8] text-taupe">
            Charter should feel simple. We ensure everything is properly
            prepared, enquiries are handled carefully, bookings are confirmed
            smoothly, and all the practical details are looked after behind the
            scenes.
          </p>

          <!-- Pillars -->
          <div class="mt-12 grid grid-cols-2 gap-y-8 gap-x-8">
            {
              pillars.map((p) => (
                <div>
                  <p
                    class="text-xl font-light tracking-[0.25em] uppercase text-charcoal sm:text-2xl"
                    style="font-family: 'Raleway', sans-serif; font-weight: 300;"
                  >
                    {p.label}
                  </p>
                  <p class="mt-2 text-sm leading-[1.7] text-taupe">{p.text}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Right: portrait image -->
        <div class="relative hidden lg:block">
          <div class="relative aspect-[4/5] w-full overflow-hidden">
            <Image
              src={portraitImg}
              alt="Yacht in port"
              class="absolute inset-0 h-full w-full object-cover"
              widths={[600, 900, 1200]}
              sizes="(min-width: 1024px) 480px, 100vw"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Additional support? — brand blue band, cross-link to Yacht Management -->
  <section
    class="relative overflow-hidden py-20 lg:py-24"
    style="background-color: #6e8e8f;"
  >
    <div
      class="absolute inset-0 pointer-events-none"
      style="background-color: rgba(15, 24, 25, 0.14);"
    >
    </div>
    <Container>
      <div
        class="relative flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-center"
      >
        <div class="max-w-xl">
          <p
            class="text-[11px] font-light tracking-[0.3em] uppercase text-white/80"
          >
            Additional Support?
          </p>
          <h2
            class="mt-4 text-2xl font-light tracking-[0.12em] uppercase text-white sm:text-3xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;"
          >
            Add Yacht Management
          </h2>
          <p class="mt-4 text-base leading-[1.8] text-white/85">
            Many owners want both under one roof — one team, one standard, two
            distinct programmes.
          </p>
        </div>
        <a
          href="/yacht-management"
          class="btn-fill-light inline-flex items-center gap-3 border border-white/40 px-8 py-4 text-[11px] font-medium tracking-[0.2em] uppercase text-white"
        >
          Yacht Management
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </Container>
  </section>

  <!-- Closing CTA -->
  <section class="bg-white py-24 lg:py-32 text-center">
    <Container>
      <p
        class="text-[11px] font-light tracking-[0.3em] uppercase text-deep-dark"
      >
        Ready When You Are
      </p>
      <h2
        class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
        style="font-family: 'Raleway', sans-serif; font-weight: 300;"
      >
        Begin a Confidential Conversation
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-taupe">
        An initial conversation is private and at your pace. We will review your
        requirements and advise accordingly.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/#contact"
          class="btn-fill inline-flex items-center gap-3 border border-deep/20 px-8 py-3.5 text-[11px] font-medium tracking-[0.2em] uppercase text-charcoal"
        >
          Request a Consultation
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </Container>
  </section>

  <Footer />
</BaseLayout>
