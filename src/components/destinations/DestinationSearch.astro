---
interface Props {
  regionCount: number;
  locationCount: number;
}

const { regionCount, locationCount } = Astro.props;
---

<div
  data-dest-search-wrapper
  data-region-count={regionCount}
  data-location-count={locationCount}
  class="sticky top-20 z-30 bg-white/95 backdrop-blur-md"
>
  <div class="mx-auto max-w-[1440px] px-6 sm:px-8 lg:px-12 py-4 sm:py-5">
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
      <label class="relative flex-1 group">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-taupe-light pointer-events-none">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.34-4.34m0 0A7.5 7.5 0 1 0 6.06 6.06a7.5 7.5 0 0 0 10.6 10.6Z" />
          </svg>
        </span>
        <input
          id="dest-search"
          type="search"
          autocomplete="off"
          placeholder="Search regions or destinations — e.g. Greece, Bahamas, Maldives"
          class="w-full bg-transparent border border-deep/15 pl-11 pr-4 py-3 text-sm text-charcoal placeholder:text-taupe-light placeholder:font-light tracking-wide transition-all duration-300 focus:outline-none focus:border-gold focus:bg-white"
          style="font-family: 'Raleway', sans-serif;"
        />
      </label>
      <p
        data-dest-count
        class="text-[11px] font-medium tracking-[0.2em] uppercase text-taupe shrink-0"
        style="font-family: 'Raleway', sans-serif;"
      >
        {regionCount} Regions &middot; {locationCount} Destinations
      </p>
    </div>
  </div>
</div>
