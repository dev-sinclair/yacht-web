---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import mapOutline from "../../assets/mapoutline.webp";
import pano2 from "../../assets/pano2.jpg";

const pillars = [
  { label: "Private", text: "One broker, one client. Direct and personal." },
  { label: "Global", text: "Curated yachts across the world's finest waters." },
  { label: "Bespoke", text: "Every itinerary shaped around you." },
  { label: "Discreet", text: "Confidentiality at every step of the journey." },
];
---

<section id="about" class="relative overflow-hidden bg-white py-32 lg:py-44">
  <!-- Map background -->
  <div class="absolute inset-0 pointer-events-none">
    <Image
      src={mapOutline}
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-70"
      widths={[1280, 1920]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-white/60 via-transparent to-white/60"></div>
  </div>

  <Container>
    <div class="relative grid items-center gap-12 lg:grid-cols-[1fr_minmax(0,520px)] lg:gap-20">
      <!-- Left: text content -->
      <div>
        <div data-reveal>
          <p class="text-[11px] font-light tracking-[0.3em] uppercase text-gold/70">About Us</p>
          <h2
            class="mt-4 text-3xl font-light tracking-[0.15em] uppercase text-charcoal sm:text-4xl lg:text-5xl"
            style="font-family: 'Raleway', sans-serif; font-weight: 300;"
          >
            A Private Passage<br />
            Across Every Horizon
          </h2>
          <div class="mt-6 h-px w-10 bg-gold/40"></div>
          <p class="mt-8 max-w-xl text-base leading-[1.8] text-taupe">
            Sinclair Yachting is a boutique brokerage connecting a select clientele with exceptional yachts across the world's finest cruising grounds — quiet, personal, and deliberate at every step.
          </p>
        </div>

        <!-- Pillars -->
        <div class="mt-12 grid grid-cols-2 gap-y-8 gap-x-8" data-reveal>
          {pillars.map((p) => (
            <div>
              <p
                class="text-xl font-light tracking-[0.25em] uppercase text-charcoal sm:text-2xl"
                style="font-family: 'Raleway', sans-serif; font-weight: 300;"
              >
                {p.label}
              </p>
              <p class="mt-2 text-sm leading-[1.7] text-taupe">
                {p.text}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: photo -->
      <div class="relative" data-reveal="right">
        <div class="relative aspect-[4/5] w-full overflow-hidden">
          <Image
            src={pano2}
            alt="Sinclair Yachting"
            class="absolute inset-0 h-full w-full object-cover"
            widths={[600, 900, 1200]}
            sizes="(min-width: 1024px) 520px, 100vw"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </Container>
</section>
